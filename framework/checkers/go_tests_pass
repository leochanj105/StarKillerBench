#!/usr/bin/env python3
"""
go_tests_pass <dir>

Pass iff `go generate ./...` then `go test ./...` succeed inside <dir>.

`go generate` is run first so proto/codegen stubs are fresh before tests
compile. `go test ./...` also compiles every package, so a successful run
implies a successful build (i.e., no separate `go_builds` is needed).
"""
import subprocess, sys

if len(sys.argv) != 2:
    sys.exit("go_tests_pass: usage: go_tests_pass <dir>")

cwd = sys.argv[1]
r = subprocess.run(["go", "generate", "./..."], cwd=cwd)
if r.returncode != 0:
    sys.exit(r.returncode)
sys.exit(subprocess.run(["go", "test", "./..."], cwd=cwd).returncode)
