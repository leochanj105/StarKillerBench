#!/usr/bin/env bash
# run_integration: bring up the compose stack (4 services + Postgres), wait
# for every /healthz, run the store-backed unit tests and the cross-service
# integration tests against the live stack, then tear it down.

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
cd "$REPO_ROOT"

COMPOSE=(docker compose -f tests/integration/docker-compose.yml)

cleanup() { "${COMPOSE[@]}" down -v --remove-orphans >/dev/null 2>&1 || true; }
trap cleanup EXIT

echo "==> building and starting compose stack"
"${COMPOSE[@]}" up -d --build

echo "==> waiting for /healthz on all services"
for port in 18801 18802 18803 18804 18805 18806 18807 18808 18809 18810 18811 18812; do
    ok=0
    for _ in $(seq 1 30); do
        if curl -fsS "http://localhost:$port/healthz" >/dev/null 2>&1; then
            ok=1
            break
        fi
        sleep 1
    done
    if [ "$ok" != 1 ]; then
        echo "service on host port $port did not become ready" >&2
        "${COMPOSE[@]}" logs >&2 || true
        exit 1
    fi
    echo "    port $port ready"
done

# Store-backed unit tests that need a live database. Each service owns its
# own Postgres (host-published on a distinct port); we point PG_DSN at the
# right one per service. Without PG_DSN these tests skip themselves, so
# running them here is the only place they actually execute. Add a
# service's store-backed package below when it gains one.

echo "==> store-backed unit tests (inventory v2, against compose Postgres)"
( cd services/inventory && \
  PG_DSN="postgres://inv:inv@localhost:15432/inventory?sslmode=disable" \
  go test -v -run TestV2 ./internal/server/ )

echo "==> store-backed unit tests (booking v2, against compose Postgres)"
( cd services/booking && \
  PG_DSN="postgres://bk:bk@localhost:15433/booking?sslmode=disable" \
  go test -v -run TestV2 ./internal/server/ )

echo "==> cross-service integration tests"
( cd tests/integration && go test -v ./... )
