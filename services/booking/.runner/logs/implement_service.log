{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01WBhJQTVkVPi4hzuvw3Ss6G","type":"tool_result","content":"1\t// Unit tests for booking v2: Postgres-backed durability and race-safe\n2\t// idempotency.\n3\t//\n4\t// Audit surface for v2's added contract. These tests need a running\n5\t// Postgres reachable via PG_DSN; without it they skip cleanly so that\n6\t// `go test ./...` in dev (and in the agent's sandbox, which has no\n7\t// docker) still passes. The integration compose stack provides a\n8\t// dedicated booking Postgres; `framework/scripts/run_integration` exports\n9\t// PG_DSN before exercising these tests.\n10\t//\n11\t// The upstream payment/inventory services are mocked here (this is a unit\n12\t// test of booking's persistence, not the cross-service saga — that's\n13\t// covered by tests/integration). The mocks below are defined locally and\n14\t// are concurrency-safe, unlike the slice-recording mocks in\n15\t// server_test.go, because TestV2_ConcurrentSameKey runs the saga from\n16\t// many goroutines at once.\n17\t//\n18\t// Kept separate from server_test.go (v1, in-memory) so each version's\n19\t// contract is reviewed in isolation. The agent must not modify either\n20\t// file.\n21\t\n22\tpackage server_test\n23\t\n24\timport (\n25\t\t\"context\"\n26\t\t\"os\"\n27\t\t\"sync\"\n28\t\t\"sync/atomic\"\n29\t\t\"testing\"\n30\t\t\"time\"\n31\t\n32\t\tbookingpb \"agentbench/services/booking/api/v1\"\n33\t\t\"agentbench/services/booking/internal/server\"\n34\t\t\"agentbench/services/booking/internal/store\"\n35\t\tinventorypb \"agentbench/services/inventory/api/v1\"\n36\t\tpaymentpb \"agentbench/services/payment/api/v1\"\n37\t\n38\t\t\"google.golang.org/grpc\"\n39\t)\n40\t\n41\t// runNonce makes idempotency keys unique per test-process run. The Postgres\n42\t// tables persist across runs (the integration stack truncates by dropping\n43\t// the container, but a developer re-running `go test` against a long-lived\n44\t// DB would otherwise reuse keys). A fresh nonce per run guarantees each run\n45\t// exercises new keys — essential for the concurrency test, whose Hold-count\n46\t// assertion only holds for a key the saga has never seen.\n47\tvar runNonce = itoa(time.Now().UnixNano())\n48\t\n49\t// ─── Concurrency-safe upstream mocks (v2-local) ──────────────────────────────\n50\t//\n51\t// safeInventory counts Hold calls atomically and hands out unique hold\n52\t// ids; the counter lets the idempotency test assert the saga ran at most\n53\t// once. safePayment always succeeds with unique auth ids. Both satisfy\n54\t// the full gRPC client interfaces.\n55\t\n56\ttype safeInventory struct {\n57\t\tholds atomic.Int64\n58\t}\n59\t\n60\tfunc (m *safeInventory) SetStock(ctx context.Context, in *inventorypb.SetStockRequest, opts ...grpc.CallOption) (*inventorypb.SetStockResponse, error) {\n61\t\treturn &inventorypb.SetStockResponse{}, nil\n62\t}\n63\tfunc (m *safeInventory) Hold(ctx context.Context, in *inventorypb.HoldRequest, opts ...grpc.CallOption) (*inventorypb.HoldResponse, error) {\n64\t\tn := m.holds.Add(1)\n65\t\treturn &inventorypb.HoldResponse{HoldId: \"hold-\" + itoa(n)}, nil\n66\t}\n67\tfunc (m *safeInventory) Commit(ctx context.Context, in *inventorypb.CommitRequest, opts ...grpc.CallOption) (*inventorypb.CommitResponse, error) {\n68\t\treturn &inventorypb.CommitResponse{}, nil\n69\t}\n70\tfunc (m *safeInventory) Release(ctx context.Context, in *inventorypb.ReleaseRequest, opts ...grpc.CallOption) (*inventorypb.ReleaseResponse, error) {\n71\t\treturn &inventorypb.ReleaseResponse{}, nil\n72\t}\n73\t\n74\ttype safePayment struct {\n75\t\tauths atomic.Int64\n76\t}\n77\t\n78\tfunc (m *safePayment) Authorize(ctx context.Context, in *paymentpb.AuthorizeRequest, opts ...grpc.CallOption) (*paymentpb.AuthorizeResponse, error) {\n79\t\tn := m.auths.Add(1)\n80\t\treturn &paymentpb.AuthorizeResponse{AuthId: \"auth-\" + itoa(n)}, nil\n81\t}\n82\tfunc (m *safePayment) Capture(ctx context.Context, in *paymentpb.CaptureRequest, opts ...grpc.CallOption) (*paymentpb.CaptureResponse, error) {\n83\t\treturn &paymentpb.CaptureResponse{}, nil\n84\t}\n85\tfunc (m *safePayment) Void(ctx context.Context, in *paymentpb.VoidRequest, opts ...grpc.CallOption) (*paymentpb.VoidResponse, error) {\n86\t\treturn &paymentpb.VoidResponse{}, nil\n87\t}\n88\tfunc (m *safePayment) Refund(ctx context.Context, in *paymentpb.RefundRequest, opts ...grpc.CallOption) (*paymentpb.RefundResponse, error) {\n89\t\treturn &paymentpb.RefundResponse{}, nil\n90\t}\n91\t\n92\tfunc itoa(n int64) string {\n93\t\tif n == 0 {\n94\t\t\treturn \"0\"\n95\t\t}\n96\t\tvar buf [20]byte\n97\t\ti := len(buf)\n98\t\tfor n > 0 {\n99\t\t\ti--\n100\t\t\tbuf[i] = byte('0' + n%10)\n101\t\t\tn /= 10\n102\t\t}\n103\t\treturn string(buf[i:])\n104\t}\n105\t\n106\t// pgBookingServers returns two booking Servers backed by the same\n107\t// Postgres database (each with its own fresh mock upstreams), plus a\n108\t// teardown. The two-server setup lets the durability test prove that a\n109\t// booking persisted through s1 is readable through s2 — i.e. the record\n110\t// lives in Postgres, not process memory. Skips if PG_DSN is unset.\n111\tfunc pgBookingServers(t *testing.T) (s1, s2 *server.Server, done func()) {\n112\t\tt.Helper()\n113\t\tdsn := os.Getenv(\"PG_DSN\")\n114\t\tif dsn == \"\" {\n115\t\t\tt.Skip(\"PG_DSN not set; skipping Postgres-backed v2 test\")\n116\t\t}\n117\t\tst1, err := store.NewPGStore(context.Background(), dsn)\n118\t\tif err != nil {\n119\t\t\tt.Fatalf(\"connect pgStore #1: %v\", err)\n120\t\t}\n121\t\tst2, err := store.NewPGStore(context.Background(), dsn)\n122\t\tif err != nil {\n123\t\t\tst1.Close()\n124\t\t\tt.Fatalf(\"connect pgStore #2: %v\", err)\n125\t\t}\n126\t\ts1 = server.NewServerWithStore(&safePayment{}, &safeInventory{}, st1)\n127\t\ts2 = server.NewServerWithStore(&safePayment{}, &safeInventory{}, st2)\n128\t\treturn s1, s2, func() { st1.Close(); st2.Close() }\n129\t}\n130\t\n131\tfunc createOK(t *testing.T, s *server.Server, user, key string) string {\n132\t\tt.Helper()\n133\t\tr, err := s.CreateBooking(context.Background(), &bookingpb.CreateBookingRequest{\n134\t\t\tUserId: user, HotelId: \"H_v2\", RoomType: \"STD\", Date: \"2026-07-01\",\n135\t\t\tAmount: 5000, Currency: \"USD\", PaymentToken: \"tok\", IdempotencyKey: key,\n136\t\t})\n137\t\tif err != nil {\n138\t\t\tt.Fatalf(\"CreateBooking(%s,%s): %v\", user, key, err)\n139\t\t}\n140\t\treturn r.GetBookingId()\n141\t}\n142\t\n143\t// ════════════════════════════════════════════════════════════════════════════\n144\t// Durability across \"service restart\"\n145\t//\n146\t// A booking created through s1 must be readable through s2 (a separate\n147\t// Server on the same DB). Models a restart: s1's process effectively goes\n148\t// away, s2 is a fresh process. If the record were kept in process memory,\n149\t// GetBooking on s2 would return NotFound.\n150\t// ════════════════════════════════════════════════════════════════════════════\n151\tfunc TestV2_DurableAcrossRestart(t *testing.T) {\n152\t\ts1, s2, done := pgBookingServers(t)\n153\t\tdefer done()\n154\t\tctx := context.Background()\n155\t\n156\t\tid := createOK(t, s1, \"u_durable\", \"k_durable_\"+runNonce)\n157\t\n158\t\tgot, err := s2.GetBooking(ctx, &bookingpb.GetBookingRequest{BookingId: id})\n159\t\tif err != nil {\n160\t\t\tt.Fatalf(\"GetBooking on second server: %v\", err)\n161\t\t}\n162\t\tif got.GetUserId() != \"u_durable\" || got.GetStatus() != \"confirmed\" || got.GetAmount() != 5000 {\n163\t\t\tt.Errorf(\"restored booking mismatched: %+v\", got)\n164\t\t}\n165\t}\n166\t\n167\t// ════════════════════════════════════════════════════════════════════════════\n168\t// Durable idempotency across \"restart\"\n169\t//\n170\t// Replaying the same idempotency_key through a different Server must\n171\t// return the original booking_id without running the saga again. Pins\n172\t// that the idempotency index lives in Postgres, not memory.\n173\t// ════════════════════════════════════════════════════════════════════════════\n174\tfunc TestV2_IdempotentAcrossRestart(t *testing.T) {\n175\t\ts1, s2, done := pgBookingServers(t)\n176\t\tdefer done()\n177\t\tctx := context.Background()\n178\t\n179\t\tkey := \"k_idem_\" + runNonce\n180\t\tfirst := createOK(t, s1, \"u_idem\", key)\n181\t\n182\t\tr, err := s2.CreateBooking(ctx, &bookingpb.CreateBookingRequest{\n183\t\t\tUserId: \"u_idem\", HotelId: \"H_v2\", RoomType: \"STD\", Date: \"2026-07-01\",\n184\t\t\tAmount: 5000, Currency: \"USD\", PaymentToken: \"tok\", IdempotencyKey: key,\n185\t\t})\n186\t\tif err != nil {\n187\t\t\tt.Fatalf(\"replayed CreateBooking on second server: %v\", err)\n188\t\t}\n189\t\tif r.GetBookingId() != first {\n190\t\t\tt.Errorf(\"idempotent replay returned %q, want original %q\", r.GetBookingId(), first)\n191\t\t}\n192\t}\n193\t\n194\t// ════════════════════════════════════════════════════════════════════════════\n195\t// Concurrent CreateBooking with the same idempotency_key\n196\t//\n197\t// N goroutines fire CreateBooking with one shared key. The saga must run\n198\t// at most once (verified via the atomic Hold counter on the shared mock\n199\t// inventory) and every caller must receive the SAME booking_id. Without a\n200\t// transactional unique-constraint on idempotency_key, two callers would\n201\t// both run the saga (double Hold / double charge) and persist divergent\n202\t// bookings.\n203\t// ════════════════════════════════════════════════════════════════════════════\n204\tfunc TestV2_ConcurrentSameKey_SagaRunsOnce(t *testing.T) {\n205\t\tdsn := os.Getenv(\"PG_DSN\")\n206\t\tif dsn == \"\" {\n207\t\t\tt.Skip(\"PG_DSN not set; skipping Postgres-backed v2 test\")\n208\t\t}\n209\t\tst, err := store.NewPGStore(context.Background(), dsn)\n210\t\tif err != nil {\n211\t\t\tt.Fatalf(\"connect pgStore: %v\", err)\n212\t\t}\n213\t\tdefer st.Close()\n214\t\n215\t\tinv := &safeInventory{}\n216\t\tpay := &safePayment{}\n217\t\ts := server.NewServerWithStore(pay, inv, st)\n218\t\n219\t\tconst racers = 10\n220\t\tkey := \"k_race_\" + runNonce\n221\t\treq := &bookingpb.CreateBookingRequest{\n222\t\t\tUserId: \"u_race\", HotelId: \"H_v2\", RoomType: \"STD\", Date: \"2026-07-01\",\n223\t\t\tAmount: 5000, Currency: \"USD\", PaymentToken: \"tok\", IdempotencyKey: key,\n224\t\t}\n225\t\n226\t\tvar wg sync.WaitGroup\n227\t\tids := make([]string, racers)\n228\t\terrs := make([]error, racers)\n229\t\twg.Add(racers)\n230\t\tfor i := 0; i < racers; i++ {\n231\t\t\tgo func(i int) {\n232\t\t\t\tdefer wg.Done()\n233\t\t\t\tr, err := s.CreateBooking(context.Background(), req)\n234\t\t\t\tif err != nil {\n235\t\t\t\t\terrs[i] = err\n236\t\t\t\t\treturn\n237\t\t\t\t}\n238\t\t\t\tids[i] = r.GetBookingId()\n239\t\t\t}(i)\n240\t\t}\n241\t\twg.Wait()\n242\t\n243\t\t// Every call must have succeeded (a loser on the idempotency race\n244\t\t// returns the winner's id, it does not error).\n245\t\tfor i, err := range errs {\n246\t\t\tif err != nil {\n247\t\t\t\tt.Errorf(\"racer %d errored: %v\", i, err)\n248\t\t\t}\n249\t\t}\n250\t\t// All booking_ids must be identical and non-empty.\n251\t\tfor i := 1; i < racers; i++ {\n252\t\t\tif ids[i] != ids[0] {\n253\t\t\t\tt.Errorf(\"racer %d got booking_id %q, want %q (divergent bookings)\", i, ids[i], ids[0])\n254\t\t\t}\n255\t\t}\n256\t\tif ids[0] == \"\" {\n257\t\t\tt.Fatalf(\"no booking_id produced\")\n258\t\t}\n259\t\t// The saga must have run at most once: exactly one inventory Hold.\n260\t\tif got := inv.holds.Load(); got != 1 {\n261\t\t\tt.Errorf(\"inventory.Hold called %d times, want exactly 1 (saga ran more than once)\", got)\n262\t\t}\n263\t}\n264\t\n265\t// Compile-time guard: the v2-local mocks satisfy the gRPC client\n266\t// interfaces the booking server depends on. Mirrors how the constructor\n267\t// is wired in production.\n268\tvar (\n269\t\t_ inventorypb.InventoryServiceClient = (*safeInventory)(nil)\n270\t\t_ paymentpb.PaymentServiceClient     = (*safePayment)(nil)\n271\t)\n272\t"}]},"parent_tool_use_id":null,"session_id":"eb4b0455-1f96-434e-8f15-836a852bf7bf","uuid":"d0bad53f-6570-4a27-9e8f-f4c646c611ef","timestamp":"2026-06-07T01:04:41.099Z","tool_use_result":{"type":"text","file":{"filePath":"/home/leochanj/Desktop/agentbench/services/booking/internal/server/server_v2_test.go","content":"// Unit tests for booking v2: Postgres-backed durability and race-safe\n// idempotency.\n//\n// Audit surface for v2's added contract. These tests need a running\n// Postgres reachable via PG_DSN; without it they skip cleanly so that\n// `go test ./...` in dev (and in the agent's sandbox, which has no\n// docker) still passes. The integration compose stack provides a\n// dedicated booking Postgres; `framework/scripts/run_integration` exports\n// PG_DSN before exercising these tests.\n//\n// The upstream payment/inventory services are mocked here (this is a unit\n// test of booking's persistence, not the cross-service saga — that's\n// covered by tests/integration). The mocks below are defined locally and\n// are concurrency-safe, unlike the slice-recording mocks in\n// server_test.go, because TestV2_ConcurrentSameKey runs the saga from\n// many goroutines at once.\n//\n// Kept separate from server_test.go (v1, in-memory) so each version's\n// contract is reviewed in isolation. The agent must not modify either\n// file.\n\npackage server_test\n\nimport (\n\t\"context\"\n\t\"os\"\n\t\"sync\"\n\t\"sync/atomic\"\n\t\"testing\"\n\t\"time\"\n\n\tbookingpb \"agentbench/services/booking/api/v1\"\n\t\"agentbench/services/booking/internal/server\"\n\t\"agentbench/services/booking/internal/store\"\n\tinventorypb \"agentbench/services/inventory/api/v1\"\n\tpaymentpb \"agentbench/services/payment/api/v1\"\n\n\t\"google.golang.org/grpc\"\n)\n\n// runNonce makes idempotency keys unique per test-process run. The Postgres\n// tables persist across runs (the integration stack truncates by dropping\n// the container, but a developer re-running `go test` against a long-lived\n// DB would otherwise reuse keys). A fresh nonce per run guarantees each run\n// exercises new keys — essential for the concurrency test, whose Hold-count\n// assertion only holds for a key the saga has never seen.\nvar runNonce = itoa(time.Now().UnixNano())\n\n// ─── Concurrency-safe upstream mocks (v2-local) ──────────────────────────────\n//\n// safeInventory counts Hold calls atomically and hands out unique hold\n// ids; the counter lets the idempotency test assert the saga ran at most\n// once. safePayment always succeeds with unique auth ids. Both satisfy\n// the full gRPC client interfaces.\n\ntype safeInventory struct {\n\tholds atomic.Int64\n}\n\nfunc (m *safeInventory) SetStock(ctx context.Context, in *inventorypb.SetStockRequest, opts ...grpc.CallOption) (*inventorypb.SetStockResponse, error) {\n\treturn &inventorypb.SetStockResponse{}, nil\n}\nfunc (m *safeInventory) Hold(ctx context.Context, in *inventorypb.HoldRequest, opts ...grpc.CallOption) (*inventorypb.HoldResponse, error) {\n\tn := m.holds.Add(1)\n\treturn &inventorypb.HoldResponse{HoldId: \"hold-\" + itoa(n)}, nil\n}\nfunc (m *safeInventory) Commit(ctx context.Context, in *inventorypb.CommitRequest, opts ...grpc.CallOption) (*inventorypb.CommitResponse, error) {\n\treturn &inventorypb.CommitResponse{}, nil\n}\nfunc (m *safeInventory) Release(ctx context.Context, in *inventorypb.ReleaseRequest, opts ...grpc.CallOption) (*inventorypb.ReleaseResponse, error) {\n\treturn &inventorypb.ReleaseResponse{}, nil\n}\n\ntype safePayment struct {\n\tauths atomic.Int64\n}\n\nfunc (m *safePayment) Authorize(ctx context.Context, in *paymentpb.AuthorizeRequest, opts ...grpc.CallOption) (*paymentpb.AuthorizeResponse, error) {\n\tn := m.auths.Add(1)\n\treturn &paymentpb.AuthorizeResponse{AuthId: \"auth-\" + itoa(n)}, nil\n}\nfunc (m *safePayment) Capture(ctx context.Context, in *paymentpb.CaptureRequest, opts ...grpc.CallOption) (*paymentpb.CaptureResponse, error) {\n\treturn &paymentpb.CaptureResponse{}, nil\n}\nfunc (m *safePayment) Void(ctx context.Context, in *paymentpb.VoidRequest, opts ...grpc.CallOption) (*paymentpb.VoidResponse, error) {\n\treturn &paymentpb.VoidResponse{}, nil\n}\nfunc (m *safePayment) Refund(ctx context.Context, in *paymentpb.RefundRequest, opts ...grpc.CallOption) (*paymentpb.RefundResponse, error) {\n\treturn &paymentpb.RefundResponse{}, nil\n}\n\nfunc itoa(n int64) string {\n\tif n == 0 {\n\t\treturn \"0\"\n\t}\n\tvar buf [20]byte\n\ti := len(buf)\n\tfor n > 0 {\n\t\ti--\n\t\tbuf[i] = byte('0' + n%10)\n\t\tn /= 10\n\t}\n\treturn string(buf[i:])\n}\n\n// pgBookingServers returns two booking Servers backed by the same\n// Postgres database (each with its own fresh mock upstreams), plus a\n// teardown. The two-server setup lets the durability test prove that a\n// booking persisted through s1 is readable through s2 — i.e. the record\n// lives in Postgres, not process memory. Skips if PG_DSN is unset.\nfunc pgBookingServers(t *testing.T) (s1, s2 *server.Server, done func()) {\n\tt.Helper()\n\tdsn := os.Getenv(\"PG_DSN\")\n\tif dsn == \"\" {\n\t\tt.Skip(\"PG_DSN not set; skipping Postgres-backed v2 test\")\n\t}\n\tst1, err := store.NewPGStore(context.Background(), dsn)\n\tif err != nil {\n\t\tt.Fatalf(\"connect pgStore #1: %v\", err)\n\t}\n\tst2, err := store.NewPGStore(context.Background(), dsn)\n\tif err != nil {\n\t\tst1.Close()\n\t\tt.Fatalf(\"connect pgStore #2: %v\", err)\n\t}\n\ts1 = server.NewServerWithStore(&safePayment{}, &safeInventory{}, st1)\n\ts2 = server.NewServerWithStore(&safePayment{}, &safeInventory{}, st2)\n\treturn s1, s2, func() { st1.Close(); st2.Close() }\n}\n\nfunc createOK(t *testing.T, s *server.Server, user, key string) string {\n\tt.Helper()\n\tr, err := s.CreateBooking(context.Background(), &bookingpb.CreateBookingRequest{\n\t\tUserId: user, HotelId: \"H_v2\", RoomType: \"STD\", Date: \"2026-07-01\",\n\t\tAmount: 5000, Currency: \"USD\", PaymentToken: \"tok\", IdempotencyKey: key,\n\t})\n\tif err != nil {\n\t\tt.Fatalf(\"CreateBooking(%s,%s): %v\", user, key, err)\n\t}\n\treturn r.GetBookingId()\n}\n\n// ════════════════════════════════════════════════════════════════════════════\n// Durability across \"service restart\"\n//\n// A booking created through s1 must be readable through s2 (a separate\n// Server on the same DB). Models a restart: s1's process effectively goes\n// away, s2 is a fresh process. If the record were kept in process memory,\n// GetBooking on s2 would return NotFound.\n// ════════════════════════════════════════════════════════════════════════════\nfunc TestV2_DurableAcrossRestart(t *testing.T) {\n\ts1, s2, done := pgBookingServers(t)\n\tdefer done()\n\tctx := context.Background()\n\n\tid := createOK(t, s1, \"u_durable\", \"k_durable_\"+runNonce)\n\n\tgot, err := s2.GetBooking(ctx, &bookingpb.GetBookingRequest{BookingId: id})\n\tif err != nil {\n\t\tt.Fatalf(\"GetBooking on second server: %v\", err)\n\t}\n\tif got.GetUserId() != \"u_durable\" || got.GetStatus() != \"confirmed\" || got.GetAmount() != 5000 {\n\t\tt.Errorf(\"restored booking mismatched: %+v\", got)\n\t}\n}\n\n// ════════════════════════════════════════════════════════════════════════════\n// Durable idempotency across \"restart\"\n//\n// Replaying the same idempotency_key through a different Server must\n// return the original booking_id without running the saga again. Pins\n// that the idempotency index lives in Postgres, not memory.\n// ════════════════════════════════════════════════════════════════════════════\nfunc TestV2_IdempotentAcrossRestart(t *testing.T) {\n\ts1, s2, done := pgBookingServers(t)\n\tdefer done()\n\tctx := context.Background()\n\n\tkey := \"k_idem_\" + runNonce\n\tfirst := createOK(t, s1, \"u_idem\", key)\n\n\tr, err := s2.CreateBooking(ctx, &bookingpb.CreateBookingRequest{\n\t\tUserId: \"u_idem\", HotelId: \"H_v2\", RoomType: \"STD\", Date: \"2026-07-01\",\n\t\tAmount: 5000, Currency: \"USD\", PaymentToken: \"tok\", IdempotencyKey: key,\n\t})\n\tif err != nil {\n\t\tt.Fatalf(\"replayed CreateBooking on second server: %v\", err)\n\t}\n\tif r.GetBookingId() != first {\n\t\tt.Errorf(\"idempotent replay returned %q, want original %q\", r.GetBookingId(), first)\n\t}\n}\n\n// ════════════════════════════════════════════════════════════════════════════\n// Concurrent CreateBooking with the same idempotency_key\n//\n// N goroutines fire CreateBooking with one shared key. The saga must run\n// at most once (verified via the atomic Hold counter on the shared mock\n// inventory) and every caller must receive the SAME booking_id. Without a\n// transactional unique-constraint on idempotency_key, two callers would\n// both run the saga (double Hold / double charge) and persist divergent\n// bookings.\n// ════════════════════════════════════════════════════════════════════════════\nfunc TestV2_ConcurrentSameKey_SagaRunsOnce(t *testing.T) {\n\tdsn := os.Getenv(\"PG_DSN\")\n\tif dsn == \"\" {\n\t\tt.Skip(\"PG_DSN not set; skipping Postgres-backed v2 test\")\n\t}\n\tst, err := store.NewPGStore(context.Background(), dsn)\n\tif err != nil {\n\t\tt.Fatalf(\"connect pgStore: %v\", err)\n\t}\n\tdefer st.Close()\n\n\tinv := &safeInventory{}\n\tpay := &safePayment{}\n\ts := server.NewServerWithStore(pay, inv, st)\n\n\tconst racers = 10\n\tkey := \"k_race_\" + runNonce\n\treq := &bookingpb.CreateBookingRequest{\n\t\tUserId: \"u_race\", HotelId: \"H_v2\", RoomType: \"STD\", Date: \"2026-07-01\",\n\t\tAmount: 5000, Currency: \"USD\", PaymentToken: \"tok\", IdempotencyKey: key,\n\t}\n\n\tvar wg sync.WaitGroup\n\tids := make([]string, racers)\n\terrs := make([]error, racers)\n\twg.Add(racers)\n\tfor i := 0; i < racers; i++ {\n\t\tgo func(i int) {\n\t\t\tdefer wg.Done()\n\t\t\tr, err := s.CreateBooking(context.Background(), req)\n\t\t\tif err != nil {\n\t\t\t\terrs[i] = err\n\t\t\t\treturn\n\t\t\t}\n\t\t\tids[i] = r.GetBookingId()\n\t\t}(i)\n\t}\n\twg.Wait()\n\n\t// Every call must have succeeded (a loser on the idempotency race\n\t// returns the winner's id, it does not error).\n\tfor i, err := range errs {\n\t\tif err != nil {\n\t\t\tt.Errorf(\"racer %d errored: %v\", i, err)\n\t\t}\n\t}\n\t// All booking_ids must be identical and non-empty.\n\tfor i := 1; i < racers; i++ {\n\t\tif ids[i] != ids[0] {\n\t\t\tt.Errorf(\"racer %d got booking_id %q, want %q (divergent bookings)\", i, ids[i], ids[0])\n\t\t}\n\t}\n\tif ids[0] == \"\" {\n\t\tt.Fatalf(\"no booking_id produced\")\n\t}\n\t// The saga must have run at most once: exactly one inventory Hold.\n\tif got := inv.holds.Load(); got != 1 {\n\t\tt.Errorf(\"inventory.Hold called %d times, want exactly 1 (saga ran more than once)\", got)\n\t}\n}\n\n// Compile-time guard: the v2-local mocks satisfy the gRPC client\n// interfaces the booking server depends on. Mirrors how the constructor\n// is wired in production.\nvar (\n\t_ inventorypb.InventoryServiceClient = (*safeInventory)(nil)\n\t_ paymentpb.PaymentServiceClient     = (*safePayment)(nil)\n)\n","numLines":272,"startLine":1,"totalLines":272}}}
