 \"missing required field or non-positive amount\")\n64\t\t}\n65\t\n66\t\ts.mu.Lock()\n67\t\tif id, ok := s.idempotency[req.GetIdempotencyKey()]; ok {\n68\t\t\ts.mu.Unlock()\n69\t\t\treturn &bookingpb.CreateBookingResponse{BookingId: id}, nil\n70\t\t}\n71\t\ts.mu.Unlock()\n72\t\n73\t\tholdResp, err := s.inventory.Hold(ctx, &inventorypb.HoldRequest{\n74\t\t\tHotelId:  req.GetHotelId(),\n75\t\t\tRoomType: req.GetRoomType(),\n76\t\t\tDate:     req.GetDate(),\n77\t\t\tQuantity: 1,\n78\t\t})\n79\t\tif err != nil {\n80\t\t\treturn nil, status.Errorf(codes.FailedPrecondition, \"inventory hold failed: %v\", err)\n81\t\t}\n82\t\tholdID := holdResp.GetHoldId()\n83\t\n84\t\tauthResp, err := s.payment.Authorize(ctx, &paymentpb.AuthorizeRequest{\n85\t\t\tAmount:       req.GetAmount(),\n86\t\t\tCurrency:     req.GetCurrency(),\n87\t\t\tPaymentToken: req.GetPaymentToken(),\n88\t\t})\n89\t\tif err != nil {\n90\t\t\t_, _ = s.inventory.Release(ctx, &inventorypb.ReleaseRequest{HoldId: holdID})\n91\t\t\treturn nil, status.Errorf(codes.FailedPrecondition, \"payment authorize failed: %v\", err)\n92\t\t}\n93\t\tauthID := authResp.GetAuthId()\n94\t\n95\t\tif _, err := s.payment.Capture(ctx, &paymentpb.CaptureRequest{AuthId: authID}); err != nil {\n96\t\t\t_, _ = s.payment.Void(ctx, &paymentpb.VoidRequest{AuthId: authID})\n97\t\t\t_, _ = s.inventory.Release(ctx, &inventorypb.ReleaseRequest{HoldId: holdID})\n98\t\t\treturn nil, status.Errorf(codes.FailedPrecondition, \"payment capture failed: %v\", err)\n99\t\t}\n100\t\n101\t\tif _, err := s.inventory.Commit(ctx, &inventorypb.CommitRequest{HoldId: holdID}); err != nil {\n102\t\t\t_, _ = s.payment.Refund(ctx, &paymentpb.RefundRequest{AuthId: authID, Amount: req.GetAmount()})\n103\t\t\treturn nil, status.Errorf(codes.FailedPrecondition, \"inventory commit failed: %v\", err)\n104\t\t}\n105\t\n106\t\tbookingID := newID()\n107\t\ts.mu.Lock()\n108\t\ts.bookings[bookingID] = &booking{\n109\t\t\tuserID:   req.GetUserId(),\n110\t\t\thotelID:  req.Get