{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0118W8uudcm5tj1GufQhMrHn","type":"tool_result","content":"1\t// Unit tests for booking v2: Postgres-backed durability and race-safe\n2\t// idempotency.\n3\t//\n4\t// Audit surface for v2's added contract. These tests need a running\n5\t// Postgres reachable via PG_DSN; without it they skip cleanly so that\n6\t// `go test ./...` in dev (and in the agent's sandbox, which has no\n7\t// docker) still passes. The integration compose stack provides a\n8\t// dedicated booking Postgres; `framework/scripts/run_integration` exports\n9\t// PG_DSN before exercising these tests.\n10\t//\n11\t// The upstream payment/inventory services are mocked here (this is a unit\n12\t// test of booking's persistence, not the cross-service saga — that's\n13\t// covered by tests/integration). The mocks below are defined locally and\n14\t// are concurrency-safe, unlike the slice-recording mocks in\n15\t// server_test.go, because TestV2_ConcurrentSameKey runs the saga from\n16\t// many goroutines at once.\n17\t//\n18\t// Kept separate from server_test.go (v1, in-memory) so each version's\n19\t// contract is reviewed in isolation. The agent must not modify either\n20\t// file.\n21\t\n22\tpackage server_test\n23\t\n24\timport (\n25\t\t\"context\"\n26\t\t\"os\"\n27\t\t\"sync\"\n28\t\t\"sync/atomic\"\n29\t\t\"testing\"\n30\t\n31\t\tbookingpb \"agentbench/services/booking/api/v1\"\n32\t\t\"agentbench/services/booking/internal/server\"\n33\t\t\"agentbench/services/booking/internal/store\"\n34\t\tinventorypb \"agentbench/services/inventory/api/v1\"\n35\t\tpaymentpb \"agentbench/services/payment/api/v1\"\n36\t\n37\t\t\"google.golang.org/grpc\"\n38\t)\n39\t\n40\t// ─── Concurrency-safe upstream mocks (v2-local) ──────────────────────────────\n41\t//\n42\t// safeInventory counts Hold calls atomically and hands out unique hold\n43\t// ids; the counter lets the idempotency test assert the saga ran at most\n44\t// once. safePayment always succeeds with unique auth ids. Both satisfy\n45\t// the full gRPC client interfaces.\n46\t\n47\ttype safeInventory struct {\n48\t\tholds atomic.Int64\n49\t}\n50\t\n51\tfunc (m *safeInventory) SetStock(ctx context.Context, in *inventorypb.SetStockRequest, opts ...grpc.CallOption) (*inventorypb.SetStockResponse, error) {\n52\t\treturn &inventorypb.SetStockResponse{}, nil\n53\t}\n54\tfunc (m *safeInventory) Hold(ctx context.Context, in *inventorypb.HoldRequest, opts ...grpc.CallOption) (*inventorypb.HoldResponse, error) {\n55\t\tn := m.holds.Add(1)\n56\t\treturn &inventorypb.HoldResponse{HoldId: \"hold-\" + itoa(n)}, nil\n57\t}\n58\tfunc (m *safeInventory) Commit(ctx context.Context, in *inventorypb.CommitRequest, opts ...grpc.CallOption) (*inventorypb.CommitResponse, error) {\n59\t\treturn &inventorypb.CommitResponse{}, nil\n60\t}\n61\tfunc (m *safeInventory) Release(ctx context.Context, in *inventorypb.ReleaseRequest, opts ...grpc.CallOption) (*inventorypb.ReleaseResponse, error) {\n62\t\treturn &inventorypb.ReleaseResponse{}, nil\n63\t}\n64\t\n65\ttype safePayment struct {\n66\t\tauths atomic.Int64\n67\t}\n68\t\n69\tfunc (m *safePayment) Authorize(ctx context.Context, in *paymentpb.AuthorizeRequest, opts ...grpc.CallOption) (*paymentpb.AuthorizeResponse, error) {\n70\t\tn := m.auths.Add(1)\n71\t\treturn &paymentpb.AuthorizeResponse{AuthId: \"auth-\" + itoa(n)}, nil\n72\t}\n73\tfunc (m *safePayment) Capture(ctx context.Context, in *paymentpb.CaptureRequest, opts ...grpc.CallOption) (*paymentpb.CaptureResponse, error) {\n74\t\treturn &paymentpb.CaptureResponse{}, nil\n75\t}\n76\tfunc (m *safePayment) Void(ctx context.Context, in *paymentpb.VoidRequest, opts ...grpc.CallOption) (*paymentpb.VoidResponse, error) {\n77\t\treturn &paymentpb.VoidResponse{}, nil\n78\t}\n79\tfunc (m *safePayment) Refund(ctx context.Context, in *paymentpb.RefundRequest, opts ...grpc.CallOption) (*paymentpb.RefundResponse, error) {\n80\t\treturn &paymentpb.RefundResponse{}, nil\n81\t}\n82\t\n83\tfunc itoa(n int64) string {\n84\t\tif n == 0 {\n85\t\t\treturn \"0\"\n86\t\t}\n87\t\tvar buf [20]byte\n88\t\ti := len(buf)\n89\t\tfor n > 0 {\n90\t\t\ti--\n91\t\t\tbuf[i] = byte('0' + n%10)\n92\t\t\tn /= 10\n93\t\t}\n94\t\treturn string(buf[i:])\n95\t}\n96\t\n97\t// pgBookingServers returns two booking Servers backed by the same\n98\t// Postgres database (each with its own fresh mock upstreams), plus a\n99\t// teardown. The two-server setup lets the durability test prove that a\n100\t// booking persisted through s1 is readable through s2 — i.e. the record\n101\t// lives in Postgres, not process memory. Skips if PG_DSN is unset.\n102\tfunc pgBookingServers(t *testing.T) (s1, s2 *server.Server, done func()) {\n103\t\tt.Helper()\n104\t\tdsn := os.Getenv(\"PG_DSN\")\n105\t\tif dsn == \"\" {\n106\t\t\tt.Skip(\"PG_DSN not set; skipping Postgres-backed v2 test\")\n107\t\t}\n108\t\tst1, err := store.NewPGStore(context.Background(), dsn)\n109\t\tif err != nil {\n110\t\t\tt.Fatalf(\"connect pgStore #1: %v\", err)\n111\t\t}\n112\t\tst2, err := store.NewPGStore(context.Background(), dsn)\n113\t\tif err != nil {\n114\t\t\tst1.Close()\n115\t\t\tt.Fatalf(\"connect pgStore #2: %v\", err)\n116\t\t}\n117\t\ts1 = server.NewServerWithStore(&safePayment{}, &safeInventory{}, st1)\n118\t\ts2 = server.NewServerWithStore(&safePayment{}, &safeInventory{}, st2)\n119\t\treturn s1, s2, func() { st1.Close(); st2.Close() }\n120\t}\n121\t\n122\tfunc createOK(t *testing.T, s *server.Server, user, key string) string {\n123\t\tt.Helper()\n124\t\tr, err := s.CreateBooking(context.Background(), &bookingpb.CreateBookingRequest{\n125\t\t\tUserId: user, HotelId: \"H_v2\", RoomType: \"STD\", Date: \"2026-07-01\",\n126\t\t\tAmount: 5000, Currency: \"USD\", PaymentToken: \"tok\", IdempotencyKey: key,\n127\t\t})\n128\t\tif err != nil {\n129\t\t\tt.Fatalf(\"CreateBooking(%s,%s): %v\", user, key, err)\n130\t\t}\n131\t\treturn r.GetBookingId()\n132\t}\n133\t\n134\t// ════════════════════════════════════════════════════════════════════════════\n135\t// Durability across \"service restart\"\n136\t//\n137\t// A booking created through s1 must be readable through s2 (a separate\n138\t// Server on the same DB). Models a restart: s1's process effectively goes\n139\t// away, s2 is a fresh process. If the record were kept in process memory,\n140\t// GetBooking on s2 would return NotFound.\n141\t// ════════════════════════════════════════════════════════════════════════════\n142\tfunc TestV2_DurableAcrossRestart(t *testing.T) {\n143\t\ts1, s2, done := pgBookingServers(t)\n144\t\tdefer done()\n145\t\tctx := context.Background()\n146\t\n147\t\tid := createOK(t, s1, \"u_durable\", \"k_durable_\"+t.Name())\n148\t\n149\t\tgot, err := s2.GetBooking(ctx, &bookingpb.GetBookingRequest{BookingId: id})\n150\t\tif err != nil {\n151\t\t\tt.Fatalf(\"GetBooking on second server: %v\", err)\n152\t\t}\n153\t\tif got.GetUserId() != \"u_durable\" || got.GetStatus() != \"confirmed\" || got.GetAmount() != 5000 {\n154\t\t\tt.Errorf(\"restored booking mismatched: %+v\", got)\n155\t\t}\n156\t}\n157\t\n158\t// ════════════════════════════════════════════════════════════════════════════\n159\t// Durable idempotency across \"restart\"\n160\t//\n161\t// Replaying the same idempotency_key through a different Server must\n162\t// return the original booking_id without running the saga again. Pins\n163\t// that the idempotency index lives in Postgres, not memory.\n164\t// ════════════════════════════════════════════════════════════════════════════\n165\tfunc TestV2_IdempotentAcrossRestart(t *testing.T) {\n166\t\ts1, s2, done := pgBookingServers(t)\n167\t\tdefer done()\n168\t\tctx := context.Background()\n169\t\n170\t\tkey := \"k_idem_\" + t.Name()\n171\t\tfirst := createOK(t, s1, \"u_idem\", key)\n172\t\n173\t\tr, err := s2.CreateBooking(ctx, &bookingpb.CreateBookingRequest{\n174\t\t\tUserId: \"u_idem\", HotelId: \"H_v2\", RoomType: \"STD\", Date: \"2026-07-01\",\n175\t\t\tAmount: 5000, Currency: \"USD\", PaymentToken: \"tok\", IdempotencyKey: key,\n176\t\t})\n177\t\tif err != nil {\n178\t\t\tt.Fatalf(\"replayed CreateBooking on second server: %v\", err)\n179\t\t}\n180\t\tif r.GetBookingId() != first {\n181\t\t\tt.Errorf(\"idempotent replay returned %q, want original %q\", r.GetBookingId(), first)\n182\t\t}\n183\t}\n184\t\n185\t// ════════════════════════════════════════════════════════════════════════════\n186\t// Concurrent CreateBooking with the same idempotency_key\n187\t//\n188\t// N goroutines fire CreateBooking with one shared key. The saga must run\n189\t// at most once (verified via the atomic Hold counter on the shared mock\n190\t// inventory) and every caller must receive the SAME booking_id. Without a\n191\t// transactional unique-constraint on idempotency_key, two callers would\n192\t// both run the saga (double Hold / double charge) and persist divergent\n193\t// bookings.\n194\t// ════════════════════════════════════════════════════════════════════════════\n195\tfunc TestV2_ConcurrentSameKey_SagaRunsOnce(t *testing.T) {\n196\t\tdsn := os.Getenv(\"PG_DSN\")\n197\t\tif dsn == \"\" {\n198\t\t\tt.Skip(\"PG_DSN not set; skipping Postgres-backed v2 test\")\n199\t\t}\n200\t\tst, err := store.NewPGStore(context.Background(), dsn)\n201\t\tif err != nil {\n202\t\t\tt.Fatalf(\"connect pgStore: %v\", err)\n203\t\t}\n204\t\tdefer st.Close()\n205\t\n206\t\tinv := &safeInventory{}\n207\t\tpay := &safePayment{}\n208\t\ts := server.NewServerWithStore(pay, inv, st)\n209\t\n210\t\tconst racers = 10\n211\t\tkey := \"k_race_\" + t.Name()\n212\t\treq := &bookingpb.CreateBookingRequest{\n213\t\t\tUserId: \"u_race\", HotelId: \"H_v2\", RoomType: \"STD\", Date: \"2026-07-01\",\n214\t\t\tAmount: 5000, Currency: \"USD\", PaymentToken: \"tok\", IdempotencyKey: key,\n215\t\t}\n216\t\n217\t\tvar wg sync.WaitGroup\n218\t\tids := make([]string, racers)\n219\t\terrs := make([]error, racers)\n220\t\twg.Add(racers)\n221\t\tfor i := 0; i < racers; i++ {\n222\t\t\tgo func(i int) {\n223\t\t\t\tdefer wg.Done()\n224\t\t\t\tr, err := s.CreateBooking(context.Background(), req)\n225\t\t\t\tif err != nil {\n226\t\t\t\t\terrs[i] = err\n227\t\t\t\t\treturn\n228\t\t\t\t}\n229\t\t\t\tids[i] = r.GetBookingId()\n230\t\t\t}(i)\n231\t\t}\n232\t\twg.Wait()\n233\t\n234\t\t// Every call must have succeeded (a loser on the idempotency race\n235\t\t// returns the winner's id, it does not error).\n236\t\tfor i, err := range errs {\n237\t\t\tif err != nil {\n238\t\t\t\tt.Errorf(\"racer %d errored: %v\", i, err)\n239\t\t\t}\n240\t\t}\n241\t\t// All booking_ids must be identical and non-empty.\n242\t\tfor i := 1; i < racers; i++ {\n243\t\t\tif ids[i] != ids[0] {\n244\t\t\t\tt.Errorf(\"racer %d got booking_id %q, want %q (divergent bookings)\", i, ids[i], ids[0])\n245\t\t\t}\n246\t\t}\n247\t\tif ids[0] == \"\" {\n248\t\t\tt.Fatalf(\"no booking_id produced\")\n249\t\t}\n250\t\t// The saga must have run at most once: exactly one inventory Hold.\n251\t\tif got := inv.holds.Load(); got != 1 {\n252\t\t\tt.Errorf(\"inventory.Hold called %d times, want exactly 1 (saga ran more than once)\", got)\n253\t\t}\n254\t}\n255\t\n256\t// Compile-time guard: the v2-local mocks satisfy the gRPC client\n257\t// interfaces the booking server depends on. Mirrors how the constructor\n258\t// is wired in production.\n259\tvar (\n260\t\t_ inventorypb.InventoryServiceClient = (*safeInventory)(nil)\n261\t\t_ paymentpb.PaymentServiceClient     = (*safePayment)(nil)\n262\t)\n263\t"}]},"parent_tool_use_id":null,"session_id":"38e1f232-b96a-498d-b41a-6da11474580a","uuid":"f5a200ab-3a0e-4c62-ac23-9cada73079f0","timestamp":"2026-06-07T00:43:03.144Z","tool_use_result":{"type":"text","file":{"filePath":"services/booking/internal/server/server_v2_test.go","content":"// Unit tests for booking v2: Postgres-backed durability and race-safe\n// idempotency.\n//\n// Audit surface for v2's added contract. These tests need a running\n// Postgres reachable via PG_DSN; without it they skip cleanly so that\n// `go test ./...` in dev (and in the agent's sandbox, which has no\n// docker) still passes. The integration compose stack provides a\n// dedicated booking Postgres; `framework/scripts/run_integration` exports\n// PG_DSN before exercising these tests.\n//\n// The upstream payment/inventory services are mocked here (this is a unit\n// test of booking's persistence, not the cross-service saga — that's\n// covered by tests/integration). The mocks below are defined locally and\n// are concurrency-safe, unlike the slice-recording mocks in\n// server_test.go, because TestV2_ConcurrentSameKey runs the saga from\n// many goroutines at once.\n//\n// Kept separate from server_test.go (v1, in-memory) so each version's\n// contract is reviewed in isolation. The agent must not modify either\n// file.\n\npackage server_test\n\nimport (\n\t\"context\"\n\t\"os\"\n\t\"sync\"\n\t\"sync/atomic\"\n\t\"testing\"\n\n\tbookingpb \"agentbench/services/booking/api/v1\"\n\t\"agentbench/services/booking/internal/server\"\n\t\"agentbench/services/booking/internal/store\"\n\tinventorypb \"agentbench/services/inventory/api/v1\"\n\tpaymentpb \"agentbench/services/payment/api/v1\"\n\n\t\"google.golang.org/grpc\"\n)\n\n// ─── Concurrency-safe upstream mocks (v2-local) ──────────────────────────────\n//\n// safeInventory counts Hold calls atomically and hands out unique hold\n// ids; the counter lets the idempotency test assert the saga ran at most\n// once. safePayment always succeeds with unique auth ids. Both satisfy\n// the full gRPC client interfaces.\n\ntype safeInventory struct {\n\tholds atomic.Int64\n}\n\nfunc (m *safeInventory) SetStock(ctx context.Context, in *inventorypb.SetStockRequest, opts ...grpc.CallOption) (*inventorypb.SetStockResponse, error) {\n\treturn &inventorypb.SetStockResponse{}, nil\n}\nfunc (m *safeInventory) Hold(ctx context.Context, in *inventorypb.HoldRequest, opts ...grpc.CallOption) (*inventorypb.HoldResponse, error) {\n\tn := m.holds.Add(1)\n\treturn &inventorypb.HoldResponse{HoldId: \"hold-\" + itoa(n)}, nil\n}\nfunc (m *safeInventory) Commit(ctx context.Context, in *inventorypb.CommitRequest, opts ...grpc.CallOption) (*inventorypb.CommitResponse, error) {\n\treturn &inventorypb.CommitResponse{}, nil\n}\nfunc (m *safeInventory) Release(ctx context.Context, in *inventorypb.ReleaseRequest, opts ...grpc.CallOption) (*inventorypb.ReleaseResponse, error) {\n\treturn &inventorypb.ReleaseResponse{}, nil\n}\n\ntype safePayment struct {\n\tauths atomic.Int64\n}\n\nfunc (m *safePayment) Authorize(ctx context.Context, in *paymentpb.AuthorizeRequest, opts ...grpc.CallOption) (*paymentpb.AuthorizeResponse, error) {\n\tn := m.auths.Add(1)\n\treturn &paymentpb.AuthorizeResponse{AuthId: \"auth-\" + itoa(n)}, nil\n}\nfunc (m *safePayment) Capture(ctx context.Context, in *paymentpb.CaptureRequest, opts ...grpc.CallOption) (*paymentpb.CaptureResponse, error) {\n\treturn &paymentpb.CaptureResponse{}, nil\n}\nfunc (m *safePayment) Void(ctx context.Context, in *paymentpb.VoidRequest, opts ...grpc.CallOption) (*paymentpb.VoidResponse, error) {\n\treturn &paymentpb.VoidResponse{}, nil\n}\nfunc (m *safePayment) Refund(ctx context.Context, in *paymentpb.RefundRequest, opts ...grpc.CallOption) (*paymentpb.RefundResponse, error) {\n\treturn &paymentpb.RefundResponse{}, nil\n}\n\nfunc itoa(n int64) string {\n\tif n == 0 {\n\t\treturn \"0\"\n\t}\n\tvar buf [20]byte\n\ti := len(buf)\n\tfor n > 0 {\n\t\ti--\n\t\tbuf[i] = byte('0' + n%10)\n\t\tn /= 10\n\t}\n\treturn string(buf[i:])\n}\n\n// pgBookingServers returns two booking Servers backed by the same\n// Postgres database (each with its own fresh mock upstreams), plus a\n// teardown. The two-server setup lets the durability test prove that a\n// booking persisted through s1 is readable through s2 — i.e. the record\n// lives in Postgres, not process memory. Skips if PG_DSN is unset.\nfunc pgBookingServers(t *testing.T) (s1, s2 *server.Server, done func()) {\n\tt.Helper()\n\tdsn := os.Getenv(\"PG_DSN\")\n\tif dsn == \"\" {\n\t\tt.Skip(\"PG_DSN not set; skipping Postgres-backed v2 test\")\n\t}\n\tst1, err := store.NewPGStore(context.Background(), dsn)\n\tif err != nil {\n\t\tt.Fatalf(\"connect pgStore #1: %v\", err)\n\t}\n\tst2, err := store.NewPGStore(context.Background(), dsn)\n\tif err != nil {\n\t\tst1.Close()\n\t\tt.Fatalf(\"connect pgStore #2: %v\", err)\n\t}\n\ts1 = server.NewServerWithStore(&safePayment{}, &safeInventory{}, st1)\n\ts2 = server.NewServerWithStore(&safePayment{}, &safeInventory{}, st2)\n\treturn s1, s2, func() { st1.Close(); st2.Close() }\n}\n\nfunc createOK(t *testing.T, s *server.Server, user, key string) string {\n\tt.Helper()\n\tr, err := s.CreateBooking(context.Background(), &bookingpb.CreateBookingRequest{\n\t\tUserId: user, HotelId: \"H_v2\", RoomType: \"STD\", Date: \"2026-07-01\",\n\t\tAmount: 5000, Currency: \"USD\", PaymentToken: \"tok\", IdempotencyKey: key,\n\t})\n\tif err != nil {\n\t\tt.Fatalf(\"CreateBooking(%s,%s): %v\", user, key, err)\n\t}\n\treturn r.GetBookingId()\n}\n\n// ════════════════════════════════════════════════════════════════════════════\n// Durability across \"service restart\"\n//\n// A booking created through s1 must be readable through s2 (a separate\n// Server on the same DB). Models a restart: s1's process effectively goes\n// away, s2 is a fresh process. If the record were kept in process memory,\n// GetBooking on s2 would return NotFound.\n// ════════════════════════════════════════════════════════════════════════════\nfunc TestV2_DurableAcrossRestart(t *testing.T) {\n\ts1, s2, done := pgBookingServers(t)\n\tdefer done()\n\tctx := context.Background()\n\n\tid := createOK(t, s1, \"u_durable\", \"k_durable_\"+t.Name())\n\n\tgot, err := s2.GetBooking(ctx, &bookingpb.GetBookingRequest{BookingId: id})\n\tif err != nil {\n\t\tt.Fatalf(\"GetBooking on second server: %v\", err)\n\t}\n\tif got.GetUserId() != \"u_durable\" || got.GetStatus() != \"confirmed\" || got.GetAmount() != 5000 {\n\t\tt.Errorf(\"restored booking mismatched: %+v\", got)\n\t}\n}\n\n// ════════════════════════════════════════════════════════════════════════════\n// Durable idempotency across \"restart\"\n//\n// Replaying the same idempotency_key through a different Server must\n// return the original booking_id without running the saga again. Pins\n// that the idempotency index lives in Postgres, not memory.\n// ════════════════════════════════════════════════════════════════════════════\nfunc TestV2_IdempotentAcrossRestart(t *testing.T) {\n\ts1, s2, done := pgBookingServers(t)\n\tdefer done()\n\tctx := context.Background()\n\n\tkey := \"k_idem_\" + t.Name()\n\tfirst := createOK(t, s1, \"u_idem\", key)\n\n\tr, err := s2.CreateBooking(ctx, &bookingpb.CreateBookingRequest{\n\t\tUserId: \"u_idem\", HotelId: \"H_v2\", RoomType: \"STD\", Date: \"2026-07-01\",\n\t\tAmount: 5000, Currency: \"USD\", PaymentToken: \"tok\", IdempotencyKey: key,\n\t})\n\tif err != nil {\n\t\tt.Fatalf(\"replayed CreateBooking on second server: %v\", err)\n\t}\n\tif r.GetBookingId() != first {\n\t\tt.Errorf(\"idempotent replay returned %q, want original %q\", r.GetBookingId(), first)\n\t}\n}\n\n// ════════════════════════════════════════════════════════════════════════════\n// Concurrent CreateBooking with the same idempotency_key\n//\n// N goroutines fire CreateBooking with one shared key. The saga must run\n// at most once (verified via the atomic Hold counter on the shared mock\n// inventory) and every caller must receive the SAME booking_id. Without a\n// transactional unique-constraint on idempotency_key, two callers would\n// both run the saga (double Hold / double charge) and persist divergent\n// bookings.\n// ════════════════════════════════════════════════════════════════════════════\nfunc TestV2_ConcurrentSameKey_SagaRunsOnce(t *testing.T) {\n\tdsn := os.Getenv(\"PG_DSN\")\n\tif dsn == \"\" {\n\t\tt.Skip(\"PG_DSN not set; skipping Postgres-backed v2 test\")\n\t}\n\tst, err := store.NewPGStore(context.Background(), dsn)\n\tif err != nil {\n\t\tt.Fatalf(\"connect pgStore: %v\", err)\n\t}\n\tdefer st.Close()\n\n\tinv := &safeInventory{}\n\tpay := &safePayment{}\n\ts := server.NewServerWithStore(pay, inv, st)\n\n\tconst racers = 10\n\tkey := \"k_race_\" + t.Name()\n\treq := &bookingpb.CreateBookingRequest{\n\t\tUserId: \"u_race\", HotelId: \"H_v2\", RoomType: \"STD\", Date: \"2026-07-01\",\n\t\tAmount: 5000, Currency: \"USD\", PaymentToken: \"tok\", IdempotencyKey: key,\n\t}\n\n\tvar wg sync.WaitGroup\n\tids := make([]string, racers)\n\terrs := make([]error, racers)\n\twg.Add(racers)\n\tfor i := 0; i < racers; i++ {\n\t\tgo func(i int) {\n\t\t\tdefer wg.Done()\n\t\t\tr, err := s.CreateBooking(context.Background(), req)\n\t\t\tif err != nil {\n\t\t\t\terrs[i] = err\n\t\t\t\treturn\n\t\t\t}\n\t\t\tids[i] = r.GetBookingId()\n\t\t}(i)\n\t}\n\twg.Wait()\n\n\t// Every call must have succeeded (a loser on the idempotency race\n\t// returns the winner's id, it does not error).\n\tfor i, err := range errs {\n\t\tif err != nil {\n\t\t\tt.Errorf(\"racer %d errored: %v\", i, err)\n\t\t}\n\t}\n\t// All booking_ids must be identical and non-empty.\n\tfor i := 1; i < racers; i++ {\n\t\tif ids[i] != ids[0] {\n\t\t\tt.Errorf(\"racer %d got booking_id %q, want %q (divergent bookings)\", i, ids[i], ids[0])\n\t\t}\n\t}\n\tif ids[0] == \"\" {\n\t\tt.Fatalf(\"no booking_id produced\")\n\t}\n\t// The saga must have run at most once: exactly one inventory Hold.\n\tif got := inv.holds.Load(); got != 1 {\n\t\tt.Errorf(\"inventory.Hold called %d times, want exactly 1 (saga ran more than once)\", got)\n\t}\n}\n\n// Compile-time guard: the v2-local mocks satisfy the gRPC client\n// interfaces the booking server depends on. Mirrors how the constructor\n// is wired in production.\nvar (\n\t_ inventorypb.InventoryServiceClient = (*safeInventory)(nil)\n\t_ paymentpb.PaymentServiceClient     = (*safePayment)(nil)\n)\n","numLines":263,"startLine":1,"totalLines":263}}}
