{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LBAsc73KPA6xJLoKtLMQH1","type":"tool_result","content":"1\t// Unit tests for auth, derived from SPEC.yaml.\n2\t//\n3\t// What this service is:\n4\t//   auth issues and verifies tokens. v1 is in-memory: Register stores a\n5\t//   salted password hash; Login verifies it and issues a JWT access token +\n6\t//   an opaque refresh token; VerifyToken validates the JWT; Refresh mints a\n7\t//   new access token; Logout revokes a refresh session.\n8\t//\n9\t// Test contract assumed about the implementation:\n10\t//   - `server.NewServer()` returns a *Server implementing pb.AuthServiceServer.\n11\t//   - Standard gRPC signatures; errors via google.golang.org/grpc/status with\n12\t//     the codes in SPEC.error_semantics.\n13\t//\n14\t// Tokens are opaque to these tests — they exercise round-trips\n15\t// (register → login → verify / refresh / logout) rather than inspecting token\n16\t// internals.\n17\t//\n18\t// Authored out-of-band and audited before the agent implements. The agent\n19\t// must not modify this file.\n20\t\n21\tpackage server_test\n22\t\n23\timport (\n24\t\t\"context\"\n25\t\t\"testing\"\n26\t\n27\t\tpb \"agentbench/services/auth/api/v1\"\n28\t\t\"agentbench/services/auth/internal/server\"\n29\t\n30\t\t\"google.golang.org/grpc/codes\"\n31\t\t\"google.golang.org/grpc/status\"\n32\t)\n33\t\n34\tfunc registerOK(t *testing.T, s pb.AuthServiceServer, email, pw string) {\n35\t\tt.Helper()\n36\t\tif _, err := s.Register(context.Background(), &pb.RegisterRequest{Email: email, Password: pw}); err != nil {\n37\t\t\tt.Fatalf(\"Register(%s): %v\", email, err)\n38\t\t}\n39\t}\n40\t\n41\t// loginOK logs in and returns (access_token, refresh_token), both asserted\n42\t// non-empty.\n43\tfunc loginOK(t *testing.T, s pb.AuthServiceServer, email, pw string) (string, string) {\n44\t\tt.Helper()\n45\t\tr, err := s.Login(context.Background(), &pb.LoginRequest{Email: email, Password: pw})\n46\t\tif err != nil {\n47\t\t\tt.Fatalf(\"Login(%s): %v\", email, err)\n48\t\t}\n49\t\tif r.GetAccessToken() == \"\" || r.GetRefreshToken() == \"\" {\n50\t\t\tt.Fatalf(\"Login returned empty tokens: access=%q refresh=%q\", r.GetAccessToken(), r.GetRefreshToken())\n51\t\t}\n52\t\treturn r.GetAccessToken(), r.GetRefreshToken()\n53\t}\n54\t\n55\tfunc wantCode(t *testing.T, err error, want codes.Code) {\n56\t\tt.Helper()\n57\t\tif got := status.Code(err); got != want {\n58\t\t\tt.Errorf(\"status code = %v, want %v (err=%v)\", got, want, err)\n59\t\t}\n60\t}\n61\t\n62\t// ════════════════════════════════════════════════════════════════════════════\n63\t// Register / Login\n64\t// ════════════════════════════════════════════════════════════════════════════\n65\t\n66\t// Register then Login succeeds and yields non-empty tokens.\n67\tfunc TestRegisterThenLogin(t *testing.T) {\n68\t\ts := server.NewServer()\n69\t\tregisterOK(t, s, \"a@x.com\", \"pw\")\n70\t\tloginOK(t, s, \"a@x.com\", \"pw\")\n71\t}\n72\t\n73\t// Registering the same email twice is AlreadyExists.\n74\tfunc TestRegister_Duplicate(t *testing.T) {\n75\t\ts := server.NewServer()\n76\t\tregisterOK(t, s, \"a@x.com\", \"pw\")\n77\t\t_, err := s.Register(context.Background(), &pb.RegisterRequest{Email: \"a@x.com\", Password: \"other\"})\n78\t\twantCode(t, err, codes.AlreadyExists)\n79\t}\n80\t\n81\t// Empty email or password is InvalidArgument.\n82\tfunc TestRegister_InvalidArgument(t *testing.T) {\n83\t\ts := server.NewServer()\n84\t\t_, err := s.Register(context.Background(), &pb.RegisterRequest{Email: \"\", Password: \"pw\"})\n85\t\twantCode(t, err, codes.InvalidArgument)\n86\t\t_, err = s.Register(context.Background(), &pb.RegisterRequest{Email: \"a@x.com\", Password: \"\"})\n87\t\twantCode(t, err, codes.InvalidArgument)\n88\t}\n89\t\n90\t// Wrong password is Unauthenticated.\n91\tfunc TestLogin_WrongPassword(t *testing.T) {\n92\t\ts := server.NewServer()\n93\t\tregisterOK(t, s, \"a@x.com\", \"pw\")\n94\t\t_, err := s.Login(context.Background(), &pb.LoginRequest{Email: \"a@x.com\", Password: \"nope\"})\n95\t\twantCode(t, err, codes.Unauthenticated)\n96\t}\n97\t\n98\t// Unknown email is Unauthenticated (does not leak that the email is unknown\n99\t// via a different code).\n100\tfunc TestLogin_UnknownEmail(t *testing.T) {\n101\t\ts := server.NewServer()\n102\t\t_, err := s.Login(context.Background(), &pb.LoginRequest{Email: \"ghost@x.com\", Password: \"pw\"})\n103\t\twantCode(t, err, codes.Unauthenticated)\n104\t}\n105\t\n106\t// ════════════════════════════════════════════════════════════════════════════\n107\t// VerifyToken\n108\t// ════════════════════════════════════════════════════════════════════════════\n109\t\n110\t// A freshly issued access token verifies and returns the user's claims with\n111\t// the guest scope.\n112\tfunc TestVerifyToken_Happy(t *testing.T) {\n113\t\ts := server.NewServer()\n114\t\tregisterOK(t, s, \"a@x.com\", \"pw\")\n115\t\taccess, _ := loginOK(t, s, \"a@x.com\", \"pw\")\n116\t\n117\t\tclaims, err := s.VerifyToken(context.Background(), &pb.VerifyTokenRequest{AccessToken: access})\n118\t\tif err != nil {\n119\t\t\tt.Fatalf(\"VerifyToken: %v\", err)\n120\t\t}\n121\t\tif claims.GetUserId() == \"\" {\n122\t\t\tt.Errorf(\"user_id empty\")\n123\t\t}\n124\t\tif claims.GetScope() != \"guest\" {\n125\t\t\tt.Errorf(\"scope = %q, want guest\", claims.GetScope())\n126\t\t}\n127\t}\n128\t\n129\t// Distinct users verify to distinct user_ids.\n130\tfunc TestVerifyToken_DistinctUsers(t *testing.T) {\n131\t\ts := server.NewServer()\n132\t\tregisterOK(t, s, \"a@x.com\", \"pw\")\n133\t\tregisterOK(t, s, \"b@x.com\", \"pw\")\n134\t\tat1, _ := loginOK(t, s, \"a@x.com\", \"pw\")\n135\t\tat2, _ := loginOK(t, s, \"b@x.com\", \"pw\")\n136\t\n137\t\tc1, err := s.VerifyToken(context.Background(), &pb.VerifyTokenRequest{AccessToken: at1})\n138\t\tif err != nil {\n139\t\t\tt.Fatalf(\"VerifyToken a: %v\", err)\n140\t\t}\n141\t\tc2, err := s.VerifyToken(context.Background(), &pb.VerifyTokenRequest{AccessToken: at2})\n142\t\tif err != nil {\n143\t\t\tt.Fatalf(\"VerifyToken b: %v\", err)\n144\t\t}\n145\t\tif c1.GetUserId() == c2.GetUserId() {\n146\t\t\tt.Errorf(\"distinct users share a user_id: %q\", c1.GetUserId())\n147\t\t}\n148\t}\n149\t\n150\t// A garbage / unsigned token is Unauthenticated.\n151\tfunc TestVerifyToken_Invalid(t *testing.T) {\n152\t\ts := server.NewServer()\n153\t\t_, err := s.VerifyToken(context.Background(), &pb.VerifyTokenRequest{AccessToken: \"not.a.jwt\"})\n154\t\twantCode(t, err, codes.Unauthenticated)\n155\t}\n156\t\n157\t// Empty access token is InvalidArgument.\n158\tfunc TestVerifyToken_Empty(t *testing.T) {\n159\t\ts := server.NewServer()\n160\t\t_, err := s.VerifyToken(context.Background(), &pb.VerifyTokenRequest{AccessToken: \"\"})\n161\t\twantCode(t, err, codes.InvalidArgument)\n162\t}\n163\t\n164\t// ════════════════════════════════════════════════════════════════════════════\n165\t// Refresh / Logout\n166\t// ════════════════════════════════════════════════════════════════════════════\n167\t\n168\t// A valid refresh token mints a new access token that itself verifies.\n169\tfunc TestRefresh_Happy(t *testing.T) {\n170\t\ts := server.NewServer()\n171\t\tregisterOK(t, s, \"a@x.com\", \"pw\")\n172\t\t_, refresh := loginOK(t, s, \"a@x.com\", \"pw\")\n173\t\n174\t\tr, err := s.Refresh(context.Background(), &pb.RefreshRequest{RefreshToken: refresh})\n175\t\tif err != nil {\n176\t\t\tt.Fatalf(\"Refresh: %v\", err)\n177\t\t}\n178\t\tif r.GetAccessToken() == \"\" {\n179\t\t\tt.Fatalf(\"Refresh returned empty access token\")\n180\t\t}\n181\t\tif _, err := s.VerifyToken(context.Background(), &pb.VerifyTokenRequest{AccessToken: r.GetAccessToken()}); err != nil {\n182\t\t\tt.Errorf(\"refreshed access token failed to verify: %v\", err)\n183\t\t}\n184\t}\n185\t\n186\t// An unknown refresh token is Unauthenticated.\n187\tfunc TestRefresh_Unknown(t *testing.T) {\n188\t\ts := server.NewServer()\n189\t\t_, err := s.Refresh(context.Background(), &pb.RefreshRequest{RefreshToken: \"nope\"})\n190\t\twantCode(t, err, codes.Unauthenticated)\n191\t}\n192\t\n193\t// After Logout, the refresh token can no longer be refreshed.\n194\tfunc TestLogout_RevokesRefresh(t *testing.T) {\n195\t\ts := server.NewServer()\n196\t\tregisterOK(t, s, \"a@x.com\", \"pw\")\n197\t\t_, refresh := loginOK(t, s, \"a@x.com\", \"pw\")\n198\t\n199\t\tif _, err := s.Logout(context.Background(), &pb.LogoutRequest{RefreshToken: refresh}); err != nil {\n200\t\t\tt.Fatalf(\"Logout: %v\", err)\n201\t\t}\n202\t\t_, err := s.Refresh(context.Background(), &pb.RefreshRequest{RefreshToken: refresh})\n203\t\twantCode(t, err, codes.Unauthenticated)\n204\t}\n205\t\n206\t// Logout is idempotent: revoking an unknown token still returns success.\n207\tfunc TestLogout_Idempotent(t *testing.T) {\n208\t\ts := server.NewServer()\n209\t\tif _, err := s.Logout(context.Background(), &pb.LogoutRequest{RefreshToken: \"never-existed\"}); err != nil {\n210\t\t\tt.Errorf(\"Logout of unknown token should succeed, got: %v\", err)\n211\t\t}\n212\t}\n213\t\n214\t// Empty refresh token is InvalidArgument for both Refresh and Logout.\n215\tfunc TestRefreshLogout_EmptyToken(t *testing.T) {\n216\t\ts := server.NewServer()\n217\t\t_, err := s.Refresh(context.Background(), &pb.RefreshRequest{RefreshToken: \"\"})\n218\t\twantCode(t, err, codes.InvalidArgument)\n219\t\t_, err = s.Logout(context.Background(), &pb.LogoutRequest{RefreshToken: \"\"})\n220\t\twantCode(t, err, codes.InvalidArgument)\n221\t}\n222\t"}]},"parent_tool_use_id":null,"session_id":"2bc9541c-fba5-42cf-ac81-69a543e94cfc","uuid":"fffd39e2-0201-4d4a-b072-e0e78ddaed3b","timestamp":"2026-06-08T00:49:15.749Z","tool_use_result":{"type":"text","file":{"filePath":"/home/leochanj/Desktop/agentbench/services/auth/internal/server/server_test.go","content":"// Unit tests for auth, derived from SPEC.yaml.\n//\n// What this service is:\n//   auth issues and verifies tokens. v1 is in-memory: Register stores a\n//   salted password hash; Login verifies it and issues a JWT access token +\n//   an opaque refresh token; VerifyToken validates the JWT; Refresh mints a\n//   new access token; Logout revokes a refresh session.\n//\n// Test contract assumed about the implementation:\n//   - `server.NewServer()` returns a *Server implementing pb.AuthServiceServer.\n//   - Standard gRPC signatures; errors via google.golang.org/grpc/status with\n//     the codes in SPEC.error_semantics.\n//\n// Tokens are opaque to these tests — they exercise round-trips\n// (register → login → verify / refresh / logout) rather than inspecting token\n// internals.\n//\n// Authored out-of-band and audited before the agent implements. The agent\n// must not modify this file.\n\npackage server_test\n\nimport (\n\t\"context\"\n\t\"testing\"\n\n\tpb \"agentbench/services/auth/api/v1\"\n\t\"agentbench/services/auth/internal/server\"\n\n\t\"google.golang.org/grpc/codes\"\n\t\"google.golang.org/grpc/status\"\n)\n\nfunc registerOK(t *testing.T, s pb.AuthServiceServer, email, pw string) {\n\tt.Helper()\n\tif _, err := s.Register(context.Background(), &pb.RegisterRequest{Email: email, Password: pw}); err != nil {\n\t\tt.Fatalf(\"Register(%s): %v\", email, err)\n\t}\n}\n\n// loginOK logs in and returns (access_token, refresh_token), both asserted\n// non-empty.\nfunc loginOK(t *testing.T, s pb.AuthServiceServer, email, pw string) (string, string) {\n\tt.Helper()\n\tr, err := s.Login(context.Background(), &pb.LoginRequest{Email: email, Password: pw})\n\tif err != nil {\n\t\tt.Fatalf(\"Login(%s): %v\", email, err)\n\t}\n\tif r.GetAccessToken() == \"\" || r.GetRefreshToken() == \"\" {\n\t\tt.Fatalf(\"Login returned empty tokens: access=%q refresh=%q\", r.GetAccessToken(), r.GetRefreshToken())\n\t}\n\treturn r.GetAccessToken(), r.GetRefreshToken()\n}\n\nfunc wantCode(t *testing.T, err error, want codes.Code) {\n\tt.Helper()\n\tif got := status.Code(err); got != want {\n\t\tt.Errorf(\"status code = %v, want %v (err=%v)\", got, want, err)\n\t}\n}\n\n// ════════════════════════════════════════════════════════════════════════════\n// Register / Login\n// ════════════════════════════════════════════════════════════════════════════\n\n// Register then Login succeeds and yields non-empty tokens.\nfunc TestRegisterThenLogin(t *testing.T) {\n\ts := server.NewServer()\n\tregisterOK(t, s, \"a@x.com\", \"pw\")\n\tloginOK(t, s, \"a@x.com\", \"pw\")\n}\n\n// Registering the same email twice is AlreadyExists.\nfunc TestRegister_Duplicate(t *testing.T) {\n\ts := server.NewServer()\n\tregisterOK(t, s, \"a@x.com\", \"pw\")\n\t_, err := s.Register(context.Background(), &pb.RegisterRequest{Email: \"a@x.com\", Password: \"other\"})\n\twantCode(t, err, codes.AlreadyExists)\n}\n\n// Empty email or password is InvalidArgument.\nfunc TestRegister_InvalidArgument(t *testing.T) {\n\ts := server.NewServer()\n\t_, err := s.Register(context.Background(), &pb.RegisterRequest{Email: \"\", Password: \"pw\"})\n\twantCode(t, err, codes.InvalidArgument)\n\t_, err = s.Register(context.Background(), &pb.RegisterRequest{Email: \"a@x.com\", Password: \"\"})\n\twantCode(t, err, codes.InvalidArgument)\n}\n\n// Wrong password is Unauthenticated.\nfunc TestLogin_WrongPassword(t *testing.T) {\n\ts := server.NewServer()\n\tregisterOK(t, s, \"a@x.com\", \"pw\")\n\t_, err := s.Login(context.Background(), &pb.LoginRequest{Email: \"a@x.com\", Password: \"nope\"})\n\twantCode(t, err, codes.Unauthenticated)\n}\n\n// Unknown email is Unauthenticated (does not leak that the email is unknown\n// via a different code).\nfunc TestLogin_UnknownEmail(t *testing.T) {\n\ts := server.NewServer()\n\t_, err := s.Login(context.Background(), &pb.LoginRequest{Email: \"ghost@x.com\", Password: \"pw\"})\n\twantCode(t, err, codes.Unauthenticated)\n}\n\n// ════════════════════════════════════════════════════════════════════════════\n// VerifyToken\n// ════════════════════════════════════════════════════════════════════════════\n\n// A freshly issued access token verifies and returns the user's claims with\n// the guest scope.\nfunc TestVerifyToken_Happy(t *testing.T) {\n\ts := server.NewServer()\n\tregisterOK(t, s, \"a@x.com\", \"pw\")\n\taccess, _ := loginOK(t, s, \"a@x.com\", \"pw\")\n\n\tclaims, err := s.VerifyToken(context.Background(), &pb.VerifyTokenRequest{AccessToken: access})\n\tif err != nil {\n\t\tt.Fatalf(\"VerifyToken: %v\", err)\n\t}\n\tif claims.GetUserId() == \"\" {\n\t\tt.Errorf(\"user_id empty\")\n\t}\n\tif claims.GetScope() != \"guest\" {\n\t\tt.Errorf(\"scope = %q, want guest\", claims.GetScope())\n\t}\n}\n\n// Distinct users verify to distinct user_ids.\nfunc TestVerifyToken_DistinctUsers(t *testing.T) {\n\ts := server.NewServer()\n\tregisterOK(t, s, \"a@x.com\", \"pw\")\n\tregisterOK(t, s, \"b@x.com\", \"pw\")\n\tat1, _ := loginOK(t, s, \"a@x.com\", \"pw\")\n\tat2, _ := loginOK(t, s, \"b@x.com\", \"pw\")\n\n\tc1, err := s.VerifyToken(context.Background(), &pb.VerifyTokenRequest{AccessToken: at1})\n\tif err != nil {\n\t\tt.Fatalf(\"VerifyToken a: %v\", err)\n\t}\n\tc2, err := s.VerifyToken(context.Background(), &pb.VerifyTokenRequest{AccessToken: at2})\n\tif err != nil {\n\t\tt.Fatalf(\"VerifyToken b: %v\", err)\n\t}\n\tif c1.GetUserId() == c2.GetUserId() {\n\t\tt.Errorf(\"distinct users share a user_id: %q\", c1.GetUserId())\n\t}\n}\n\n// A garbage / unsigned token is Unauthenticated.\nfunc TestVerifyToken_Invalid(t *testing.T) {\n\ts := server.NewServer()\n\t_, err := s.VerifyToken(context.Background(), &pb.VerifyTokenRequest{AccessToken: \"not.a.jwt\"})\n\twantCode(t, err, codes.Unauthenticated)\n}\n\n// Empty access token is InvalidArgument.\nfunc TestVerifyToken_Empty(t *testing.T) {\n\ts := server.NewServer()\n\t_, err := s.VerifyToken(context.Background(), &pb.VerifyTokenRequest{AccessToken: \"\"})\n\twantCode(t, err, codes.InvalidArgument)\n}\n\n// ════════════════════════════════════════════════════════════════════════════\n// Refresh / Logout\n// ════════════════════════════════════════════════════════════════════════════\n\n// A valid refresh token mints a new access token that itself verifies.\nfunc TestRefresh_Happy(t *testing.T) {\n\ts := server.NewServer()\n\tregisterOK(t, s, \"a@x.com\", \"pw\")\n\t_, refresh := loginOK(t, s, \"a@x.com\", \"pw\")\n\n\tr, err := s.Refresh(context.Background(), &pb.RefreshRequest{RefreshToken: refresh})\n\tif err != nil {\n\t\tt.Fatalf(\"Refresh: %v\", err)\n\t}\n\tif r.GetAccessToken() == \"\" {\n\t\tt.Fatalf(\"Refresh returned empty access token\")\n\t}\n\tif _, err := s.VerifyToken(context.Background(), &pb.VerifyTokenRequest{AccessToken: r.GetAccessToken()}); err != nil {\n\t\tt.Errorf(\"refreshed access token failed to verify: %v\", err)\n\t}\n}\n\n// An unknown refresh token is Unauthenticated.\nfunc TestRefresh_Unknown(t *testing.T) {\n\ts := server.NewServer()\n\t_, err := s.Refresh(context.Background(), &pb.RefreshRequest{RefreshToken: \"nope\"})\n\twantCode(t, err, codes.Unauthenticated)\n}\n\n// After Logout, the refresh token can no longer be refreshed.\nfunc TestLogout_RevokesRefresh(t *testing.T) {\n\ts := server.NewServer()\n\tregisterOK(t, s, \"a@x.com\", \"pw\")\n\t_, refresh := loginOK(t, s, \"a@x.com\", \"pw\")\n\n\tif _, err := s.Logout(context.Background(), &pb.LogoutRequest{RefreshToken: refresh}); err != nil {\n\t\tt.Fatalf(\"Logout: %v\", err)\n\t}\n\t_, err := s.Refresh(context.Background(), &pb.RefreshRequest{RefreshToken: refresh})\n\twantCode(t, err, codes.Unauthenticated)\n}\n\n// Logout is idempotent: revoking an unknown token still returns success.\nfunc TestLogout_Idempotent(t *testing.T) {\n\ts := server.NewServer()\n\tif _, err := s.Logout(context.Background(), &pb.LogoutRequest{RefreshToken: \"never-existed\"}); err != nil {\n\t\tt.Errorf(\"Logout of unknown token should succeed, got: %v\", err)\n\t}\n}\n\n// Empty refresh token is InvalidArgument for both Refresh and Logout.\nfunc TestRefreshLogout_EmptyToken(t *testing.T) {\n\ts := server.NewServer()\n\t_, err := s.Refresh(context.Background(), &pb.RefreshRequest{RefreshToken: \"\"})\n\twantCode(t, err, codes.InvalidArgument)\n\t_, err = s.Logout(context.Background(), &pb.LogoutRequest{RefreshToken: \"\"})\n\twantCode(t, err, codes.InvalidArgument)\n}\n","numLines":222,"startLine":1,"totalLines":222}}}
