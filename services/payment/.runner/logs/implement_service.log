{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01WisgKN8ARwbJrSvdCcL6Ux","type":"tool_result","content":"1\t// Unit tests for the payment gRPC service, derived from SPEC.yaml.\n2\t//\n3\t// What this service is:\n4\t//   payment is a mock external payment processor (think Stripe). Four RPCs:\n5\t//     - Authorize: \"hold X dollars; here's a token to reference later\"\n6\t//     - Capture:   \"actually charge the held amount\"\n7\t//     - Void:      \"cancel the hold without charging\"\n8\t//     - Refund:    \"give back some/all of a captured charge\"\n9\t//   State machine per authorization:\n10\t//     authorized ──Capture──→ captured ──Refund(× many, partial)──\n11\t//                ──Void───→ voided\n12\t//   Storage is a single in-memory map keyed by auth_id; reset on restart.\n13\t//\n14\t// Test contract this file assumes about the agent's implementation:\n15\t//   - `server.NewServer()` returns a *Server (or other type) that satisfies\n16\t//     pb.PaymentServiceServer.\n17\t//   - Handlers carry the standard gRPC signatures:\n18\t//        func (s *Server) Authorize(context.Context, *pb.AuthorizeRequest) (*pb.AuthorizeResponse, error)\n19\t//        ... and the analogous shapes for Capture / Void / Refund.\n20\t//   - Error returns use google.golang.org/grpc/status.Error with the codes\n21\t//     declared in SPEC.yaml's `error_semantics`.\n22\t//\n23\t// Authored out-of-band and audited by a human before the agent generates the\n24\t// implementation. The agent must NOT modify this file.\n25\t\n26\tpackage server_test\n27\t\n28\timport (\n29\t\t\"context\"\n30\t\t\"testing\"\n31\t\n32\t\tpb \"agentbench/services/payment/api/v1\"\n33\t\t\"agentbench/services/payment/internal/server\"\n34\t\n35\t\t\"google.golang.org/grpc/codes\"\n36\t\t\"google.golang.org/grpc/status\"\n37\t)\n38\t\n39\t// authOK runs a successful Authorize and returns the auth_id. The setup\n40\t// path of most other tests depends on this working — if it doesn't,\n41\t// failing fast here gives a clearer signal than a confusing downstream error.\n42\tfunc authOK(t *testing.T, s pb.PaymentServiceServer, amount int64) string {\n43\t\tt.Helper()\n44\t\tr, err := s.Authorize(context.Background(), &pb.AuthorizeRequest{\n45\t\t\tAmount: amount, Currency: \"USD\", PaymentToken: \"tok\",\n46\t\t})\n47\t\tif err != nil {\n48\t\t\tt.Fatalf(\"Authorize(amount=%d): %v\", amount, err)\n49\t\t}\n50\t\treturn r.GetAuthId()\n51\t}\n52\t\n53\t// wantCode asserts the gRPC status code on a returned error.\n54\tfunc wantCode(t *testing.T, err error, want codes.Code) {\n55\t\tt.Helper()\n56\t\tif got := status.Code(err); got != want {\n57\t\t\tt.Errorf(\"status code = %v, want %v (err=%v)\", got, want, err)\n58\t\t}\n59\t}\n60\t\n61\t// ════════════════════════════════════════════════════════════════════════════\n62\t// Authorize\n63\t//\n64\t// \"Hold X dollars on this card; give me a token.\" Funds are earmarked but\n65\t// not yet moved. Every later operation (Capture/Void/Refund) references the\n66\t// returned auth_id.\n67\t// ════════════════════════════════════════════════════════════════════════════\n68\t\n69\t// A successful Authorize must return a non-empty auth_id. Without it,\n70\t// callers have no handle to reference the authorization later — the\n71\t// authorization would effectively be unreachable.\n72\tfunc TestAuthorize_ReturnsNonEmptyID(t *testing.T) {\n73\t\ts := server.NewServer()\n74\t\tif id := authOK(t, s, 100); id == \"\" {\n75\t\t\tt.Errorf(\"auth_id is empty, want non-empty\")\n76\t\t}\n77\t}\n78\t\n79\t// Two Authorize calls with identical inputs represent independent\n80\t// transactions. They must get distinct auth_ids; collisions would mean\n81\t// one authorization aliasing another (a later Capture on auth A would\n82\t// accidentally affect auth B).\n83\tfunc TestAuthorize_DistinctIDs(t *testing.T) {\n84\t\ts := server.NewServer()\n85\t\ta := authOK(t, s, 100)\n86\t\tb := authOK(t, s, 100)\n87\t\tif a == b {\n88\t\t\tt.Errorf(\"two Authorize calls returned the same auth_id %q\", a)\n89\t\t}\n90\t}\n91\t\n92\t// Three malformed-input cases, all of which SPEC declares must return\n93\t// InvalidArgument: a non-positive amount (zero or negative) makes no\n94\t// business sense, and an empty currency string is missing required data.\n95\tfunc TestAuthorize_InvalidArgument(t *testing.T) {\n96\t\ts := server.NewServer()\n97\t\tcases := []struct {\n98\t\t\tname string\n99\t\t\treq  *pb.AuthorizeRequest\n100\t\t}{\n101\t\t\t{\"amount zero\", &pb.AuthorizeRequest{Amount: 0, Currency: \"USD\", PaymentToken: \"t\"}},\n102\t\t\t{\"amount negative\", &pb.AuthorizeRequest{Amount: -1, Currency: \"USD\", PaymentToken: \"t\"}},\n103\t\t\t{\"empty currency\", &pb.AuthorizeRequest{Amount: 100, Currency: \"\", PaymentToken: \"t\"}},\n104\t\t}\n105\t\tfor _, tc := range cases {\n106\t\t\tt.Run(tc.name, func(t *testing.T) {\n107\t\t\t\t_, err := s.Authorize(context.Background(), tc.req)\n108\t\t\t\twantCode(t, err, codes.InvalidArgument)\n109\t\t\t})\n110\t\t}\n111\t}\n112\t\n113\t// ════════════════════════════════════════════════════════════════════════════\n114\t// Capture\n115\t//\n116\t// \"Actually charge the held amount.\" Moves an authorization from\n117\t// `authorized` to `captured`. Only valid against an authorization that's\n118\t// still in `authorized` state (or already `captured`, idempotently).\n119\t// ════════════════════════════════════════════════════════════════════════════\n120\t\n121\t// The straight-line path: Authorize then Capture(auth_id) succeeds with no\n122\t// error. This is the most common flow in production — funds get held, then\n123\t// charged.\n124\tfunc TestCapture_Happy(t *testing.T) {\n125\t\ts := server.NewServer()\n126\t\tid := authOK(t, s, 100)\n127\t\tif _, err := s.Capture(context.Background(), &pb.CaptureRequest{AuthId: id}); err != nil {\n128\t\t\tt.Errorf(\"Capture after Authorize: %v\", err)\n129\t\t}\n130\t}\n131\t\n132\t// Idempotency on retry. A client whose Capture request times out (network\n133\t// blip) doesn't know whether the server processed it; the safe action is\n134\t// to retry. The second Capture on an already-captured auth must succeed\n135\t// silently, not fail — otherwise the client is forced to distinguish\n136\t// \"didn't capture\" from \"captured but I don't know,\" which is impossible.\n137\tfunc TestCapture_Idempotent(t *testing.T) {\n138\t\ts := server.NewServer()\n139\t\tid := authOK(t, s, 100)\n140\t\tctx := context.Background()\n141\t\tif _, err := s.Capture(ctx, &pb.CaptureRequest{AuthId: id}); err != nil {\n142\t\t\tt.Fatalf(\"first Capture: %v\", err)\n143\t\t}\n144\t\tif _, err := s.Capture(ctx, &pb.CaptureRequest{AuthId: id}); err != nil {\n145\t\t\tt.Errorf(\"second Capture should be a no-op, got: %v\", err)\n146\t\t}\n147\t}\n148\t\n149\t// Capture against an auth_id that was never issued returns NotFound.\n150\t// There's nothing to capture; reject cleanly.\n151\tfunc TestCapture_NotFound(t *testing.T) {\n152\t\ts := server.NewServer()\n153\t\t_, err := s.Capture(context.Background(), &pb.CaptureRequest{AuthId: \"no-such-id\"})\n154\t\twantCode(t, err, codes.NotFound)\n155\t}\n156\t\n157\t// State-machine violation: an authorization that was Voided cannot be\n158\t// Captured afterward (the hold has been released; there's nothing left to\n159\t// charge). FailedPrecondition is the correct code per gRPC conventions —\n160\t// the request was well-formed but the resource isn't in a state that\n161\t// allows it.\n162\tfunc TestCapture_AfterVoid_FailedPrecondition(t *testing.T) {\n163\t\ts := server.NewServer()\n164\t\tid := authOK(t, s, 100)\n165\t\tctx := context.Background()\n166\t\tif _, err := s.Void(ctx, &pb.VoidRequest{AuthId: id}); err != nil {\n167\t\t\tt.Fatalf(\"Void: %v\", err)\n168\t\t}\n169\t\t_, err := s.Capture(ctx, &pb.CaptureRequest{AuthId: id})\n170\t\twantCode(t, err, codes.FailedPrecondition)\n171\t}\n172\t\n173\t// ════════════════════════════════════════════════════════════════════════════\n174\t// Void\n175\t//\n176\t// \"Release the hold without charging.\" Moves an authorization from\n177\t// `authorized` to `voided`. Only valid against an auth still in `authorized`\n178\t// state (or already `voided`, idempotently).\n179\t// ════════════════════════════════════════════════════════════════════════════\n180\t\n181\t// The cancel-before-charge path: Authorize then Void. Releases the hold\n182\t// cleanly, no money moved.\n183\tfunc TestVoid_Happy(t *testing.T) {\n184\t\ts := server.NewServer()\n185\t\tid := authOK(t, s, 100)\n186\t\tif _, err := s.Void(context.Background(), &pb.VoidRequest{AuthId: id}); err != nil {\n187\t\t\tt.Errorf(\"Void after Authorize: %v\", err)\n188\t\t}\n189\t}\n190\t\n191\t// Idempotency on retry — same reasoning as TestCapture_Idempotent: a\n192\t// network-timeout retry must not be punished. Second Void of an\n193\t// already-voided auth succeeds silently.\n194\tfunc TestVoid_Idempotent(t *testing.T) {\n195\t\ts := server.NewServer()\n196\t\tid := authOK(t, s, 100)\n197\t\tctx := context.Background()\n198\t\tif _, err := s.Void(ctx, &pb.VoidRequest{AuthId: id}); err != nil {\n199\t\t\tt.Fatalf(\"first Void: %v\", err)\n200\t\t}\n201\t\tif _, err := s.Void(ctx, &pb.VoidRequest{AuthId: id}); err != nil {\n202\t\t\tt.Errorf(\"second Void should be a no-op, got: %v\", err)\n203\t\t}\n204\t}\n205\t\n206\t// Void against an unknown auth_id is NotFound, same as Capture.\n207\tfunc TestVoid_NotFound(t *testing.T) {\n208\t\ts := server.NewServer()\n209\t\t_, err := s.Void(context.Background(), &pb.VoidRequest{AuthId: \"no-such-id\"})\n210\t\twantCode(t, err, codes.NotFound)\n211\t}\n212\t\n213\t// State-machine violation: once money has been captured, the auth can't be\n214\t// \"voided\" — that's what Refund is for. FailedPrecondition signals the\n215\t// state mismatch.\n216\tfunc TestVoid_AfterCapture_FailedPrecondition(t *testing.T) {\n217\t\ts := server.NewServer()\n218\t\tid := authOK(t, s, 100)\n219\t\tctx := context.Background()\n220\t\tif _, err := s.Capture(ctx, &pb.CaptureRequest{AuthId: id}); err != nil {\n221\t\t\tt.Fatalf(\"Capture: %v\", err)\n222\t\t}\n223\t\t_, err := s.Void(ctx, &pb.VoidRequest{AuthId: id})\n224\t\twantCode(t, err, codes.FailedPrecondition)\n225\t}\n226\t\n227\t// ════════════════════════════════════════════════════════════════════════════\n228\t// Refund\n229\t//\n230\t// \"Give back some or all of a captured charge.\" Only valid against\n231\t// `captured` authorizations, and only up to (captured_amount − already_refunded).\n232\t// Refunds accumulate across multiple calls.\n233\t// ════════════════════════════════════════════════════════════════════════════\n234\t\n235\t// Refund of less than the full captured amount: valid. The auth stays in\n236\t// `captured` state; only the refunded counter increases.\n237\tfunc TestRefund_Partial(t *testing.T) {\n238\t\ts := server.NewServer()\n239\t\tid := authOK(t, s, 100)\n240\t\tctx := context.Background()\n241\t\tif _, err := s.Capture(ctx, &pb.CaptureRequest{AuthId: id}); err != nil {\n242\t\t\tt.Fatalf(\"Capture: %v\", err)\n243\t\t}\n244\t\tif _, err := s.Refund(ctx, &pb.RefundRequest{AuthId: id, Amount: 30}); err != nil {\n245\t\t\tt.Errorf(\"partial Refund: %v\", err)\n246\t\t}\n247\t}\n248\t\n249\t// Refund for the full captured amount in one shot. Valid (exactly equals\n250\t// the remaining refundable balance).\n251\tfunc TestRefund_Full(t *testing.T) {\n252\t\ts := server.NewServer()\n253\t\tid := authOK(t, s, 100)\n254\t\tctx := context.Background()\n255\t\tif _, err := s.Capture(ctx, &pb.CaptureRequest{AuthId: id}); err != nil {\n256\t\t\tt.Fatalf(\"Capture: %v\", err)\n257\t\t}\n258\t\tif _, err := s.Refund(ctx, &pb.RefundRequest{AuthId: id, Amount: 100}); err != nil {\n259\t\t\tt.Errorf(\"full Refund: %v\", err)\n260\t\t}\n261\t}\n262\t\n263\t// Accumulation: a captured 100 minus two refunds of 30 leaves 40\n264\t// refundable. A third refund of 50 exceeds that and must fail with\n265\t// FailedPrecondition. This is the load-bearing test for the \"refunded so\n266\t// far\" counter — if the implementation forgets to track it, refunds would\n267\t// be evaluated against the original captured amount each time, and the\n268\t// over-refund check here would erroneously pass.\n269\tfunc TestRefund_AccumulatesAcrossCalls(t *testing.T) {\n270\t\ts := server.NewServer()\n271\t\tid := authOK(t, s, 100)\n272\t\tctx := context.Background()\n273\t\tif _, err := s.Capture(ctx, &pb.CaptureRequest{AuthId: id}); err != nil {\n274\t\t\tt.Fatalf(\"Capture: %v\", err)\n275\t\t}\n276\t\t// Refund 30 + 30 = 60; remaining refundable = 40.\n277\t\tif _, err := s.Refund(ctx, &pb.RefundRequest{AuthId: id, Amount: 30}); err != nil {\n278\t\t\tt.Fatalf(\"first Refund: %v\", err)\n279\t\t}\n280\t\tif _, err := s.Refund(ctx, &pb.RefundRequest{AuthId: id, Amount: 30}); err != nil {\n281\t\t\tt.Fatalf(\"second Refund: %v\", err)\n282\t\t}\n283\t\t// Third refund of 50 exceeds remaining 40 → FailedPrecondition.\n284\t\t_, err := s.Refund(ctx, &pb.RefundRequest{AuthId: id, Amount: 50})\n285\t\twantCode(t, err, codes.FailedPrecondition)\n286\t}\n287\t\n288\t// Refund against an unknown auth_id is NotFound.\n289\tfunc TestRefund_NotFound(t *testing.T) {\n290\t\ts := server.NewServer()\n291\t\t_, err := s.Refund(context.Background(), &pb.RefundRequest{AuthId: \"no-such-id\", Amount: 10})\n292\t\twantCode(t, err, codes.NotFound)\n293\t}\n294\t\n295\t// Single-call over-refund: a captured 100 cannot be refunded for 150.\n296\t// FailedPrecondition signals the state/amount mismatch.\n297\tfunc TestRefund_OverCapture_FailedPrecondition(t *testing.T) {\n298\t\ts := server.NewServer()\n299\t\tid := authOK(t, s, 100)\n300\t\tctx := context.Background()\n301\t\tif _, err := s.Capture(ctx, &pb.CaptureRequest{AuthId: id}); err != nil {\n302\t\t\tt.Fatalf(\"Capture: %v\", err)\n303\t\t}\n304\t\t_, err := s.Refund(ctx, &pb.RefundRequest{AuthId: id, Amount: 150})\n305\t\twantCode(t, err, codes.FailedPrecondition)\n306\t}\n307\t\n308\t// Refund without a preceding Capture: the auth is in `authorized` state\n309\t// (or even `voided`), captured_amount = 0, so any positive refund exceeds\n310\t// the remaining (0 − 0) and returns FailedPrecondition. Covers the\n311\t// \"refund the wrong thing\" mistake — refunds only make sense after charge.\n312\tfunc TestRefund_WithoutCapture_FailedPrecondition(t *testing.T) {\n313\t\ts := server.NewServer()\n314\t\tid := authOK(t, s, 100)\n315\t\t_, err := s.Refund(context.Background(), &pb.RefundRequest{AuthId: id, Amount: 10})\n316\t\twantCode(t, err, codes.FailedPrecondition)\n317\t}\n318\t"}]},"parent_tool_use_id":null,"session_id":"0365300d-3943-470d-ade0-b491d9df15dc","uuid":"c678c4fe-d359-4808-814d-47fe4627edcb","timestamp":"2026-05-28T23:58:12.478Z","tool_use_result":{"type":"text","file":{"filePath":"/home/leochanj/Desktop/agentbench/services/payment/internal/server/server_test.go","content":"// Unit tests for the payment gRPC service, derived from SPEC.yaml.\n//\n// What this service is:\n//   payment is a mock external payment processor (think Stripe). Four RPCs:\n//     - Authorize: \"hold X dollars; here's a token to reference later\"\n//     - Capture:   \"actually charge the held amount\"\n//     - Void:      \"cancel the hold without charging\"\n//     - Refund:    \"give back some/all of a captured charge\"\n//   State machine per authorization:\n//     authorized ──Capture──→ captured ──Refund(× many, partial)──\n//                ──Void───→ voided\n//   Storage is a single in-memory map keyed by auth_id; reset on restart.\n//\n// Test contract this file assumes about the agent's implementation:\n//   - `server.NewServer()` returns a *Server (or other type) that satisfies\n//     pb.PaymentServiceServer.\n//   - Handlers carry the standard gRPC signatures:\n//        func (s *Server) Authorize(context.Context, *pb.AuthorizeRequest) (*pb.AuthorizeResponse, error)\n//        ... and the analogous shapes for Capture / Void / Refund.\n//   - Error returns use google.golang.org/grpc/status.Error with the codes\n//     declared in SPEC.yaml's `error_semantics`.\n//\n// Authored out-of-band and audited by a human before the agent generates the\n// implementation. The agent must NOT modify this file.\n\npackage server_test\n\nimport (\n\t\"context\"\n\t\"testing\"\n\n\tpb \"agentbench/services/payment/api/v1\"\n\t\"agentbench/services/payment/internal/server\"\n\n\t\"google.golang.org/grpc/codes\"\n\t\"google.golang.org/grpc/status\"\n)\n\n// authOK runs a successful Authorize and returns the auth_id. The setup\n// path of most other tests depends on this working — if it doesn't,\n// failing fast here gives a clearer signal than a confusing downstream error.\nfunc authOK(t *testing.T, s pb.PaymentServiceServer, amount int64) string {\n\tt.Helper()\n\tr, err := s.Authorize(context.Background(), &pb.AuthorizeRequest{\n\t\tAmount: amount, Currency: \"USD\", PaymentToken: \"tok\",\n\t})\n\tif err != nil {\n\t\tt.Fatalf(\"Authorize(amount=%d): %v\", amount, err)\n\t}\n\treturn r.GetAuthId()\n}\n\n// wantCode asserts the gRPC status code on a returned error.\nfunc wantCode(t *testing.T, err error, want codes.Code) {\n\tt.Helper()\n\tif got := status.Code(err); got != want {\n\t\tt.Errorf(\"status code = %v, want %v (err=%v)\", got, want, err)\n\t}\n}\n\n// ════════════════════════════════════════════════════════════════════════════\n// Authorize\n//\n// \"Hold X dollars on this card; give me a token.\" Funds are earmarked but\n// not yet moved. Every later operation (Capture/Void/Refund) references the\n// returned auth_id.\n// ════════════════════════════════════════════════════════════════════════════\n\n// A successful Authorize must return a non-empty auth_id. Without it,\n// callers have no handle to reference the authorization later — the\n// authorization would effectively be unreachable.\nfunc TestAuthorize_ReturnsNonEmptyID(t *testing.T) {\n\ts := server.NewServer()\n\tif id := authOK(t, s, 100); id == \"\" {\n\t\tt.Errorf(\"auth_id is empty, want non-empty\")\n\t}\n}\n\n// Two Authorize calls with identical inputs represent independent\n// transactions. They must get distinct auth_ids; collisions would mean\n// one authorization aliasing another (a later Capture on auth A would\n// accidentally affect auth B).\nfunc TestAuthorize_DistinctIDs(t *testing.T) {\n\ts := server.NewServer()\n\ta := authOK(t, s, 100)\n\tb := authOK(t, s, 100)\n\tif a == b {\n\t\tt.Errorf(\"two Authorize calls returned the same auth_id %q\", a)\n\t}\n}\n\n// Three malformed-input cases, all of which SPEC declares must return\n// InvalidArgument: a non-positive amount (zero or negative) makes no\n// business sense, and an empty currency string is missing required data.\nfunc TestAuthorize_InvalidArgument(t *testing.T) {\n\ts := server.NewServer()\n\tcases := []struct {\n\t\tname string\n\t\treq  *pb.AuthorizeRequest\n\t}{\n\t\t{\"amount zero\", &pb.AuthorizeRequest{Amount: 0, Currency: \"USD\", PaymentToken: \"t\"}},\n\t\t{\"amount negative\", &pb.AuthorizeRequest{Amount: -1, Currency: \"USD\", PaymentToken: \"t\"}},\n\t\t{\"empty currency\", &pb.AuthorizeRequest{Amount: 100, Currency: \"\", PaymentToken: \"t\"}},\n\t}\n\tfor _, tc := range cases {\n\t\tt.Run(tc.name, func(t *testing.T) {\n\t\t\t_, err := s.Authorize(context.Background(), tc.req)\n\t\t\twantCode(t, err, codes.InvalidArgument)\n\t\t})\n\t}\n}\n\n// ════════════════════════════════════════════════════════════════════════════\n// Capture\n//\n// \"Actually charge the held amount.\" Moves an authorization from\n// `authorized` to `captured`. Only valid against an authorization that's\n// still in `authorized` state (or already `captured`, idempotently).\n// ════════════════════════════════════════════════════════════════════════════\n\n// The straight-line path: Authorize then Capture(auth_id) succeeds with no\n// error. This is the most common flow in production — funds get held, then\n// charged.\nfunc TestCapture_Happy(t *testing.T) {\n\ts := server.NewServer()\n\tid := authOK(t, s, 100)\n\tif _, err := s.Capture(context.Background(), &pb.CaptureRequest{AuthId: id}); err != nil {\n\t\tt.Errorf(\"Capture after Authorize: %v\", err)\n\t}\n}\n\n// Idempotency on retry. A client whose Capture request times out (network\n// blip) doesn't know whether the server processed it; the safe action is\n// to retry. The second Capture on an already-captured auth must succeed\n// silently, not fail — otherwise the client is forced to distinguish\n// \"didn't capture\" from \"captured but I don't know,\" which is impossible.\nfunc TestCapture_Idempotent(t *testing.T) {\n\ts := server.NewServer()\n\tid := authOK(t, s, 100)\n\tctx := context.Background()\n\tif _, err := s.Capture(ctx, &pb.CaptureRequest{AuthId: id}); err != nil {\n\t\tt.Fatalf(\"first Capture: %v\", err)\n\t}\n\tif _, err := s.Capture(ctx, &pb.CaptureRequest{AuthId: id}); err != nil {\n\t\tt.Errorf(\"second Capture should be a no-op, got: %v\", err)\n\t}\n}\n\n// Capture against an auth_id that was never issued returns NotFound.\n// There's nothing to capture; reject cleanly.\nfunc TestCapture_NotFound(t *testing.T) {\n\ts := server.NewServer()\n\t_, err := s.Capture(context.Background(), &pb.CaptureRequest{AuthId: \"no-such-id\"})\n\twantCode(t, err, codes.NotFound)\n}\n\n// State-machine violation: an authorization that was Voided cannot be\n// Captured afterward (the hold has been released; there's nothing left to\n// charge). FailedPrecondition is the correct code per gRPC conventions —\n// the request was well-formed but the resource isn't in a state that\n// allows it.\nfunc TestCapture_AfterVoid_FailedPrecondition(t *testing.T) {\n\ts := server.NewServer()\n\tid := authOK(t, s, 100)\n\tctx := context.Background()\n\tif _, err := s.Void(ctx, &pb.VoidRequest{AuthId: id}); err != nil {\n\t\tt.Fatalf(\"Void: %v\", err)\n\t}\n\t_, err := s.Capture(ctx, &pb.CaptureRequest{AuthId: id})\n\twantCode(t, err, codes.FailedPrecondition)\n}\n\n// ════════════════════════════════════════════════════════════════════════════\n// Void\n//\n// \"Release the hold without charging.\" Moves an authorization from\n// `authorized` to `voided`. Only valid against an auth still in `authorized`\n// state (or already `voided`, idempotently).\n// ════════════════════════════════════════════════════════════════════════════\n\n// The cancel-before-charge path: Authorize then Void. Releases the hold\n// cleanly, no money moved.\nfunc TestVoid_Happy(t *testing.T) {\n\ts := server.NewServer()\n\tid := authOK(t, s, 100)\n\tif _, err := s.Void(context.Background(), &pb.VoidRequest{AuthId: id}); err != nil {\n\t\tt.Errorf(\"Void after Authorize: %v\", err)\n\t}\n}\n\n// Idempotency on retry — same reasoning as TestCapture_Idempotent: a\n// network-timeout retry must not be punished. Second Void of an\n// already-voided auth succeeds silently.\nfunc TestVoid_Idempotent(t *testing.T) {\n\ts := server.NewServer()\n\tid := authOK(t, s, 100)\n\tctx := context.Background()\n\tif _, err := s.Void(ctx, &pb.VoidRequest{AuthId: id}); err != nil {\n\t\tt.Fatalf(\"first Void: %v\", err)\n\t}\n\tif _, err := s.Void(ctx, &pb.VoidRequest{AuthId: id}); err != nil {\n\t\tt.Errorf(\"second Void should be a no-op, got: %v\", err)\n\t}\n}\n\n// Void against an unknown auth_id is NotFound, same as Capture.\nfunc TestVoid_NotFound(t *testing.T) {\n\ts := server.NewServer()\n\t_, err := s.Void(context.Background(), &pb.VoidRequest{AuthId: \"no-such-id\"})\n\twantCode(t, err, codes.NotFound)\n}\n\n// State-machine violation: once money has been captured, the auth can't be\n// \"voided\" — that's what Refund is for. FailedPrecondition signals the\n// state mismatch.\nfunc TestVoid_AfterCapture_FailedPrecondition(t *testing.T) {\n\ts := server.NewServer()\n\tid := authOK(t, s, 100)\n\tctx := context.Background()\n\tif _, err := s.Capture(ctx, &pb.CaptureRequest{AuthId: id}); err != nil {\n\t\tt.Fatalf(\"Capture: %v\", err)\n\t}\n\t_, err := s.Void(ctx, &pb.VoidRequest{AuthId: id})\n\twantCode(t, err, codes.FailedPrecondition)\n}\n\n// ════════════════════════════════════════════════════════════════════════════\n// Refund\n//\n// \"Give back some or all of a captured charge.\" Only valid against\n// `captured` authorizations, and only up to (captured_amount − already_refunded).\n// Refunds accumulate across multiple calls.\n// ════════════════════════════════════════════════════════════════════════════\n\n// Refund of less than the full captured amount: valid. The auth stays in\n// `captured` state; only the refunded counter increases.\nfunc TestRefund_Partial(t *testing.T) {\n\ts := server.NewServer()\n\tid := authOK(t, s, 100)\n\tctx := context.Background()\n\tif _, err := s.Capture(ctx, &pb.CaptureRequest{AuthId: id}); err != nil {\n\t\tt.Fatalf(\"Capture: %v\", err)\n\t}\n\tif _, err := s.Refund(ctx, &pb.RefundRequest{AuthId: id, Amount: 30}); err != nil {\n\t\tt.Errorf(\"partial Refund: %v\", err)\n\t}\n}\n\n// Refund for the full captured amount in one shot. Valid (exactly equals\n// the remaining refundable balance).\nfunc TestRefund_Full(t *testing.T) {\n\ts := server.NewServer()\n\tid := authOK(t, s, 100)\n\tctx := context.Background()\n\tif _, err := s.Capture(ctx, &pb.CaptureRequest{AuthId: id}); err != nil {\n\t\tt.Fatalf(\"Capture: %v\", err)\n\t}\n\tif _, err := s.Refund(ctx, &pb.RefundRequest{AuthId: id, Amount: 100}); err != nil {\n\t\tt.Errorf(\"full Refund: %v\", err)\n\t}\n}\n\n// Accumulation: a captured 100 minus two refunds of 30 leaves 40\n// refundable. A third refund of 50 exceeds that and must fail with\n// FailedPrecondition. This is the load-bearing test for the \"refunded so\n// far\" counter — if the implementation forgets to track it, refunds would\n// be evaluated against the original captured amount each time, and the\n// over-refund check here would erroneously pass.\nfunc TestRefund_AccumulatesAcrossCalls(t *testing.T) {\n\ts := server.NewServer()\n\tid := authOK(t, s, 100)\n\tctx := context.Background()\n\tif _, err := s.Capture(ctx, &pb.CaptureRequest{AuthId: id}); err != nil {\n\t\tt.Fatalf(\"Capture: %v\", err)\n\t}\n\t// Refund 30 + 30 = 60; remaining refundable = 40.\n\tif _, err := s.Refund(ctx, &pb.RefundRequest{AuthId: id, Amount: 30}); err != nil {\n\t\tt.Fatalf(\"first Refund: %v\", err)\n\t}\n\tif _, err := s.Refund(ctx, &pb.RefundRequest{AuthId: id, Amount: 30}); err != nil {\n\t\tt.Fatalf(\"second Refund: %v\", err)\n\t}\n\t// Third refund of 50 exceeds remaining 40 → FailedPrecondition.\n\t_, err := s.Refund(ctx, &pb.RefundRequest{AuthId: id, Amount: 50})\n\twantCode(t, err, codes.FailedPrecondition)\n}\n\n// Refund against an unknown auth_id is NotFound.\nfunc TestRefund_NotFound(t *testing.T) {\n\ts := server.NewServer()\n\t_, err := s.Refund(context.Background(), &pb.RefundRequest{AuthId: \"no-such-id\", Amount: 10})\n\twantCode(t, err, codes.NotFound)\n}\n\n// Single-call over-refund: a captured 100 cannot be refunded for 150.\n// FailedPrecondition signals the state/amount mismatch.\nfunc TestRefund_OverCapture_FailedPrecondition(t *testing.T) {\n\ts := server.NewServer()\n\tid := authOK(t, s, 100)\n\tctx := context.Background()\n\tif _, err := s.Capture(ctx, &pb.CaptureRequest{AuthId: id}); err != nil {\n\t\tt.Fatalf(\"Capture: %v\", err)\n\t}\n\t_, err := s.Refund(ctx, &pb.RefundRequest{AuthId: id, Amount: 150})\n\twantCode(t, err, codes.FailedPrecondition)\n}\n\n// Refund without a preceding Capture: the auth is in `authorized` state\n// (or even `voided`), captured_amount = 0, so any positive refund exceeds\n// the remaining (0 − 0) and returns FailedPrecondition. Covers the\n// \"refund the wrong thing\" mistake — refunds only make sense after charge.\nfunc TestRefund_WithoutCapture_FailedPrecondition(t *testing.T) {\n\ts := server.NewServer()\n\tid := authOK(t, s, 100)\n\t_, err := s.Refund(context.Background(), &pb.RefundRequest{AuthId: id, Amount: 10})\n\twantCode(t, err, codes.FailedPrecondition)\n}\n","numLines":318,"startLine":1,"totalLines":318}}}
