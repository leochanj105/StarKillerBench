{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01ARqdS51BygLai1GH5DdqL4","type":"tool_result","content":"1\t// Unit tests for payment v2: deterministic chaos & latency injection via\n2\t// reserved payment_token values.\n3\t//\n4\t// This file is the audit surface for v2's added behavior. It is kept\n5\t// separate from server_test.go (v1) so that each version's contract can\n6\t// be reviewed, kept, or rolled back in isolation. The agent must not\n7\t// modify either file.\n8\t//\n9\t// See SPEC.yaml `chaos` for the full contract these tests pin down.\n10\t\n11\tpackage server_test\n12\t\n13\timport (\n14\t\t\"context\"\n15\t\t\"testing\"\n16\t\t\"time\"\n17\t\n18\t\tpb \"agentbench/services/payment/api/v1\"\n19\t\t\"agentbench/services/payment/internal/server\"\n20\t\n21\t\t\"google.golang.org/grpc/codes\"\n22\t)\n23\t\n24\t// ════════════════════════════════════════════════════════════════════════════\n25\t// Failure tokens\n26\t// ════════════════════════════════════════════════════════════════════════════\n27\t\n28\t// tok_decline: Authorize must return FailedPrecondition AND must NOT\n29\t// allocate an auth_id (so callers can't accidentally Capture against a\n30\t// \"ghost\" auth that doesn't exist in normal state). Verifies both the\n31\t// error code and the absence of side effects.\n32\tfunc TestAuthorize_Chaos_Decline(t *testing.T) {\n33\t\ts := server.NewServer()\n34\t\tr, err := s.Authorize(context.Background(), &pb.AuthorizeRequest{\n35\t\t\tAmount: 100, Currency: \"USD\", PaymentToken: \"tok_decline\",\n36\t\t})\n37\t\twantCode(t, err, codes.FailedPrecondition)\n38\t\t// Defensive: even if the implementation returned a response struct,\n39\t\t// it must not contain a usable auth_id. A non-empty id with a non-nil\n40\t\t// error would be a contract violation (callers shouldn't reference it).\n41\t\tif r != nil && r.GetAuthId() != \"\" {\n42\t\t\tt.Errorf(\"auth_id should be empty on decline, got %q\", r.GetAuthId())\n43\t\t}\n44\t}\n45\t\n46\t// tok_capture_fail: Authorize must succeed normally and return a real\n47\t// auth_id; the failure surfaces only when Capture is called against it.\n48\t// Capture failing with FailedPrecondition AND leaving the auth in\n49\t// `authorized` state is what makes saga compensation possible — the\n50\t// booking saga responds by Voiding the auth, which must still succeed.\n51\tfunc TestCapture_Chaos_CaptureFail(t *testing.T) {\n52\t\ts := server.NewServer()\n53\t\tctx := context.Background()\n54\t\tr, err := s.Authorize(ctx, &pb.AuthorizeRequest{\n55\t\t\tAmount: 100, Currency: \"USD\", PaymentToken: \"tok_capture_fail\",\n56\t\t})\n57\t\tif err != nil {\n58\t\t\tt.Fatalf(\"Authorize(tok_capture_fail) should succeed at auth phase: %v\", err)\n59\t\t}\n60\t\tid := r.GetAuthId()\n61\t\tif id == \"\" {\n62\t\t\tt.Fatalf(\"auth_id empty\")\n63\t\t}\n64\t\t_, err = s.Capture(ctx, &pb.CaptureRequest{AuthId: id})\n65\t\twantCode(t, err, codes.FailedPrecondition)\n66\t\n67\t\t// Compensation path: after Capture chaos-fails, the auth must still be\n68\t\t// Voidable. Without this property the booking saga can't roll back\n69\t\t// cleanly, and the auth becomes orphaned in `authorized` forever.\n70\t\tif _, err := s.Void(ctx, &pb.VoidRequest{AuthId: id}); err != nil {\n71\t\t\tt.Errorf(\"Void after chaos Capture failure: %v\", err)\n72\t\t}\n73\t}\n74\t\n75\t// tok_capture_fail must be deterministic, not flaky: retrying Capture\n76\t// after the first failure must fail the same way. Without this, the\n77\t// failure mode would only catch a saga's first attempt and miss the\n78\t// retry-loop case.\n79\tfunc TestCapture_Chaos_CaptureFail_Deterministic(t *testing.T) {\n80\t\ts := server.NewServer()\n81\t\tctx := context.Background()\n82\t\tr, _ := s.Authorize(ctx, &pb.AuthorizeRequest{\n83\t\t\tAmount: 100, Currency: \"USD\", PaymentToken: \"tok_capture_fail\",\n84\t\t})\n85\t\tid := r.GetAuthId()\n86\t\t_, err1 := s.Capture(ctx, &pb.CaptureRequest{AuthId: id})\n87\t\t_, err2 := s.Capture(ctx, &pb.CaptureRequest{AuthId: id})\n88\t\twantCode(t, err1, codes.FailedPrecondition)\n89\t\twantCode(t, err2, codes.FailedPrecondition)\n90\t}\n91\t\n92\t// tok_refund_fail: Authorize and Capture succeed normally; Refund fails\n93\t// deterministically. Multiple refund attempts (different amounts, retries)\n94\t// must all fail, mirroring a PSP that has flagged the auth as\n95\t// refund-blocked.\n96\tfunc TestRefund_Chaos_RefundFail(t *testing.T) {\n97\t\ts := server.NewServer()\n98\t\tctx := context.Background()\n99\t\tr, err := s.Authorize(ctx, &pb.AuthorizeRequest{\n100\t\t\tAmount: 100, Currency: \"USD\", PaymentToken: \"tok_refund_fail\",\n101\t\t})\n102\t\tif err != nil {\n103\t\t\tt.Fatalf(\"Authorize(tok_refund_fail): %v\", err)\n104\t\t}\n105\t\tid := r.GetAuthId()\n106\t\tif _, err := s.Capture(ctx, &pb.CaptureRequest{AuthId: id}); err != nil {\n107\t\t\tt.Fatalf(\"Capture(tok_refund_fail) should succeed: %v\", err)\n108\t\t}\n109\t\n110\t\t// First refund: chaos-failed.\n111\t\t_, err = s.Refund(ctx, &pb.RefundRequest{AuthId: id, Amount: 30})\n112\t\twantCode(t, err, codes.FailedPrecondition)\n113\t\n114\t\t// Different amount, still chaos-failed.\n115\t\t_, err = s.Refund(ctx, &pb.RefundRequest{AuthId: id, Amount: 100})\n116\t\twantCode(t, err, codes.FailedPrecondition)\n117\t}\n118\t\n119\t// ════════════════════════════════════════════════════════════════════════════\n120\t// Latency tokens\n121\t// ════════════════════════════════════════════════════════════════════════════\n122\t\n123\t// tok_slow_<ms>: Authorize must sleep at least the declared duration\n124\t// before returning success. Generous slack (50ms tolerance) keeps the\n125\t// test stable under scheduler jitter; the meaningful assertion is the\n126\t// lower bound. We use a small duration (60ms) to keep the test fast.\n127\tfunc TestAuthorize_Chaos_Latency(t *testing.T) {\n128\t\ts := server.NewServer()\n129\t\tstart := time.Now()\n130\t\tr, err := s.Authorize(context.Background(), &pb.AuthorizeRequest{\n131\t\t\tAmount: 100, Currency: \"USD\", PaymentToken: \"tok_slow_60\",\n132\t\t})\n133\t\telapsed := time.Since(start)\n134\t\tif err != nil {\n135\t\t\tt.Fatalf(\"Authorize(tok_slow_60): %v\", err)\n136\t\t}\n137\t\tif r.GetAuthId() == \"\" {\n138\t\t\tt.Errorf(\"auth_id empty after latency injection\")\n139\t\t}\n140\t\tif elapsed < 60*time.Millisecond {\n141\t\t\tt.Errorf(\"Authorize returned in %v, want at least 60ms\", elapsed)\n142\t\t}\n143\t}\n144\t\n145\t// A malformed slow token must NOT crash and must NOT sleep — it falls\n146\t// back to ordinary token behavior (success, normal latency). Locks in\n147\t// the SPEC's \"malformed suffix is treated as ordinary\" rule and catches\n148\t// implementations that panic on Atoi failure.\n149\tfunc TestAuthorize_Chaos_Latency_Malformed(t *testing.T) {\n150\t\ts := server.NewServer()\n151\t\tstart := time.Now()\n152\t\tr, err := s.Authorize(context.Background(), &pb.AuthorizeRequest{\n153\t\t\tAmount: 100, Currency: \"USD\", PaymentToken: \"tok_slow_notanint\",\n154\t\t})\n155\t\telapsed := time.Since(start)\n156\t\tif err != nil {\n157\t\t\tt.Errorf(\"malformed slow token should behave as ordinary token, got error: %v\", err)\n158\t\t}\n159\t\tif r.GetAuthId() == \"\" {\n160\t\t\tt.Errorf(\"auth_id empty on malformed slow token\")\n161\t\t}\n162\t\t// Generous upper bound: a real ordinary Authorize should be sub-ms.\n163\t\tif elapsed > 50*time.Millisecond {\n164\t\t\tt.Errorf(\"malformed slow token introduced latency %v, expected ~zero\", elapsed)\n165\t\t}\n166\t}\n167\t"}]},"parent_tool_use_id":null,"session_id":"0365300d-3943-470d-ade0-b491d9df15dc","uuid":"f878dc6e-f78c-405d-88cc-e77b1cb32746","timestamp":"2026-05-28T23:58:15.553Z","tool_use_result":{"type":"text","file":{"filePath":"/home/leochanj/Desktop/agentbench/services/payment/internal/server/server_v2_test.go","content":"// Unit tests for payment v2: deterministic chaos & latency injection via\n// reserved payment_token values.\n//\n// This file is the audit surface for v2's added behavior. It is kept\n// separate from server_test.go (v1) so that each version's contract can\n// be reviewed, kept, or rolled back in isolation. The agent must not\n// modify either file.\n//\n// See SPEC.yaml `chaos` for the full contract these tests pin down.\n\npackage server_test\n\nimport (\n\t\"context\"\n\t\"testing\"\n\t\"time\"\n\n\tpb \"agentbench/services/payment/api/v1\"\n\t\"agentbench/services/payment/internal/server\"\n\n\t\"google.golang.org/grpc/codes\"\n)\n\n// ════════════════════════════════════════════════════════════════════════════\n// Failure tokens\n// ════════════════════════════════════════════════════════════════════════════\n\n// tok_decline: Authorize must return FailedPrecondition AND must NOT\n// allocate an auth_id (so callers can't accidentally Capture against a\n// \"ghost\" auth that doesn't exist in normal state). Verifies both the\n// error code and the absence of side effects.\nfunc TestAuthorize_Chaos_Decline(t *testing.T) {\n\ts := server.NewServer()\n\tr, err := s.Authorize(context.Background(), &pb.AuthorizeRequest{\n\t\tAmount: 100, Currency: \"USD\", PaymentToken: \"tok_decline\",\n\t})\n\twantCode(t, err, codes.FailedPrecondition)\n\t// Defensive: even if the implementation returned a response struct,\n\t// it must not contain a usable auth_id. A non-empty id with a non-nil\n\t// error would be a contract violation (callers shouldn't reference it).\n\tif r != nil && r.GetAuthId() != \"\" {\n\t\tt.Errorf(\"auth_id should be empty on decline, got %q\", r.GetAuthId())\n\t}\n}\n\n// tok_capture_fail: Authorize must succeed normally and return a real\n// auth_id; the failure surfaces only when Capture is called against it.\n// Capture failing with FailedPrecondition AND leaving the auth in\n// `authorized` state is what makes saga compensation possible — the\n// booking saga responds by Voiding the auth, which must still succeed.\nfunc TestCapture_Chaos_CaptureFail(t *testing.T) {\n\ts := server.NewServer()\n\tctx := context.Background()\n\tr, err := s.Authorize(ctx, &pb.AuthorizeRequest{\n\t\tAmount: 100, Currency: \"USD\", PaymentToken: \"tok_capture_fail\",\n\t})\n\tif err != nil {\n\t\tt.Fatalf(\"Authorize(tok_capture_fail) should succeed at auth phase: %v\", err)\n\t}\n\tid := r.GetAuthId()\n\tif id == \"\" {\n\t\tt.Fatalf(\"auth_id empty\")\n\t}\n\t_, err = s.Capture(ctx, &pb.CaptureRequest{AuthId: id})\n\twantCode(t, err, codes.FailedPrecondition)\n\n\t// Compensation path: after Capture chaos-fails, the auth must still be\n\t// Voidable. Without this property the booking saga can't roll back\n\t// cleanly, and the auth becomes orphaned in `authorized` forever.\n\tif _, err := s.Void(ctx, &pb.VoidRequest{AuthId: id}); err != nil {\n\t\tt.Errorf(\"Void after chaos Capture failure: %v\", err)\n\t}\n}\n\n// tok_capture_fail must be deterministic, not flaky: retrying Capture\n// after the first failure must fail the same way. Without this, the\n// failure mode would only catch a saga's first attempt and miss the\n// retry-loop case.\nfunc TestCapture_Chaos_CaptureFail_Deterministic(t *testing.T) {\n\ts := server.NewServer()\n\tctx := context.Background()\n\tr, _ := s.Authorize(ctx, &pb.AuthorizeRequest{\n\t\tAmount: 100, Currency: \"USD\", PaymentToken: \"tok_capture_fail\",\n\t})\n\tid := r.GetAuthId()\n\t_, err1 := s.Capture(ctx, &pb.CaptureRequest{AuthId: id})\n\t_, err2 := s.Capture(ctx, &pb.CaptureRequest{AuthId: id})\n\twantCode(t, err1, codes.FailedPrecondition)\n\twantCode(t, err2, codes.FailedPrecondition)\n}\n\n// tok_refund_fail: Authorize and Capture succeed normally; Refund fails\n// deterministically. Multiple refund attempts (different amounts, retries)\n// must all fail, mirroring a PSP that has flagged the auth as\n// refund-blocked.\nfunc TestRefund_Chaos_RefundFail(t *testing.T) {\n\ts := server.NewServer()\n\tctx := context.Background()\n\tr, err := s.Authorize(ctx, &pb.AuthorizeRequest{\n\t\tAmount: 100, Currency: \"USD\", PaymentToken: \"tok_refund_fail\",\n\t})\n\tif err != nil {\n\t\tt.Fatalf(\"Authorize(tok_refund_fail): %v\", err)\n\t}\n\tid := r.GetAuthId()\n\tif _, err := s.Capture(ctx, &pb.CaptureRequest{AuthId: id}); err != nil {\n\t\tt.Fatalf(\"Capture(tok_refund_fail) should succeed: %v\", err)\n\t}\n\n\t// First refund: chaos-failed.\n\t_, err = s.Refund(ctx, &pb.RefundRequest{AuthId: id, Amount: 30})\n\twantCode(t, err, codes.FailedPrecondition)\n\n\t// Different amount, still chaos-failed.\n\t_, err = s.Refund(ctx, &pb.RefundRequest{AuthId: id, Amount: 100})\n\twantCode(t, err, codes.FailedPrecondition)\n}\n\n// ════════════════════════════════════════════════════════════════════════════\n// Latency tokens\n// ════════════════════════════════════════════════════════════════════════════\n\n// tok_slow_<ms>: Authorize must sleep at least the declared duration\n// before returning success. Generous slack (50ms tolerance) keeps the\n// test stable under scheduler jitter; the meaningful assertion is the\n// lower bound. We use a small duration (60ms) to keep the test fast.\nfunc TestAuthorize_Chaos_Latency(t *testing.T) {\n\ts := server.NewServer()\n\tstart := time.Now()\n\tr, err := s.Authorize(context.Background(), &pb.AuthorizeRequest{\n\t\tAmount: 100, Currency: \"USD\", PaymentToken: \"tok_slow_60\",\n\t})\n\telapsed := time.Since(start)\n\tif err != nil {\n\t\tt.Fatalf(\"Authorize(tok_slow_60): %v\", err)\n\t}\n\tif r.GetAuthId() == \"\" {\n\t\tt.Errorf(\"auth_id empty after latency injection\")\n\t}\n\tif elapsed < 60*time.Millisecond {\n\t\tt.Errorf(\"Authorize returned in %v, want at least 60ms\", elapsed)\n\t}\n}\n\n// A malformed slow token must NOT crash and must NOT sleep — it falls\n// back to ordinary token behavior (success, normal latency). Locks in\n// the SPEC's \"malformed suffix is treated as ordinary\" rule and catches\n// implementations that panic on Atoi failure.\nfunc TestAuthorize_Chaos_Latency_Malformed(t *testing.T) {\n\ts := server.NewServer()\n\tstart := time.Now()\n\tr, err := s.Authorize(context.Background(), &pb.AuthorizeRequest{\n\t\tAmount: 100, Currency: \"USD\", PaymentToken: \"tok_slow_notanint\",\n\t})\n\telapsed := time.Since(start)\n\tif err != nil {\n\t\tt.Errorf(\"malformed slow token should behave as ordinary token, got error: %v\", err)\n\t}\n\tif r.GetAuthId() == \"\" {\n\t\tt.Errorf(\"auth_id empty on malformed slow token\")\n\t}\n\t// Generous upper bound: a real ordinary Authorize should be sub-ms.\n\tif elapsed > 50*time.Millisecond {\n\t\tt.Errorf(\"malformed slow token introduced latency %v, expected ~zero\", elapsed)\n\t}\n}\n","numLines":167,"startLine":1,"totalLines":167}}}
