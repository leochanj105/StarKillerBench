{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01CLCTRvdhQjnFtxx4yUixRR","type":"tool_result","content":"1\t// Unit tests for ads, derived from SPEC.yaml.\n2\t//\n3\t// What this service is:\n4\t//   ads runs a second-price auction over advertiser campaigns. SetCampaign\n5\t//   seeds a (bid, daily_budget) for a hotel; SelectSponsored fills slots with\n6\t//   the highest bidders, each charged the next-lower bid (or its own bid as\n7\t//   the lowest/only bidder), deducting from budget. v1 is in-memory.\n8\t//\n9\t// Test contract assumed about the implementation:\n10\t//   - `server.NewServer()` returns a *Server implementing pb.AdsServiceServer.\n11\t//   - Standard gRPC signatures; errors via google.golang.org/grpc/status with\n12\t//     the codes in SPEC.error_semantics.\n13\t//\n14\t// Bids are kept distinct in these tests so the ranking is unambiguous.\n15\t//\n16\t// Authored out-of-band and audited before the agent implements. The agent\n17\t// must not modify this file.\n18\t\n19\tpackage server_test\n20\t\n21\timport (\n22\t\t\"context\"\n23\t\t\"testing\"\n24\t\n25\t\tpb \"agentbench/services/ads/api/v1\"\n26\t\t\"agentbench/services/ads/internal/server\"\n27\t\n28\t\t\"google.golang.org/grpc/codes\"\n29\t\t\"google.golang.org/grpc/status\"\n30\t)\n31\t\n32\tfunc setCampaignOK(t *testing.T, s pb.AdsServiceServer, adv, hotel string, budget, bid int64) {\n33\t\tt.Helper()\n34\t\tr, err := s.SetCampaign(context.Background(), &pb.SetCampaignRequest{\n35\t\t\tAdvertiserId: adv, HotelId: hotel, DailyBudget: budget, Bid: bid,\n36\t\t})\n37\t\tif err != nil {\n38\t\t\tt.Fatalf(\"SetCampaign(%s): %v\", hotel, err)\n39\t\t}\n40\t\tif r.GetCampaignId() == \"\" {\n41\t\t\tt.Fatalf(\"SetCampaign returned empty campaign_id\")\n42\t\t}\n43\t}\n44\t\n45\tfunc selectSponsored(t *testing.T, s pb.AdsServiceServer, slots int32) []*pb.SponsoredSlot {\n46\t\tt.Helper()\n47\t\tr, err := s.SelectSponsored(context.Background(), &pb.SelectSponsoredRequest{SlotCount: slots})\n48\t\tif err != nil {\n49\t\t\tt.Fatalf(\"SelectSponsored(%d): %v\", slots, err)\n50\t\t}\n51\t\treturn r.GetSlots()\n52\t}\n53\t\n54\tfunc wantCode(t *testing.T, err error, want codes.Code) {\n55\t\tt.Helper()\n56\t\tif got := status.Code(err); got != want {\n57\t\t\tt.Errorf(\"status code = %v, want %v (err=%v)\", got, want, err)\n58\t\t}\n59\t}\n60\t\n61\t// ════════════════════════════════════════════════════════════════════════════\n62\t// Second-price auction\n63\t// ════════════════════════════════════════════════════════════════════════════\n64\t\n65\t// Three bidders A(100) B(80) C(60); two slots. Winners are A and B, ordered\n66\t// by bid descending. A pays B's bid (80); B pays C's bid (60) — the next-lower\n67\t// bid sets the price even though C wins no slot.\n68\tfunc TestSelectSponsored_SecondPrice(t *testing.T) {\n69\t\ts := server.NewServer()\n70\t\tsetCampaignOK(t, s, \"adv\", \"HA\", 100000, 100)\n71\t\tsetCampaignOK(t, s, \"adv\", \"HB\", 100000, 80)\n72\t\tsetCampaignOK(t, s, \"adv\", \"HC\", 100000, 60)\n73\t\n74\t\tslots := selectSponsored(t, s, 2)\n75\t\tif len(slots) != 2 {\n76\t\t\tt.Fatalf(\"slots = %d, want 2\", len(slots))\n77\t\t}\n78\t\tif slots[0].GetHotelId() != \"HA\" || slots[0].GetPrice() != 80 {\n79\t\t\tt.Errorf(\"slot0 = (%s, %d), want (HA, 80)\", slots[0].GetHotelId(), slots[0].GetPrice())\n80\t\t}\n81\t\tif slots[1].GetHotelId() != \"HB\" || slots[1].GetPrice() != 60 {\n82\t\t\tt.Errorf(\"slot1 = (%s, %d), want (HB, 60)\", slots[1].GetHotelId(), slots[1].GetPrice())\n83\t\t}\n84\t}\n85\t\n86\t// slot_count limits the number of winners: with one slot, only the top bidder\n87\t// is returned (priced at the next-lower bid).\n88\tfunc TestSelectSponsored_SlotCountLimits(t *testing.T) {\n89\t\ts := server.NewServer()\n90\t\tsetCampaignOK(t, s, \"adv\", \"HA\", 100000, 100)\n91\t\tsetCampaignOK(t, s, \"adv\", \"HB\", 100000, 80)\n92\t\tsetCampaignOK(t, s, \"adv\", \"HC\", 100000, 60)\n93\t\n94\t\tslots := selectSponsored(t, s, 1)\n95\t\tif len(slots) != 1 || slots[0].GetHotelId() != \"HA\" || slots[0].GetPrice() != 80 {\n96\t\t\tt.Errorf(\"slots = %+v, want one (HA, 80)\", slots)\n97\t\t}\n98\t}\n99\t\n100\t// A lone bidder pays its own bid (first-price fallback), and the budget is\n101\t// spent down: A bids 100 with budget 150. First select charges 100 (budget\n102\t// → 50); the second select finds A can't afford 100 and returns nothing.\n103\tfunc TestSelectSponsored_BudgetExhaustion(t *testing.T) {\n104\t\ts := server.NewServer()\n105\t\tsetCampaignOK(t, s, \"adv\", \"HA\", 150, 100)\n106\t\n107\t\tfirst := selectSponsored(t, s, 1)\n108\t\tif len(first) != 1 || first[0].GetPrice() != 100 {\n109\t\t\tt.Fatalf(\"first select = %+v, want one priced 100 (first-price fallback)\", first)\n110\t\t}\n111\t\tsecond := selectSponsored(t, s, 1)\n112\t\tif len(second) != 0 {\n113\t\t\tt.Errorf(\"second select = %+v, want empty (budget exhausted)\", second)\n114\t\t}\n115\t}\n116\t\n117\t// No campaigns → empty slots, not an error.\n118\tfunc TestSelectSponsored_NoneEligible(t *testing.T) {\n119\t\ts := server.NewServer()\n120\t\tif slots := selectSponsored(t, s, 3); len(slots) != 0 {\n121\t\t\tt.Errorf(\"slots = %+v, want empty\", slots)\n122\t\t}\n123\t}\n124\t\n125\t// slot_count must be positive.\n126\tfunc TestSelectSponsored_InvalidSlotCount(t *testing.T) {\n127\t\ts := server.NewServer()\n128\t\t_, err := s.SelectSponsored(context.Background(), &pb.SelectSponsoredRequest{SlotCount: 0})\n129\t\twantCode(t, err, codes.InvalidArgument)\n130\t}\n131\t\n132\t// ════════════════════════════════════════════════════════════════════════════\n133\t// SetCampaign / logging\n134\t// ════════════════════════════════════════════════════════════════════════════\n135\t\n136\t// SetCampaign rejects empty ids and non-positive budget/bid.\n137\tfunc TestSetCampaign_Invalid(t *testing.T) {\n138\t\ts := server.NewServer()\n139\t\tcases := []*pb.SetCampaignRequest{\n140\t\t\t{AdvertiserId: \"\", HotelId: \"H\", DailyBudget: 100, Bid: 10},\n141\t\t\t{AdvertiserId: \"a\", HotelId: \"\", DailyBudget: 100, Bid: 10},\n142\t\t\t{AdvertiserId: \"a\", HotelId: \"H\", DailyBudget: 0, Bid: 10},\n143\t\t\t{AdvertiserId: \"a\", HotelId: \"H\", DailyBudget: 100, Bid: 0},\n144\t\t}\n145\t\tfor _, req := range cases {\n146\t\t\t_, err := s.SetCampaign(context.Background(), req)\n147\t\t\twantCode(t, err, codes.InvalidArgument)\n148\t\t}\n149\t}\n150\t\n151\t// LogImpression / LogClick acknowledge valid calls and reject an empty\n152\t// hotel_id.\n153\tfunc TestLogging(t *testing.T) {\n154\t\ts := server.NewServer()\n155\t\tctx := context.Background()\n156\t\tif _, err := s.LogImpression(ctx, &pb.LogImpressionRequest{HotelId: \"HA\", QueryId: \"q1\"}); err != nil {\n157\t\t\tt.Errorf(\"LogImpression: %v\", err)\n158\t\t}\n159\t\tif _, err := s.LogClick(ctx, &pb.LogClickRequest{HotelId: \"HA\", QueryId: \"q1\"}); err != nil {\n160\t\t\tt.Errorf(\"LogClick: %v\", err)\n161\t\t}\n162\t\t_, err := s.LogImpression(ctx, &pb.LogImpressionRequest{HotelId: \"\", QueryId: \"q1\"})\n163\t\twantCode(t, err, codes.InvalidArgument)\n164\t\t_, err = s.LogClick(ctx, &pb.LogClickRequest{HotelId: \"\", QueryId: \"q1\"})\n165\t\twantCode(t, err, codes.InvalidArgument)\n166\t}\n167\t"}]},"parent_tool_use_id":null,"session_id":"929a2138-1984-43c7-902e-03765cad563d","uuid":"f14b3f80-747f-418c-8f38-a7a4fdf06f91","timestamp":"2026-06-08T05:51:10.764Z","tool_use_result":{"type":"text","file":{"filePath":"/home/leochanj/Desktop/agentbench/services/ads/internal/server/server_test.go","content":"// Unit tests for ads, derived from SPEC.yaml.\n//\n// What this service is:\n//   ads runs a second-price auction over advertiser campaigns. SetCampaign\n//   seeds a (bid, daily_budget) for a hotel; SelectSponsored fills slots with\n//   the highest bidders, each charged the next-lower bid (or its own bid as\n//   the lowest/only bidder), deducting from budget. v1 is in-memory.\n//\n// Test contract assumed about the implementation:\n//   - `server.NewServer()` returns a *Server implementing pb.AdsServiceServer.\n//   - Standard gRPC signatures; errors via google.golang.org/grpc/status with\n//     the codes in SPEC.error_semantics.\n//\n// Bids are kept distinct in these tests so the ranking is unambiguous.\n//\n// Authored out-of-band and audited before the agent implements. The agent\n// must not modify this file.\n\npackage server_test\n\nimport (\n\t\"context\"\n\t\"testing\"\n\n\tpb \"agentbench/services/ads/api/v1\"\n\t\"agentbench/services/ads/internal/server\"\n\n\t\"google.golang.org/grpc/codes\"\n\t\"google.golang.org/grpc/status\"\n)\n\nfunc setCampaignOK(t *testing.T, s pb.AdsServiceServer, adv, hotel string, budget, bid int64) {\n\tt.Helper()\n\tr, err := s.SetCampaign(context.Background(), &pb.SetCampaignRequest{\n\t\tAdvertiserId: adv, HotelId: hotel, DailyBudget: budget, Bid: bid,\n\t})\n\tif err != nil {\n\t\tt.Fatalf(\"SetCampaign(%s): %v\", hotel, err)\n\t}\n\tif r.GetCampaignId() == \"\" {\n\t\tt.Fatalf(\"SetCampaign returned empty campaign_id\")\n\t}\n}\n\nfunc selectSponsored(t *testing.T, s pb.AdsServiceServer, slots int32) []*pb.SponsoredSlot {\n\tt.Helper()\n\tr, err := s.SelectSponsored(context.Background(), &pb.SelectSponsoredRequest{SlotCount: slots})\n\tif err != nil {\n\t\tt.Fatalf(\"SelectSponsored(%d): %v\", slots, err)\n\t}\n\treturn r.GetSlots()\n}\n\nfunc wantCode(t *testing.T, err error, want codes.Code) {\n\tt.Helper()\n\tif got := status.Code(err); got != want {\n\t\tt.Errorf(\"status code = %v, want %v (err=%v)\", got, want, err)\n\t}\n}\n\n// ════════════════════════════════════════════════════════════════════════════\n// Second-price auction\n// ════════════════════════════════════════════════════════════════════════════\n\n// Three bidders A(100) B(80) C(60); two slots. Winners are A and B, ordered\n// by bid descending. A pays B's bid (80); B pays C's bid (60) — the next-lower\n// bid sets the price even though C wins no slot.\nfunc TestSelectSponsored_SecondPrice(t *testing.T) {\n\ts := server.NewServer()\n\tsetCampaignOK(t, s, \"adv\", \"HA\", 100000, 100)\n\tsetCampaignOK(t, s, \"adv\", \"HB\", 100000, 80)\n\tsetCampaignOK(t, s, \"adv\", \"HC\", 100000, 60)\n\n\tslots := selectSponsored(t, s, 2)\n\tif len(slots) != 2 {\n\t\tt.Fatalf(\"slots = %d, want 2\", len(slots))\n\t}\n\tif slots[0].GetHotelId() != \"HA\" || slots[0].GetPrice() != 80 {\n\t\tt.Errorf(\"slot0 = (%s, %d), want (HA, 80)\", slots[0].GetHotelId(), slots[0].GetPrice())\n\t}\n\tif slots[1].GetHotelId() != \"HB\" || slots[1].GetPrice() != 60 {\n\t\tt.Errorf(\"slot1 = (%s, %d), want (HB, 60)\", slots[1].GetHotelId(), slots[1].GetPrice())\n\t}\n}\n\n// slot_count limits the number of winners: with one slot, only the top bidder\n// is returned (priced at the next-lower bid).\nfunc TestSelectSponsored_SlotCountLimits(t *testing.T) {\n\ts := server.NewServer()\n\tsetCampaignOK(t, s, \"adv\", \"HA\", 100000, 100)\n\tsetCampaignOK(t, s, \"adv\", \"HB\", 100000, 80)\n\tsetCampaignOK(t, s, \"adv\", \"HC\", 100000, 60)\n\n\tslots := selectSponsored(t, s, 1)\n\tif len(slots) != 1 || slots[0].GetHotelId() != \"HA\" || slots[0].GetPrice() != 80 {\n\t\tt.Errorf(\"slots = %+v, want one (HA, 80)\", slots)\n\t}\n}\n\n// A lone bidder pays its own bid (first-price fallback), and the budget is\n// spent down: A bids 100 with budget 150. First select charges 100 (budget\n// → 50); the second select finds A can't afford 100 and returns nothing.\nfunc TestSelectSponsored_BudgetExhaustion(t *testing.T) {\n\ts := server.NewServer()\n\tsetCampaignOK(t, s, \"adv\", \"HA\", 150, 100)\n\n\tfirst := selectSponsored(t, s, 1)\n\tif len(first) != 1 || first[0].GetPrice() != 100 {\n\t\tt.Fatalf(\"first select = %+v, want one priced 100 (first-price fallback)\", first)\n\t}\n\tsecond := selectSponsored(t, s, 1)\n\tif len(second) != 0 {\n\t\tt.Errorf(\"second select = %+v, want empty (budget exhausted)\", second)\n\t}\n}\n\n// No campaigns → empty slots, not an error.\nfunc TestSelectSponsored_NoneEligible(t *testing.T) {\n\ts := server.NewServer()\n\tif slots := selectSponsored(t, s, 3); len(slots) != 0 {\n\t\tt.Errorf(\"slots = %+v, want empty\", slots)\n\t}\n}\n\n// slot_count must be positive.\nfunc TestSelectSponsored_InvalidSlotCount(t *testing.T) {\n\ts := server.NewServer()\n\t_, err := s.SelectSponsored(context.Background(), &pb.SelectSponsoredRequest{SlotCount: 0})\n\twantCode(t, err, codes.InvalidArgument)\n}\n\n// ════════════════════════════════════════════════════════════════════════════\n// SetCampaign / logging\n// ════════════════════════════════════════════════════════════════════════════\n\n// SetCampaign rejects empty ids and non-positive budget/bid.\nfunc TestSetCampaign_Invalid(t *testing.T) {\n\ts := server.NewServer()\n\tcases := []*pb.SetCampaignRequest{\n\t\t{AdvertiserId: \"\", HotelId: \"H\", DailyBudget: 100, Bid: 10},\n\t\t{AdvertiserId: \"a\", HotelId: \"\", DailyBudget: 100, Bid: 10},\n\t\t{AdvertiserId: \"a\", HotelId: \"H\", DailyBudget: 0, Bid: 10},\n\t\t{AdvertiserId: \"a\", HotelId: \"H\", DailyBudget: 100, Bid: 0},\n\t}\n\tfor _, req := range cases {\n\t\t_, err := s.SetCampaign(context.Background(), req)\n\t\twantCode(t, err, codes.InvalidArgument)\n\t}\n}\n\n// LogImpression / LogClick acknowledge valid calls and reject an empty\n// hotel_id.\nfunc TestLogging(t *testing.T) {\n\ts := server.NewServer()\n\tctx := context.Background()\n\tif _, err := s.LogImpression(ctx, &pb.LogImpressionRequest{HotelId: \"HA\", QueryId: \"q1\"}); err != nil {\n\t\tt.Errorf(\"LogImpression: %v\", err)\n\t}\n\tif _, err := s.LogClick(ctx, &pb.LogClickRequest{HotelId: \"HA\", QueryId: \"q1\"}); err != nil {\n\t\tt.Errorf(\"LogClick: %v\", err)\n\t}\n\t_, err := s.LogImpression(ctx, &pb.LogImpressionRequest{HotelId: \"\", QueryId: \"q1\"})\n\twantCode(t, err, codes.InvalidArgument)\n\t_, err = s.LogClick(ctx, &pb.LogClickRequest{HotelId: \"\", QueryId: \"q1\"})\n\twantCode(t, err, codes.InvalidArgument)\n}\n","numLines":167,"startLine":1,"totalLines":167}}}
