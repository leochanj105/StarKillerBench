4 price = 3;\n}\n\nmessage LogImpressionRequest {\n  string hotel_id = 1;\n  string query_id = 2;\n}\n\nmessage LogImpressionResponse {}\n\nmessage LogClickRequest {\n  string hotel_id = 1;\n  string query_id = 2;\n}\n\nmessage LogClickResponse {}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
