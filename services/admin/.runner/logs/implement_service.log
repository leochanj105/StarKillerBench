{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0116oiv2BFUb5XfjmFmwFiCD","type":"tool_result","content":"1\t// Unit tests for admin, derived from SPEC.yaml.\n2\t//\n3\t// What this service is:\n4\t//   admin is a stateless hotelier-facing proxy. Each RPC validates input and\n5\t//   forwards to the owning service (geo, profile, inventory, pricing, ads).\n6\t//\n7\t// Test contract assumed about the implementation:\n8\t//   - `server.NewServer(geo, profile, inventory, pricing, ads)` returns a\n9\t//     *Server where the five args implement the gRPC-generated *ServiceClient\n10\t//     interfaces. Tests inject mocks that record calls.\n11\t//   - Standard gRPC signatures; errors via status.Error with the codes in\n12\t//     SPEC.error_semantics; upstream errors are propagated.\n13\t//\n14\t// Authored out-of-band and audited before the agent implements. The agent\n15\t// must not modify this file.\n16\t\n17\tpackage server_test\n18\t\n19\timport (\n20\t\t\"context\"\n21\t\t\"testing\"\n22\t\n23\t\tadspb \"agentbench/services/ads/api/v1\"\n24\t\tpb \"agentbench/services/admin/api/v1\"\n25\t\t\"agentbench/services/admin/internal/server\"\n26\t\tgeopb \"agentbench/services/geo/api/v1\"\n27\t\tinventorypb \"agentbench/services/inventory/api/v1\"\n28\t\tpricingpb \"agentbench/services/pricing/api/v1\"\n29\t\tprofilepb \"agentbench/services/profile/api/v1\"\n30\t\n31\t\t\"google.golang.org/grpc\"\n32\t\t\"google.golang.org/grpc/codes\"\n33\t\t\"google.golang.org/grpc/status\"\n34\t)\n35\t\n36\t// ─── Mocks: each records the one method admin uses; the rest are Unimplemented.\n37\t\n38\ttype mockGeo struct {\n39\t\tUpsertFn     func(*geopb.UpsertHotelRequest) (*geopb.UpsertHotelResponse, error)\n40\t\tUpsertCalls  []*geopb.UpsertHotelRequest\n41\t}\n42\t\n43\tfunc (m *mockGeo) UpsertHotel(ctx context.Context, in *geopb.UpsertHotelRequest, opts ...grpc.CallOption) (*geopb.UpsertHotelResponse, error) {\n44\t\tm.UpsertCalls = append(m.UpsertCalls, in)\n45\t\tif m.UpsertFn != nil {\n46\t\t\treturn m.UpsertFn(in)\n47\t\t}\n48\t\treturn &geopb.UpsertHotelResponse{}, nil\n49\t}\n50\tfunc (m *mockGeo) Nearby(ctx context.Context, in *geopb.NearbyRequest, opts ...grpc.CallOption) (*geopb.NearbyResponse, error) {\n51\t\treturn nil, status.Error(codes.Unimplemented, \"not mocked\")\n52\t}\n53\t\n54\ttype mockProfile struct {\n55\t\tUpsertFn    func(*profilepb.UpsertProfileRequest) (*profilepb.UpsertProfileResponse, error)\n56\t\tUpsertCalls []*profilepb.UpsertProfileRequest\n57\t}\n58\t\n59\tfunc (m *mockProfile) UpsertProfile(ctx context.Context, in *profilepb.UpsertProfileRequest, opts ...grpc.CallOption) (*profilepb.UpsertProfileResponse, error) {\n60\t\tm.UpsertCalls = append(m.UpsertCalls, in)\n61\t\tif m.UpsertFn != nil {\n62\t\t\treturn m.UpsertFn(in)\n63\t\t}\n64\t\treturn &profilepb.UpsertProfileResponse{}, nil\n65\t}\n66\tfunc (m *mockProfile) GetProfile(ctx context.Context, in *profilepb.GetProfileRequest, opts ...grpc.CallOption) (*profilepb.GetProfileResponse, error) {\n67\t\treturn nil, status.Error(codes.Unimplemented, \"not mocked\")\n68\t}\n69\t\n70\ttype mockInventory struct {\n71\t\tSetStockFn    func(*inventorypb.SetStockRequest) (*inventorypb.SetStockResponse, error)\n72\t\tSetStockCalls []*inventorypb.SetStockRequest\n73\t}\n74\t\n75\tfunc (m *mockInventory) SetStock(ctx context.Context, in *inventorypb.SetStockRequest, opts ...grpc.CallOption) (*inventorypb.SetStockResponse, error) {\n76\t\tm.SetStockCalls = append(m.SetStockCalls, in)\n77\t\tif m.SetStockFn != nil {\n78\t\t\treturn m.SetStockFn(in)\n79\t\t}\n80\t\treturn &inventorypb.SetStockResponse{}, nil\n81\t}\n82\tfunc (m *mockInventory) Hold(ctx context.Context, in *inventorypb.HoldRequest, opts ...grpc.CallOption) (*inventorypb.HoldResponse, error) {\n83\t\treturn nil, status.Error(codes.Unimplemented, \"not mocked\")\n84\t}\n85\tfunc (m *mockInventory) Commit(ctx context.Context, in *inventorypb.CommitRequest, opts ...grpc.CallOption) (*inventorypb.CommitResponse, error) {\n86\t\treturn nil, status.Error(codes.Unimplemented, \"not mocked\")\n87\t}\n88\tfunc (m *mockInventory) Release(ctx context.Context, in *inventorypb.ReleaseRequest, opts ...grpc.CallOption) (*inventorypb.ReleaseResponse, error) {\n89\t\treturn nil, status.Error(codes.Unimplemented, \"not mocked\")\n90\t}\n91\tfunc (m *mockInventory) ReturnStock(ctx context.Context, in *inventorypb.ReturnStockRequest, opts ...grpc.CallOption) (*inventorypb.ReturnStockResponse, error) {\n92\t\treturn nil, status.Error(codes.Unimplemented, \"not mocked\")\n93\t}\n94\t\n95\ttype mockPricing struct {\n96\t\tSetRatePlanFn    func(*pricingpb.SetRatePlanRequest) (*pricingpb.SetRatePlanResponse, error)\n97\t\tSetRatePlanCalls []*pricingpb.SetRatePlanRequest\n98\t}\n99\t\n100\tfunc (m *mockPricing) SetRatePlan(ctx context.Context, in *pricingpb.SetRatePlanRequest, opts ...grpc.CallOption) (*pricingpb.SetRatePlanResponse, error) {\n101\t\tm.SetRatePlanCalls = append(m.SetRatePlanCalls, in)\n102\t\tif m.SetRatePlanFn != nil {\n103\t\t\treturn m.SetRatePlanFn(in)\n104\t\t}\n105\t\treturn &pricingpb.SetRatePlanResponse{}, nil\n106\t}\n107\tfunc (m *mockPricing) Quote(ctx context.Context, in *pricingpb.QuoteRequest, opts ...grpc.CallOption) (*pricingpb.QuoteResponse, error) {\n108\t\treturn nil, status.Error(codes.Unimplemented, \"not mocked\")\n109\t}\n110\t\n111\ttype mockAds struct {\n112\t\tSetCampaignFn    func(*adspb.SetCampaignRequest) (*adspb.SetCampaignResponse, error)\n113\t\tSetCampaignCalls []*adspb.SetCampaignRequest\n114\t}\n115\t\n116\tfunc (m *mockAds) SetCampaign(ctx context.Context, in *adspb.SetCampaignRequest, opts ...grpc.CallOption) (*adspb.SetCampaignResponse, error) {\n117\t\tm.SetCampaignCalls = append(m.SetCampaignCalls, in)\n118\t\tif m.SetCampaignFn != nil {\n119\t\t\treturn m.SetCampaignFn(in)\n120\t\t}\n121\t\treturn &adspb.SetCampaignResponse{CampaignId: \"camp-default\"}, nil\n122\t}\n123\tfunc (m *mockAds) SelectSponsored(ctx context.Context, in *adspb.SelectSponsoredRequest, opts ...grpc.CallOption) (*adspb.SelectSponsoredResponse, error) {\n124\t\treturn nil, status.Error(codes.Unimplemented, \"not mocked\")\n125\t}\n126\tfunc (m *mockAds) LogImpression(ctx context.Context, in *adspb.LogImpressionRequest, opts ...grpc.CallOption) (*adspb.LogImpressionResponse, error) {\n127\t\treturn nil, status.Error(codes.Unimplemented, \"not mocked\")\n128\t}\n129\tfunc (m *mockAds) LogClick(ctx context.Context, in *adspb.LogClickRequest, opts ...grpc.CallOption) (*adspb.LogClickResponse, error) {\n130\t\treturn nil, status.Error(codes.Unimplemented, \"not mocked\")\n131\t}\n132\t\n133\ttype mocks struct {\n134\t\tgeo   *mockGeo\n135\t\tprof  *mockProfile\n136\t\tinv   *mockInventory\n137\t\tprice *mockPricing\n138\t\tads   *mockAds\n139\t}\n140\t\n141\tfunc newServer() (pb.AdminServiceServer, *mocks) {\n142\t\tm := &mocks{&mockGeo{}, &mockProfile{}, &mockInventory{}, &mockPricing{}, &mockAds{}}\n143\t\treturn server.NewServer(m.geo, m.prof, m.inv, m.price, m.ads), m\n144\t}\n145\t\n146\tfunc wantCode(t *testing.T, err error, want codes.Code) {\n147\t\tt.Helper()\n148\t\tif got := status.Code(err); got != want {\n149\t\t\tt.Errorf(\"status code = %v, want %v (err=%v)\", got, want, err)\n150\t\t}\n151\t}\n152\t\n153\t// ════════════════════════════════════════════════════════════════════════════\n154\t// UpsertHotel → geo + profile\n155\t// ════════════════════════════════════════════════════════════════════════════\n156\t\n157\tfunc TestUpsertHotel_FansOut(t *testing.T) {\n158\t\ts, m := newServer()\n159\t\t_, err := s.UpsertHotel(context.Background(), &pb.UpsertHotelRequest{\n160\t\t\tHotelId: \"H1\", Name: \"Grand\", Address: \"1 Main\", Lat: 40, Lng: -74,\n161\t\t\tRoomTypes: []string{\"STD\", \"DLX\"},\n162\t\t})\n163\t\tif err != nil {\n164\t\t\tt.Fatalf(\"UpsertHotel: %v\", err)\n165\t\t}\n166\t\tif len(m.geo.UpsertCalls) != 1 {\n167\t\t\tt.Fatalf(\"geo.UpsertHotel calls = %d, want 1\", len(m.geo.UpsertCalls))\n168\t\t}\n169\t\tg := m.geo.UpsertCalls[0]\n170\t\tif g.GetHotelId() != \"H1\" || g.GetLat() != 40 || g.GetLng() != -74 {\n171\t\t\tt.Errorf(\"geo got %+v, want H1/40/-74\", g)\n172\t\t}\n173\t\tif len(m.prof.UpsertCalls) != 1 {\n174\t\t\tt.Fatalf(\"profile.UpsertProfile calls = %d, want 1\", len(m.prof.UpsertCalls))\n175\t\t}\n176\t\tp := m.prof.UpsertCalls[0]\n177\t\tif p.GetHotelId() != \"H1\" || p.GetName() != \"Grand\" || len(p.GetRoomTypes()) != 2 {\n178\t\t\tt.Errorf(\"profile got %+v, want H1/Grand/2 room types\", p)\n179\t\t}\n180\t}\n181\t\n182\t// Empty hotel_id/name is rejected before any upstream call.\n183\tfunc TestUpsertHotel_Invalid(t *testing.T) {\n184\t\ts, m := newServer()\n185\t\t_, err := s.UpsertHotel(context.Background(), &pb.UpsertHotelRequest{HotelId: \"\", Name: \"Grand\"})\n186\t\twantCode(t, err, codes.InvalidArgument)\n187\t\t_, err = s.UpsertHotel(context.Background(), &pb.UpsertHotelRequest{HotelId: \"H1\", Name: \"\"})\n188\t\twantCode(t, err, codes.InvalidArgument)\n189\t\tif len(m.geo.UpsertCalls) != 0 || len(m.prof.UpsertCalls) != 0 {\n190\t\t\tt.Errorf(\"upstreams called despite invalid input\")\n191\t\t}\n192\t}\n193\t\n194\t// An upstream error is propagated.\n195\tfunc TestUpsertHotel_UpstreamError(t *testing.T) {\n196\t\ts, m := newServer()\n197\t\tm.geo.UpsertFn = func(*geopb.UpsertHotelRequest) (*geopb.UpsertHotelResponse, error) {\n198\t\t\treturn nil, status.Error(codes.Unavailable, \"geo down\")\n199\t\t}\n200\t\t_, err := s.UpsertHotel(context.Background(), &pb.UpsertHotelRequest{HotelId: \"H1\", Name: \"Grand\"})\n201\t\tif status.Code(err) == codes.OK {\n202\t\t\tt.Errorf(\"expected an error to propagate from geo\")\n203\t\t}\n204\t}\n205\t\n206\t// ════════════════════════════════════════════════════════════════════════════\n207\t// SetInventory / SetRatePlan / SetCampaign\n208\t// ════════════════════════════════════════════════════════════════════════════\n209\t\n210\tfunc TestSetInventory_ForwardsT