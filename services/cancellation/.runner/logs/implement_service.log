{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019aK2EyzKNZakd3C54ewiVo","type":"tool_result","content":"1\t// Unit tests for cancellation, derived from SPEC.yaml.\n2\t//\n3\t// What this service is:\n4\t//   cancellation reverses a booking. Cancel(booking_id) calls\n5\t//   booking.GetBooking to retrieve the auth_id + amount, then calls\n6\t//   payment.Refund. Stateless.\n7\t//\n8\t// Test contract assumed about the implementation:\n9\t//   - `server.NewServer(booking, payment)` returns a *Server where the two\n10\t//     args implement bookingpb.BookingServiceClient and\n11\t//     paymentpb.PaymentServiceClient respectively. Tests inject mocks.\n12\t//   - Standard gRPC signatures; errors via status.Error.\n13\t\n14\tpackage server_test\n15\t\n16\timport (\n17\t\t\"context\"\n18\t\t\"testing\"\n19\t\n20\t\tbookingpb \"agentbench/services/booking/api/v1\"\n21\t\tpb \"agentbench/services/cancellation/api/v1\"\n22\t\t\"agentbench/services/cancellation/internal/server\"\n23\t\tpaymentpb \"agentbench/services/payment/api/v1\"\n24\t\n25\t\t\"google.golang.org/grpc\"\n26\t\t\"google.golang.org/grpc/codes\"\n27\t\t\"google.golang.org/grpc/status\"\n28\t)\n29\t\n30\t// ─── Mocks ──────────────────────────────────────────────────────────────────\n31\t\n32\ttype mockBooking struct {\n33\t\tCreateBookingFn func(ctx context.Context, in *bookingpb.CreateBookingRequest, opts ...grpc.CallOption) (*bookingpb.CreateBookingResponse, error)\n34\t\tGetBookingFn    func(ctx context.Context, in *bookingpb.GetBookingRequest, opts ...grpc.CallOption) (*bookingpb.GetBookingResponse, error)\n35\t\tListBookingsFn  func(ctx context.Context, in *bookingpb.ListBookingsRequest, opts ...grpc.CallOption) (*bookingpb.ListBookingsResponse, error)\n36\t\n37\t\tGetBookingCalls []*bookingpb.GetBookingRequest\n38\t}\n39\t\n40\tfunc (m *mockBooking) CreateBooking(ctx context.Context, in *bookingpb.CreateBookingRequest, opts ...grpc.CallOption) (*bookingpb.CreateBookingResponse, error) {\n41\t\tif m.CreateBookingFn != nil {\n42\t\t\treturn m.CreateBookingFn(ctx, in, opts...)\n43\t\t}\n44\t\treturn nil, status.Error(codes.Unimplemented, \"not mocked\")\n45\t}\n46\tfunc (m *mockBooking) GetBooking(ctx context.Context, in *bookingpb.GetBookingRequest, opts ...grpc.CallOption) (*bookingpb.GetBookingResponse, error) {\n47\t\tm.GetBookingCalls = append(m.GetBookingCalls, in)\n48\t\tif m.GetBookingFn != nil {\n49\t\t\treturn m.GetBookingFn(ctx, in, opts...)\n50\t\t}\n51\t\t// Default: a \"confirmed\" booking with predictable fields.\n52\t\treturn &bookingpb.GetBookingResponse{\n53\t\t\tUserId: \"u-1\", HotelId: \"h-1\", RoomType: \"STD\", Date: \"2025-01-01\",\n54\t\t\tAmount: 100, Currency: \"USD\", AuthId: \"auth-1\", Status: \"confirmed\",\n55\t\t}, nil\n56\t}\n57\tfunc (m *mockBooking) ListBookings(ctx context.Context, in *bookingpb.ListBookingsRequest, opts ...grpc.CallOption) (*bookingpb.ListBookingsResponse, error) {\n58\t\tif m.ListBookingsFn != nil {\n59\t\t\treturn m.ListBookingsFn(ctx, in, opts...)\n60\t\t}\n61\t\treturn nil, status.Error(codes.Unimplemented, \"not mocked\")\n62\t}\n63\t\n64\ttype mockPayment struct {\n65\t\tAuthorizeFn func(ctx context.Context, in *paymentpb.AuthorizeRequest, opts ...grpc.CallOption) (*paymentpb.AuthorizeResponse, error)\n66\t\tCaptureFn   func(ctx context.Context, in *paymentpb.CaptureRequest, opts ...grpc.CallOption) (*paymentpb.CaptureResponse, error)\n67\t\tVoidFn      func(ctx context.Context, in *paymentpb.VoidRequest, opts ...grpc.CallOption) (*paymentpb.VoidResponse, error)\n68\t\tRefundFn    func(ctx context.Context, in *paymentpb.RefundRequest, opts ...grpc.CallOption) (*paymentpb.RefundResponse, error)\n69\t\n70\t\tRefundCalls []*paymentpb.RefundRequest\n71\t}\n72\t\n73\tfunc (m *mockPayment) Authorize(ctx context.Context, in *paymentpb.AuthorizeRequest, opts ...grpc.CallOption) (*paymentpb.AuthorizeResponse, error) {\n74\t\tif m.AuthorizeFn != nil {\n75\t\t\treturn m.AuthorizeFn(ctx, in, opts...)\n76\t\t}\n77\t\treturn nil, status.Error(codes.Unimplemented, \"not mocked\")\n78\t}\n79\tfunc (m *mockPayment) Capture(ctx context.Context, in *paymentpb.CaptureRequest, opts ...grpc.CallOption) (*paymentpb.CaptureResponse, error) {\n80\t\tif m.CaptureFn != nil {\n81\t\t\treturn m.CaptureFn(ctx, in, opts...)\n82\t\t}\n83\t\treturn nil, status.Error(codes.Unimplemented, \"not mocked\")\n84\t}\n85\tfunc (m *mockPayment) Void(ctx context.Context, in *paymentpb.VoidRequest, opts ...grpc.CallOption) (*paymentpb.VoidResponse, error) {\n86\t\tif m.VoidFn != nil {\n87\t\t\treturn m.VoidFn(ctx, in, opts...)\n88\t\t}\n89\t\treturn nil, status.Error(codes.Unimplemented, \"not mocked\")\n90\t}\n91\tfunc (m *mockPayment) Refund(ctx context.Context, in *paymentpb.RefundRequest, opts ...grpc.CallOption) (*paymentpb.RefundResponse, error) {\n92\t\tm.RefundCalls = append(m.RefundCalls, in)\n93\t\tif m.RefundFn != nil {\n94\t\t\treturn m.RefundFn(ctx, in, opts...)\n95\t\t}\n96\t\treturn &paymentpb.RefundResponse{}, nil\n97\t}\n98\t\n99\tfunc wantCode(t *testing.T, err error, want codes.Code) {\n100\t\tt.Helper()\n101\t\tif got := status.Code(err); got != want {\n102\t\t\tt.Errorf(\"code = %v, want %v (err=%v)\", got, want, err)\n103\t\t}\n104\t}\n105\t\n106\t// ════════════════════════════════════════════════════════════════════════════\n107\t// Cancel\n108\t// ════════════════════════════════════════════════════════════════════════════\n109\t\n110\t// Happy: Cancel looks up the booking and refunds with the booking's\n111\t// auth_id and amount. Both upstream calls happen exactly once.\n112\tfunc TestCancel_Happy(t *testing.T) {\n113\t\tbook, pay := &mockBooking{}, &mockPayment{}\n114\t\ts := server.NewServer(book, pay)\n115\t\n116\t\t_, err := s.Cancel(context.Background(), &pb.CancelRequest{BookingId: \"b-1\"})\n117\t\tif err != nil {\n118\t\t\tt.Fatalf(\"Cancel: %v\", err)\n119\t\t}\n120\t\tif len(book.GetBookingCalls) != 1 {\n121\t\t\tt.Errorf(\"book.GetBooking calls = %d, want 1\", len(book.GetBookingCalls))\n122\t\t}\n123\t\tif len(pay.RefundCalls) != 1 {\n124\t\t\tt.Errorf(\"pay.Refund calls = %d, want 1\", len(pay.RefundCalls))\n125\t\t}\n126\t\tr := pay.RefundCalls[0]\n127\t\tif r.GetAuthId() != \"auth-1\" || r.GetAmount() != 100 {\n128\t\t\tt.Errorf(\"Refund called with wrong fields: auth_id=%q amount=%d\",\n129\t\t\t\tr.GetAuthId(), r.GetAmount())\n130\t\t}\n131\t}\n132\t\n133\t// Empty booking_id → InvalidArgument; no upstream calls.\n134\tfunc TestCancel_EmptyBookingId(t *testing.T) {\n135\t\tbook, pay := &mockBooking{}, &mockPayment{}\n136\t\ts := server.NewServer(book, pay)\n137\t\n138\t\t_, err := s.Cancel(context.Background(), &pb.CancelRequest{BookingId: \"\"})\n139\t\twantCode(t, err, codes.InvalidArgument)\n140\t\tif len(book.GetBookingCalls) != 0 || len(pay.RefundCalls) != 0 {\n141\t\t\tt.Errorf(\"upstream calls made despite empty booking_id\")\n142\t\t}\n143\t}\n144\t\n145\t// booking.GetBooking returns NotFound → Cancel returns NotFound; no Refund.\n146\tfunc TestCancel_BookingNotFound(t *testing.T) {\n147\t\tbook := &mockBooking{GetBookingFn: func(_ context.Context, _ *bookingpb.GetBookingRequest, _ ...grpc.CallOption) (*bookingpb.GetBookingResponse, error) {\n148\t\t\treturn nil, status.Error(codes.NotFound, \"unknown booking\")\n149\t\t}}\n150\t\tpay := &mockPayment{}\n151\t\ts := server.NewServer(book, pay)\n152\t\n153\t\t_, err := s.Cancel(context.Background(), &pb.CancelRequest{BookingId: \"missing\"})\n154\t\twantCode(t, err, codes.NotFound)\n155\t\tif len(pay.RefundCalls) != 0 {\n156\t\t\tt.Errorf(\"Refund called even though booking not found\")\n157\t\t}\n158\t}\n159\t\n160\t// payment.Refund returns any error → Cancel returns FailedPrecondition.\n161\tfunc TestCancel_RefundFails(t *testing.T) {\n162\t\tbook := &mockBooking{}\n163\t\tpay := &mockPayment{RefundFn: func(_ context.Context, _ *paymentpb.RefundRequest, _ ...grpc.CallOption) (*paymentpb.RefundResponse, error) {\n164\t\t\treturn nil, status.Error(codes.Internal, \"PSP outage\")\n165\t\t}}\n166\t\ts := server.NewServer(book, pay)\n167\t\n168\t\t_, err := s.Cancel(context.Background(), &pb.CancelRequest{BookingId: \"b-1\"})\n169\t\twantCode(t, err, codes.FailedPrecondition)\n170\t}\n171\t"}]},"parent_tool_use_id":null,"session_id":"35469e97-f087-481a-af93-7f2869a87b71","uuid":"40bb2193-4b15-4a31-ace3-80564e0976e7","timestamp":"2026-05-25T22:40:37.541Z","tool_use_result":{"type":"text","file":{"filePath":"/home/leochanj/Desktop/agentbench/services/cancellation/internal/server/server_test.go","content":"// Unit tests for cancellation, derived from SPEC.yaml.\n//\n// What this service is:\n//   cancellation reverses a booking. Cancel(booking_id) calls\n//   booking.GetBooking to retrieve the auth_id + amount, then calls\n//   payment.Refund. Stateless.\n//\n// Test contract assumed about the implementation:\n//   - `server.NewServer(booking, payment)` returns a *Server where the two\n//     args implement bookingpb.BookingServiceClient and\n//     paymentpb.PaymentServiceClient respectively. Tests inject mocks.\n//   - Standard gRPC signatures; errors via status.Error.\n\npackage server_test\n\nimport (\n\t\"context\"\n\t\"testing\"\n\n\tbookingpb \"agentbench/services/booking/api/v1\"\n\tpb \"agentbench/services/cancellation/api/v1\"\n\t\"agentbench/services/cancellation/internal/server\"\n\tpaymentpb \"agentbench/services/payment/api/v1\"\n\n\t\"google.golang.org/grpc\"\n\t\"google.golang.org/grpc/codes\"\n\t\"google.golang.org/grpc/status\"\n)\n\n// ─── Mocks ──────────────────────────────────────────────────────────────────\n\ntype mockBooking struct {\n\tCreateBookingFn func(ctx context.Context, in *bookingpb.CreateBookingRequest, opts ...grpc.CallOption) (*bookingpb.CreateBookingResponse, error)\n\tGetBookingFn    func(ctx context.Context, in *bookingpb.GetBookingRequest, opts ...grpc.CallOption) (*bookingpb.GetBookingResponse, error)\n\tListBookingsFn  func(ctx context.Context, in *bookingpb.ListBookingsRequest, opts ...grpc.CallOption) (*bookingpb.ListBookingsResponse, error)\n\n\tGetBookingCalls []*bookingpb.GetBookingRequest\n}\n\nfunc (m *mockBooking) CreateBooking(ctx context.Context, in *bookingpb.CreateBookingRequest, opts ...grpc.CallOption) (*bookingpb.CreateBookingResponse, error) {\n\tif m.CreateBookingFn != nil {\n\t\treturn m.CreateBookingFn(ctx, in, opts...)\n\t}\n\treturn nil, status.Error(codes.Unimplemented, \"not mocked\")\n}\nfunc (m *mockBooking) GetBooking(ctx context.Context, in *bookingpb.GetBookingRequest, opts ...grpc.CallOption) (*bookingpb.GetBookingResponse, error) {\n\tm.GetBookingCalls = append(m.GetBookingCalls, in)\n\tif m.GetBookingFn != nil {\n\t\treturn m.GetBookingFn(ctx, in, opts...)\n\t}\n\t// Default: a \"confirmed\" booking with predictable fields.\n\treturn &bookingpb.GetBookingResponse{\n\t\tUserId: \"u-1\", HotelId: \"h-1\", RoomType: \"STD\", Date: \"2025-01-01\",\n\t\tAmount: 100, Currency: \"USD\", AuthId: \"auth-1\", Status: \"confirmed\",\n\t}, nil\n}\nfunc (m *mockBooking) ListBookings(ctx context.Context, in *bookingpb.ListBookingsRequest, opts ...grpc.CallOption) (*bookingpb.ListBookingsResponse, error) {\n\tif m.ListBookingsFn != nil {\n\t\treturn m.ListBookingsFn(ctx, in, opts...)\n\t}\n\treturn nil, status.Error(codes.Unimplemented, \"not mocked\")\n}\n\ntype mockPayment struct {\n\tAuthorizeFn func(ctx context.Context, in *paymentpb.AuthorizeRequest, opts ...grpc.CallOption) (*paymentpb.AuthorizeResponse, error)\n\tCaptureFn   func(ctx context.Context, in *paymentpb.CaptureRequest, opts ...grpc.CallOption) (*paymentpb.CaptureResponse, error)\n\tVoidFn      func(ctx context.Context, in *paymentpb.VoidRequest, opts ...grpc.CallOption) (*paymentpb.VoidResponse, error)\n\tRefundFn    func(ctx context.Context, in *paymentpb.RefundRequest, opts ...grpc.CallOption) (*paymentpb.RefundResponse, error)\n\n\tRefundCalls []*paymentpb.RefundRequest\n}\n\nfunc (m *mockPayment) Authorize(ctx context.Context, in *paymentpb.AuthorizeRequest, opts ...grpc.CallOption) (*paymentpb.AuthorizeResponse, error) {\n\tif m.AuthorizeFn != nil {\n\t\treturn m.AuthorizeFn(ctx, in, opts...)\n\t}\n\treturn nil, status.Error(codes.Unimplemented, \"not mocked\")\n}\nfunc (m *mockPayment) Capture(ctx context.Context, in *paymentpb.CaptureRequest, opts ...grpc.CallOption) (*paymentpb.CaptureResponse, error) {\n\tif m.CaptureFn != nil {\n\t\treturn m.CaptureFn(ctx, in, opts...)\n\t}\n\treturn nil, status.Error(codes.Unimplemented, \"not mocked\")\n}\nfunc (m *mockPayment) Void(ctx context.Context, in *paymentpb.VoidRequest, opts ...grpc.CallOption) (*paymentpb.VoidResponse, error) {\n\tif m.VoidFn != nil {\n\t\treturn m.VoidFn(ctx, in, opts...)\n\t}\n\treturn nil, status.Error(codes.Unimplemented, \"not mocked\")\n}\nfunc (m *mockPayment) Refund(ctx context.Context, in *paymentpb.RefundRequest, opts ...grpc.CallOption) (*paymentpb.RefundResponse, error) {\n\tm.RefundCalls = append(m.RefundCalls, in)\n\tif m.RefundFn != nil {\n\t\treturn m.RefundFn(ctx, in, opts...)\n\t}\n\treturn &paymentpb.RefundResponse{}, nil\n}\n\nfunc wantCode(t *testing.T, err error, want codes.Code) {\n\tt.Helper()\n\tif got := status.Code(err); got != want {\n\t\tt.Errorf(\"code = %v, want %v (err=%v)\", got, want, err)\n\t}\n}\n\n// ════════════════════════════════════════════════════════════════════════════\n// Cancel\n// ════════════════════════════════════════════════════════════════════════════\n\n// Happy: Cancel looks up the booking and refunds with the booking's\n// auth_id and amount. Both upstream calls happen exactly once.\nfunc TestCancel_Happy(t *testing.T) {\n\tbook, pay := &mockBooking{}, &mockPayment{}\n\ts := server.NewServer(book, pay)\n\n\t_, err := s.Cancel(context.Background(), &pb.CancelRequest{BookingId: \"b-1\"})\n\tif err != nil {\n\t\tt.Fatalf(\"Cancel: %v\", err)\n\t}\n\tif len(book.GetBookingCalls) != 1 {\n\t\tt.Errorf(\"book.GetBooking calls = %d, want 1\", len(book.GetBookingCalls))\n\t}\n\tif len(pay.RefundCalls) != 1 {\n\t\tt.Errorf(\"pay.Refund calls = %d, want 1\", len(pay.RefundCalls))\n\t}\n\tr := pay.RefundCalls[0]\n\tif r.GetAuthId() != \"auth-1\" || r.GetAmount() != 100 {\n\t\tt.Errorf(\"Refund called with wrong fields: auth_id=%q amount=%d\",\n\t\t\tr.GetAuthId(), r.GetAmount())\n\t}\n}\n\n// Empty booking_id → InvalidArgument; no upstream calls.\nfunc TestCancel_EmptyBookingId(t *testing.T) {\n\tbook, pay := &mockBooking{}, &mockPayment{}\n\ts := server.NewServer(book, pay)\n\n\t_, err := s.Cancel(context.Background(), &pb.CancelRequest{BookingId: \"\"})\n\twantCode(t, err, codes.InvalidArgument)\n\tif len(book.GetBookingCalls) != 0 || len(pay.RefundCalls) != 0 {\n\t\tt.Errorf(\"upstream calls made despite empty booking_id\")\n\t}\n}\n\n// booking.GetBooking returns NotFound → Cancel returns NotFound; no Refund.\nfunc TestCancel_BookingNotFound(t *testing.T) {\n\tbook := &mockBooking{GetBookingFn: func(_ context.Context, _ *bookingpb.GetBookingRequest, _ ...grpc.CallOption) (*bookingpb.GetBookingResponse, error) {\n\t\treturn nil, status.Error(codes.NotFound, \"unknown booking\")\n\t}}\n\tpay := &mockPayment{}\n\ts := server.NewServer(book, pay)\n\n\t_, err := s.Cancel(context.Background(), &pb.CancelRequest{BookingId: \"missing\"})\n\twantCode(t, err, codes.NotFound)\n\tif len(pay.RefundCalls) != 0 {\n\t\tt.Errorf(\"Refund called even though booking not found\")\n\t}\n}\n\n// payment.Refund returns any error → Cancel returns FailedPrecondition.\nfunc TestCancel_RefundFails(t *testing.T) {\n\tbook := &mockBooking{}\n\tpay := &mockPayment{RefundFn: func(_ context.Context, _ *paymentpb.RefundRequest, _ ...grpc.CallOption) (*paymentpb.RefundResponse, error) {\n\t\treturn nil, status.Error(codes.Internal, \"PSP outage\")\n\t}}\n\ts := server.NewServer(book, pay)\n\n\t_, err := s.Cancel(context.Background(), &pb.CancelRequest{BookingId: \"b-1\"})\n\twantCode(t, err, codes.FailedPrecondition)\n}\n","numLines":171,"startLine":1,"totalLines":171}}}
