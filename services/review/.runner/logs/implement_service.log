{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01QGCFLPjC5ii6Gxjbro77T3","type":"tool_result","content":"1\t// Unit tests for review, derived from SPEC.yaml.\n2\t//\n3\t// What this service is:\n4\t//   review stores hotel reviews (in-memory v1), serves them paginated, and\n5\t//   computes a per-hotel rating aggregate on demand.\n6\t//\n7\t// Test contract assumed about the implementation:\n8\t//   - `server.NewServer()` returns a *Server implementing pb.ReviewServiceServer.\n9\t//   - Standard gRPC signatures; errors via google.golang.org/grpc/status with\n10\t//     the codes in SPEC.error_semantics.\n11\t//\n12\t// Authored out-of-band and audited before the agent implements. The agent\n13\t// must not modify this file.\n14\t\n15\tpackage server_test\n16\t\n17\timport (\n18\t\t\"context\"\n19\t\t\"math\"\n20\t\t\"testing\"\n21\t\n22\t\tpb \"agentbench/services/review/api/v1\"\n23\t\t\"agentbench/services/review/internal/server\"\n24\t\n25\t\t\"google.golang.org/grpc/codes\"\n26\t\t\"google.golang.org/grpc/status\"\n27\t)\n28\t\n29\tfunc postOK(t *testing.T, s pb.ReviewServiceServer, hotel, user string, rating int32) {\n30\t\tt.Helper()\n31\t\tr, err := s.PostReview(context.Background(), &pb.PostReviewRequest{\n32\t\t\tHotelId: hotel, UserId: user, Rating: rating, Text: \"ok\",\n33\t\t})\n34\t\tif err != nil {\n35\t\t\tt.Fatalf(\"PostReview(%s,%d): %v\", hotel, rating, err)\n36\t\t}\n37\t\tif r.GetReviewId() == \"\" {\n38\t\t\tt.Fatalf(\"PostReview returned empty review_id\")\n39\t\t}\n40\t}\n41\t\n42\tfunc wantCode(t *testing.T, err error, want codes.Code) {\n43\t\tt.Helper()\n44\t\tif got := status.Code(err); got != want {\n45\t\t\tt.Errorf(\"status code = %v, want %v (err=%v)\", got, want, err)\n46\t\t}\n47\t}\n48\t\n49\t// ════════════════════════════════════════════════════════════════════════════\n50\t// PostReview / ListReviews\n51\t// ════════════════════════════════════════════════════════════════════════════\n52\t\n53\t// Posted reviews are listed back for the hotel with total_count.\n54\tfunc TestListReviews_Happy(t *testing.T) {\n55\t\ts := server.NewServer()\n56\t\tpostOK(t, s, \"H1\", \"u-1\", 4)\n57\t\tpostOK(t, s, \"H1\", \"u-2\", 5)\n58\t\n59\t\tr, err := s.ListReviews(context.Background(), &pb.ListReviewsRequest{HotelId: \"H1\", Page: 1, PageSize: 10})\n60\t\tif err != nil {\n61\t\t\tt.Fatalf(\"ListReviews: %v\", err)\n62\t\t}\n63\t\tif r.GetTotalCount() != 2 {\n64\t\t\tt.Errorf(\"total_count = %d, want 2\", r.GetTotalCount())\n65\t\t}\n66\t\tif len(r.GetReviews()) != 2 {\n67\t\t\tt.Errorf(\"page len = %d, want 2\", len(r.GetReviews()))\n68\t\t}\n69\t}\n70\t\n71\t// Pagination: 3 reviews, page_size 2 → page 1 has 2, page 2 has 1.\n72\tfunc TestListReviews_Paginates(t *testing.T) {\n73\t\ts := server.NewServer()\n74\t\tpostOK(t, s, \"H1\", \"u-1\", 3)\n75\t\tpostOK(t, s, \"H1\", \"u-2\", 4)\n76\t\tpostOK(t, s, \"H1\", \"u-3\", 5)\n77\t\n78\t\tp1, err := s.ListReviews(context.Background(), &pb.ListReviewsRequest{HotelId: \"H1\", Page: 1, PageSize: 2})\n79\t\tif err != nil {\n80\t\t\tt.Fatalf(\"ListReviews p1: %v\", err)\n81\t\t}\n82\t\tif len(p1.GetReviews()) != 2 || p1.GetTotalCount() != 3 {\n83\t\t\tt.Errorf(\"page1 len=%d total=%d, want 2 and 3\", len(p1.GetReviews()), p1.GetTotalCount())\n84\t\t}\n85\t\tp2, err := s.ListReviews(context.Background(), &pb.ListReviewsRequest{HotelId: \"H1\", Page: 2, PageSize: 2})\n86\t\tif err != nil {\n87\t\t\tt.Fatalf(\"ListReviews p2: %v\", err)\n88\t\t}\n89\t\tif len(p2.GetReviews()) != 1 {\n90\t\t\tt.Errorf(\"page2 len = %d, want 1\", len(p2.GetReviews()))\n91\t\t}\n92\t}\n93\t\n94\t// An unknown hotel yields an empty page, not an error.\n95\tfunc TestListReviews_UnknownHotel(t *testing.T) {\n96\t\ts := server.NewServer()\n97\t\tr, err := s.ListReviews(context.Background(), &pb.ListReviewsRequest{HotelId: \"nope\", Page: 1, PageSize: 10})\n98\t\tif err != nil {\n99\t\t\tt.Fatalf(\"ListReviews: %v\", err)\n100\t\t}\n101\t\tif r.GetTotalCount() != 0 || len(r.GetReviews()) != 0 {\n102\t\t\tt.Errorf(\"unknown hotel should yield empty page, got total=%d len=%d\", r.GetTotalCount(), len(r.GetReviews()))\n103\t\t}\n104\t}\n105\t\n106\t// Bad rating (0 or 6) is InvalidArgument; bad pagination is InvalidArgument.\n107\tfunc TestReview_InvalidArgs(t *testing.T) {\n108\t\ts := server.NewServer()\n109\t\tfor _, rating := range []int32{0, 6, -1} {\n110\t\t\t_, err := s.PostReview(context.Background(), &pb.PostReviewRequest{HotelId: \"H1\", UserId: \"u\", Rating: rating, Text: \"x\"})\n111\t\t\twantCode(t, err, codes.InvalidArgument)\n112\t\t}\n113\t\t_, err := s.PostReview(context.Background(), &pb.PostReviewRequest{HotelId: \"\", UserId: \"u\", Rating: 5})\n114\t\twantCode(t, err, codes.InvalidArgument)\n115\t\n116\t\t_, err = s.ListReviews(context.Background(), &pb.ListReviewsRequest{HotelId: \"H1\", Page: 0, PageSize: 10})\n117\t\twantCode(t, err, codes.InvalidArgument)\n118\t\t_, err = s.ListReviews(context.Background(), &pb.ListReviewsRequest{HotelId: \"H1\", Page: 1, PageSize: 0})\n119\t\twantCode(t, err, codes.InvalidArgument)\n120\t}\n121\t\n122\t// ════════════════════════════════════════════════════════════════════════════\n123\t// GetAggregate\n124\t// ════════════════════════════════════════════════════════════════════════════\n125\t\n126\t// Aggregate reports count and mean rating: ratings 4,5,3 → count 3, avg 4.0.\n127\tfunc TestGetAggregate(t *testing.T) {\n128\t\ts := server.NewServer()\n129\t\tpostOK(t, s, \"H1\", \"u-1\", 4)\n130\t\tpostOK(t, s, \"H1\", \"u-2\", 5)\n131\t\tpostOK(t, s, \"H1\", \"u-3\", 3)\n132\t\n133\t\ta, err := s.GetAggregate(context.Background(), &pb.GetAggregateRequest{HotelId: \"H1\"})\n134\t\tif err != nil {\n135\t\t\tt.Fatalf(\"GetAggregate: %v\", err)\n136\t\t}\n137\t\tif a.GetReviewCount() != 3 {\n138\t\t\tt.Errorf(\"review_count = %d, want 3\", a.GetReviewCount())\n139\t\t}\n140\t\tif math.Abs(a.GetAvgRating()-4.0) > 0.001 {\n141\t\t\tt.Errorf(\"avg_rating = %v, want ~4.0\", a.GetAvgRating())\n142\t\t}\n143\t}\n144\t\n145\t// A hotel with no reviews aggregates to count 0, avg 0.\n146\tfunc TestGetAggregate_Empty(t *testing.T) {\n147\t\ts := server.NewServer()\n148\t\ta, err := s.GetAggregate(context.Background(), &pb.GetAggregateRequest{HotelId: \"nope\"})\n149\t\tif err != nil {\n150\t\t\tt.Fatalf(\"GetAggregate: %v\", err)\n151\t\t}\n152\t\tif a.GetReviewCount() != 0 || a.GetAvgRating() != 0 {\n153\t\t\tt.Errorf(\"empty aggregate = (count %d, avg %v), want (0, 0)\", a.GetReviewCount(), a.GetAvgRating())\n154\t\t}\n155\t}\n156\t"}]},"parent_tool_use_id":null,"session_id":"c18618e1-bdb4-45ed-8188-976cce824b01","uuid":"374893eb-66df-4cab-a44f-88c99bdf1755","timestamp":"2026-06-08T05:47:51.346Z","tool_use_result":{"type":"text","file":{"filePath":"/home/leochanj/Desktop/agentbench/services/review/internal/server/server_test.go","content":"// Unit tests for review, derived from SPEC.yaml.\n//\n// What this service is:\n//   review stores hotel reviews (in-memory v1), serves them paginated, and\n//   computes a per-hotel rating aggregate on demand.\n//\n// Test contract assumed about the implementation:\n//   - `server.NewServer()` returns a *Server implementing pb.ReviewServiceServer.\n//   - Standard gRPC signatures; errors via google.golang.org/grpc/status with\n//     the codes in SPEC.error_semantics.\n//\n// Authored out-of-band and audited before the agent implements. The agent\n// must not modify this file.\n\npackage server_test\n\nimport (\n\t\"context\"\n\t\"math\"\n\t\"testing\"\n\n\tpb \"agentbench/services/review/api/v1\"\n\t\"agentbench/services/review/internal/server\"\n\n\t\"google.golang.org/grpc/codes\"\n\t\"google.golang.org/grpc/status\"\n)\n\nfunc postOK(t *testing.T, s pb.ReviewServiceServer, hotel, user string, rating int32) {\n\tt.Helper()\n\tr, err := s.PostReview(context.Background(), &pb.PostReviewRequest{\n\t\tHotelId: hotel, UserId: user, Rating: rating, Text: \"ok\",\n\t})\n\tif err != nil {\n\t\tt.Fatalf(\"PostReview(%s,%d): %v\", hotel, rating, err)\n\t}\n\tif r.GetReviewId() == \"\" {\n\t\tt.Fatalf(\"PostReview returned empty review_id\")\n\t}\n}\n\nfunc wantCode(t *testing.T, err error, want codes.Code) {\n\tt.Helper()\n\tif got := status.Code(err); got != want {\n\t\tt.Errorf(\"status code = %v, want %v (err=%v)\", got, want, err)\n\t}\n}\n\n// ════════════════════════════════════════════════════════════════════════════\n// PostReview / ListReviews\n// ════════════════════════════════════════════════════════════════════════════\n\n// Posted reviews are listed back for the hotel with total_count.\nfunc TestListReviews_Happy(t *testing.T) {\n\ts := server.NewServer()\n\tpostOK(t, s, \"H1\", \"u-1\", 4)\n\tpostOK(t, s, \"H1\", \"u-2\", 5)\n\n\tr, err := s.ListReviews(context.Background(), &pb.ListReviewsRequest{HotelId: \"H1\", Page: 1, PageSize: 10})\n\tif err != nil {\n\t\tt.Fatalf(\"ListReviews: %v\", err)\n\t}\n\tif r.GetTotalCount() != 2 {\n\t\tt.Errorf(\"total_count = %d, want 2\", r.GetTotalCount())\n\t}\n\tif len(r.GetReviews()) != 2 {\n\t\tt.Errorf(\"page len = %d, want 2\", len(r.GetReviews()))\n\t}\n}\n\n// Pagination: 3 reviews, page_size 2 → page 1 has 2, page 2 has 1.\nfunc TestListReviews_Paginates(t *testing.T) {\n\ts := server.NewServer()\n\tpostOK(t, s, \"H1\", \"u-1\", 3)\n\tpostOK(t, s, \"H1\", \"u-2\", 4)\n\tpostOK(t, s, \"H1\", \"u-3\", 5)\n\n\tp1, err := s.ListReviews(context.Background(), &pb.ListReviewsRequest{HotelId: \"H1\", Page: 1, PageSize: 2})\n\tif err != nil {\n\t\tt.Fatalf(\"ListReviews p1: %v\", err)\n\t}\n\tif len(p1.GetReviews()) != 2 || p1.GetTotalCount() != 3 {\n\t\tt.Errorf(\"page1 len=%d total=%d, want 2 and 3\", len(p1.GetReviews()), p1.GetTotalCount())\n\t}\n\tp2, err := s.ListReviews(context.Background(), &pb.ListReviewsRequest{HotelId: \"H1\", Page: 2, PageSize: 2})\n\tif err != nil {\n\t\tt.Fatalf(\"ListReviews p2: %v\", err)\n\t}\n\tif len(p2.GetReviews()) != 1 {\n\t\tt.Errorf(\"page2 len = %d, want 1\", len(p2.GetReviews()))\n\t}\n}\n\n// An unknown hotel yields an empty page, not an error.\nfunc TestListReviews_UnknownHotel(t *testing.T) {\n\ts := server.NewServer()\n\tr, err := s.ListReviews(context.Background(), &pb.ListReviewsRequest{HotelId: \"nope\", Page: 1, PageSize: 10})\n\tif err != nil {\n\t\tt.Fatalf(\"ListReviews: %v\", err)\n\t}\n\tif r.GetTotalCount() != 0 || len(r.GetReviews()) != 0 {\n\t\tt.Errorf(\"unknown hotel should yield empty page, got total=%d len=%d\", r.GetTotalCount(), len(r.GetReviews()))\n\t}\n}\n\n// Bad rating (0 or 6) is InvalidArgument; bad pagination is InvalidArgument.\nfunc TestReview_InvalidArgs(t *testing.T) {\n\ts := server.NewServer()\n\tfor _, rating := range []int32{0, 6, -1} {\n\t\t_, err := s.PostReview(context.Background(), &pb.PostReviewRequest{HotelId: \"H1\", UserId: \"u\", Rating: rating, Text: \"x\"})\n\t\twantCode(t, err, codes.InvalidArgument)\n\t}\n\t_, err := s.PostReview(context.Background(), &pb.PostReviewRequest{HotelId: \"\", UserId: \"u\", Rating: 5})\n\twantCode(t, err, codes.InvalidArgument)\n\n\t_, err = s.ListReviews(context.Background(), &pb.ListReviewsRequest{HotelId: \"H1\", Page: 0, PageSize: 10})\n\twantCode(t, err, codes.InvalidArgument)\n\t_, err = s.ListReviews(context.Background(), &pb.ListReviewsRequest{HotelId: \"H1\", Page: 1, PageSize: 0})\n\twantCode(t, err, codes.InvalidArgument)\n}\n\n// ════════════════════════════════════════════════════════════════════════════\n// GetAggregate\n// ════════════════════════════════════════════════════════════════════════════\n\n// Aggregate reports count and mean rating: ratings 4,5,3 → count 3, avg 4.0.\nfunc TestGetAggregate(t *testing.T) {\n\ts := server.NewServer()\n\tpostOK(t, s, \"H1\", \"u-1\", 4)\n\tpostOK(t, s, \"H1\", \"u-2\", 5)\n\tpostOK(t, s, \"H1\", \"u-3\", 3)\n\n\ta, err := s.GetAggregate(context.Background(), &pb.GetAggregateRequest{HotelId: \"H1\"})\n\tif err != nil {\n\t\tt.Fatalf(\"GetAggregate: %v\", err)\n\t}\n\tif a.GetReviewCount() != 3 {\n\t\tt.Errorf(\"review_count = %d, want 3\", a.GetReviewCount())\n\t}\n\tif math.Abs(a.GetAvgRating()-4.0) > 0.001 {\n\t\tt.Errorf(\"avg_rating = %v, want ~4.0\", a.GetAvgRating())\n\t}\n}\n\n// A hotel with no reviews aggregates to count 0, avg 0.\nfunc TestGetAggregate_Empty(t *testing.T) {\n\ts := server.NewServer()\n\ta, err := s.GetAggregate(context.Background(), &pb.GetAggregateRequest{HotelId: \"nope\"})\n\tif err != nil {\n\t\tt.Fatalf(\"GetAggregate: %v\", err)\n\t}\n\tif a.GetReviewCount() != 0 || a.GetAvgRating() != 0 {\n\t\tt.Errorf(\"empty aggregate = (count %d, avg %v), want (0, 0)\", a.GetReviewCount(), a.GetAvgRating())\n\t}\n}\n","numLines":156,"startLine":1,"totalLines":156}}}
