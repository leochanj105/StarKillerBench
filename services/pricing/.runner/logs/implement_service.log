{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016XB1Hny1CDEjitbBmE7vaT","type":"tool_result","content":"1\t// Unit tests for pricing, derived from SPEC.yaml.\n2\t//\n3\t// What this service is:\n4\t//   pricing quotes a stay. v1 is in-memory and deterministic: SetRatePlan\n5\t//   seeds a nightly rate per (hotel, room_type); Quote computes\n6\t//     subtotal = nightly_rate * nights\n7\t//     taxes    = subtotal / 10\n8\t//     fees     = 1500\n9\t//     total    = subtotal + taxes + fees\n10\t//   nights = number of nights between check_in and check_out (YYYY-MM-DD).\n11\t//\n12\t// Test contract assumed about the implementation:\n13\t//   - `server.NewServer()` returns a *Server implementing pb.PricingServiceServer.\n14\t//   - Standard gRPC signatures; errors via google.golang.org/grpc/status with\n15\t//     the codes in SPEC.error_semantics.\n16\t//\n17\t// Authored out-of-band and audited before the agent implements. The agent\n18\t// must not modify this file.\n19\t\n20\tpackage server_test\n21\t\n22\timport (\n23\t\t\"context\"\n24\t\t\"testing\"\n25\t\n26\t\tpb \"agentbench/services/pricing/api/v1\"\n27\t\t\"agentbench/services/pricing/internal/server\"\n28\t\n29\t\t\"google.golang.org/grpc/codes\"\n30\t\t\"google.golang.org/grpc/status\"\n31\t)\n32\t\n33\tfunc setRatePlanOK(t *testing.T, s pb.PricingServiceServer, hotel, room string, rate int64) {\n34\t\tt.Helper()\n35\t\tif _, err := s.SetRatePlan(context.Background(), &pb.SetRatePlanRequest{\n36\t\t\tHotelId: hotel, RoomType: room, NightlyRate: rate, Currency: \"USD\",\n37\t\t}); err != nil {\n38\t\t\tt.Fatalf(\"SetRatePlan(%s/%s): %v\", hotel, room, err)\n39\t\t}\n40\t}\n41\t\n42\tfunc wantCode(t *testing.T, err error, want codes.Code) {\n43\t\tt.Helper()\n44\t\tif got := status.Code(err); got != want {\n45\t\t\tt.Errorf(\"status code = %v, want %v (err=%v)\", got, want, err)\n46\t\t}\n47\t}\n48\t\n49\t// ════════════════════════════════════════════════════════════════════════════\n50\t// Quote\n51\t// ════════════════════════════════════════════════════════════════════════════\n52\t\n53\t// Three nights at 10000/night: subtotal 30000, taxes 3000, fees 1500,\n54\t// total 34500, nights 3, currency echoed.\n55\tfunc TestQuote_Happy(t *testing.T) {\n56\t\ts := server.NewServer()\n57\t\tsetRatePlanOK(t, s, \"H1\", \"STD\", 10000)\n58\t\n59\t\tq, err := s.Quote(context.Background(), &pb.QuoteRequest{\n60\t\t\tHotelId: \"H1\", RoomType: \"STD\",\n61\t\t\tCheckIn: \"2026-07-01\", CheckOut: \"2026-07-04\", Guests: 2,\n62\t\t})\n63\t\tif err != nil {\n64\t\t\tt.Fatalf(\"Quote: %v\", err)\n65\t\t}\n66\t\tif q.GetNights() != 3 {\n67\t\t\tt.Errorf(\"nights = %d, want 3\", q.GetNights())\n68\t\t}\n69\t\tif q.GetNightlyRate() != 10000 {\n70\t\t\tt.Errorf(\"nightly_rate = %d, want 10000\", q.GetNightlyRate())\n71\t\t}\n72\t\tif q.GetSubtotal() != 30000 {\n73\t\t\tt.Errorf(\"subtotal = %d, want 30000\", q.GetSubtotal())\n74\t\t}\n75\t\tif q.GetTaxes() != 3000 {\n76\t\t\tt.Errorf(\"taxes = %d, want 3000\", q.GetTaxes())\n77\t\t}\n78\t\tif q.GetFees() != 1500 {\n79\t\t\tt.Errorf(\"fees = %d, want 1500\", q.GetFees())\n80\t\t}\n81\t\tif q.GetTotal() != 34500 {\n82\t\t\tt.Errorf(\"total = %d, want 34500\", q.GetTotal())\n83\t\t}\n84\t\tif q.GetCurrency() != \"USD\" {\n85\t\t\tt.Errorf(\"currency = %q, want USD\", q.GetCurrency())\n86\t\t}\n87\t}\n88\t\n89\t// A single night: subtotal 10000, taxes 1000, fees 1500, total 12500.\n90\tfunc TestQuote_OneNight(t *testing.T) {\n91\t\ts := server.NewServer()\n92\t\tsetRatePlanOK(t, s, \"H1\", \"STD\", 10000)\n93\t\tq, err := s.Quote(context.Background(), &pb.QuoteRequest{\n94\t\t\tHotelId: \"H1\", RoomType: \"STD\",\n95\t\t\tCheckIn: \"2026-07-01\", CheckOut: \"2026-07-02\", Guests: 1,\n96\t\t})\n97\t\tif err != nil {\n98\t\t\tt.Fatalf(\"Quote: %v\", err)\n99\t\t}\n100\t\tif q.GetNights() != 1 || q.GetTotal() != 12500 {\n101\t\t\tt.Errorf(\"nights=%d total=%d, want 1 and 12500\", q.GetNights(), q.GetTotal())\n102\t\t}\n103\t}\n104\t\n105\t// No rate plan for the (hotel, room_type) → NotFound.\n106\tfunc TestQuote_NotFound(t *testing.T) {\n107\t\ts := server.NewServer()\n108\t\t_, err := s.Quote(context.Background(), &pb.QuoteRequest{\n109\t\t\tHotelId: \"H1\", RoomType: \"STD\",\n110\t\t\tCheckIn: \"2026-07-01\", CheckOut: \"2026-07-02\", Guests: 1,\n111\t\t})\n112\t\twantCode(t, err, codes.NotFound)\n113\t}\n114\t\n115\t// check_out not strictly after check_in → InvalidArgument (covers equal and\n116\t// reversed).\n117\tfunc TestQuote_BadDateRange(t *testing.T) {\n118\t\ts := server.NewServer()\n119\t\tsetRatePlanOK(t, s, \"H1\", \"STD\", 10000)\n120\t\tcases := []struct{ in, out string }{\n121\t\t\t{\"2026-07-02\", \"2026-07-02\"}, // equal\n122\t\t\t{\"2026-07-05\", \"2026-07-02\"}, // reversed\n123\t\t}\n124\t\tfor _, c := range cases {\n125\t\t\t_, err := s.Quote(context.Background(), &pb.QuoteRequest{\n126\t\t\t\tHotelId: \"H1\", RoomType: \"STD\", CheckIn: c.in, CheckOut: c.out, Guests: 1,\n127\t\t\t})\n128\t\t\twantCode(t, err, codes.InvalidArgument)\n129\t\t}\n130\t}\n131\t\n132\t// Malformed date → InvalidArgument.\n133\tfunc TestQuote_MalformedDate(t *testing.T) {\n134\t\ts := server.NewServer()\n135\t\tsetRatePlanOK(t, s, \"H1\", \"STD\", 10000)\n136\t\t_, err := s.Quote(context.Background(), &pb.QuoteRequest{\n137\t\t\tHotelId: \"H1\", RoomType: \"STD\", CheckIn: \"not-a-date\", CheckOut: \"2026-07-02\", Guests: 1,\n138\t\t})\n139\t\twantCode(t, err, codes.InvalidArgument)\n140\t}\n141\t\n142\t// Non-positive guests → InvalidArgument.\n143\tfunc TestQuote_BadGuests(t *testing.T) {\n144\t\ts := server.NewServer()\n145\t\tsetRatePlanOK(t, s, \"H1\", \"STD\", 10000)\n146\t\t_, err := s.Quote(context.Background(), &pb.QuoteRequest{\n147\t\t\tHotelId: \"H1\", RoomType: \"STD\", CheckIn: \"2026-07-01\", CheckOut: \"2026-07-02\", Guests: 0,\n148\t\t})\n149\t\twantCode(t, err, codes.InvalidArgument)\n150\t}\n151\t\n152\t// ════════════════════════════════════════════════════════════════════════════\n153\t// SetRatePlan\n154\t// ════════════════════════════════════════════════════════════════════════════\n155\t\n156\t// Re-seeding overwrites the nightly rate.\n157\tfunc TestSetRatePlan_Updates(t *testing.T) {\n158\t\ts := server.NewServer()\n159\t\tsetRatePlanOK(t, s, \"H1\", \"STD\", 10000)\n160\t\tsetRatePlanOK(t, s, \"H1\", \"STD\", 20000)\n161\t\tq, err := s.Quote(context.Background(), &pb.QuoteRequest{\n162\t\t\tHotelId: \"H1\", RoomType: \"STD\", CheckIn: \"2026-07-01\", CheckOut: \"2026-07-02\", Guests: 1,\n163\t\t})\n164\t\tif err != nil {\n165\t\t\tt.Fatalf(\"Quote: %v\", err)\n166\t\t}\n167\t\tif q.GetNightlyRate() != 20000 {\n168\t\t\tt.Errorf(\"nightly_rate = %d, want 20000 (overwrite)\", q.GetNightlyRate())\n169\t\t}\n170\t}\n171\t\n172\t// Non-positive rate → InvalidArgument.\n173\tfunc TestSetRatePlan_InvalidRate(t *testing.T) {\n174\t\ts := server.NewServer()\n175\t\tfor _, r := range []int64{0, -1} {\n176\t\t\t_, err := s.SetRatePlan(context.Background(), &pb.SetRatePlanRequest{\n177\t\t\t\tHotelId: \"H1\", RoomType: \"STD\", NightlyRate: r, Currency: \"USD\",\n178\t\t\t})\n179\t\t\twantCode(t, err, codes.InvalidArgument)\n180\t\t}\n181\t}\n182\t\n183\t// Empty hotel_id / room_type / currency → InvalidArgument.\n184\tfunc TestSetRatePlan_EmptyFields(t *testing.T) {\n185\t\ts := server.NewServer()\n186\t\tcases := []*pb.SetRatePlanRequest{\n187\t\t\t{HotelId: \"\", RoomType: \"STD\", NightlyRate: 100, Currency: \"USD\"},\n188\t\t\t{HotelId: \"H1\", RoomType: \"\", NightlyRate: 100, Currency: \"USD\"},\n189\t\t\t{HotelId: \"H1\", RoomType: \"STD\", NightlyRate: 100, Currency: \"\"},\n190\t\t}\n191\t\tfor _, req := range cases {\n192\t\t\t_, err := s.SetRatePlan(context.Background(), req)\n193\t\t\twantCode(t, err, codes.InvalidArgument)\n194\t\t}\n195\t}\n196\t"}]},"parent_tool_use_id":null,"session_id":"fa1e0279-a5d4-465a-849e-8f3058d1794c","uuid":"d7356b2d-230f-47e3-b128-ec6737a7d121","timestamp":"2026-06-07T21:27:53.053Z","tool_use_result":{"type":"text","file":{"filePath":"/home/leochanj/Desktop/agentbench/services/pricing/internal/server/server_test.go","content":"// Unit tests for pricing, derived from SPEC.yaml.\n//\n// What this service is:\n//   pricing quotes a stay. v1 is in-memory and deterministic: SetRatePlan\n//   seeds a nightly rate per (hotel, room_type); Quote computes\n//     subtotal = nightly_rate * nights\n//     taxes    = subtotal / 10\n//     fees     = 1500\n//     total    = subtotal + taxes + fees\n//   nights = number of nights between check_in and check_out (YYYY-MM-DD).\n//\n// Test contract assumed about the implementation:\n//   - `server.NewServer()` returns a *Server implementing pb.PricingServiceServer.\n//   - Standard gRPC signatures; errors via google.golang.org/grpc/status with\n//     the codes in SPEC.error_semantics.\n//\n// Authored out-of-band and audited before the agent implements. The agent\n// must not modify this file.\n\npackage server_test\n\nimport (\n\t\"context\"\n\t\"testing\"\n\n\tpb \"agentbench/services/pricing/api/v1\"\n\t\"agentbench/services/pricing/internal/server\"\n\n\t\"google.golang.org/grpc/codes\"\n\t\"google.golang.org/grpc/status\"\n)\n\nfunc setRatePlanOK(t *testing.T, s pb.PricingServiceServer, hotel, room string, rate int64) {\n\tt.Helper()\n\tif _, err := s.SetRatePlan(context.Background(), &pb.SetRatePlanRequest{\n\t\tHotelId: hotel, RoomType: room, NightlyRate: rate, Currency: \"USD\",\n\t}); err != nil {\n\t\tt.Fatalf(\"SetRatePlan(%s/%s): %v\", hotel, room, err)\n\t}\n}\n\nfunc wantCode(t *testing.T, err error, want codes.Code) {\n\tt.Helper()\n\tif got := status.Code(err); got != want {\n\t\tt.Errorf(\"status code = %v, want %v (err=%v)\", got, want, err)\n\t}\n}\n\n// ════════════════════════════════════════════════════════════════════════════\n// Quote\n// ════════════════════════════════════════════════════════════════════════════\n\n// Three nights at 10000/night: subtotal 30000, taxes 3000, fees 1500,\n// total 34500, nights 3, currency echoed.\nfunc TestQuote_Happy(t *testing.T) {\n\ts := server.NewServer()\n\tsetRatePlanOK(t, s, \"H1\", \"STD\", 10000)\n\n\tq, err := s.Quote(context.Background(), &pb.QuoteRequest{\n\t\tHotelId: \"H1\", RoomType: \"STD\",\n\t\tCheckIn: \"2026-07-01\", CheckOut: \"2026-07-04\", Guests: 2,\n\t})\n\tif err != nil {\n\t\tt.Fatalf(\"Quote: %v\", err)\n\t}\n\tif q.GetNights() != 3 {\n\t\tt.Errorf(\"nights = %d, want 3\", q.GetNights())\n\t}\n\tif q.GetNightlyRate() != 10000 {\n\t\tt.Errorf(\"nightly_rate = %d, want 10000\", q.GetNightlyRate())\n\t}\n\tif q.GetSubtotal() != 30000 {\n\t\tt.Errorf(\"subtotal = %d, want 30000\", q.GetSubtotal())\n\t}\n\tif q.GetTaxes() != 3000 {\n\t\tt.Errorf(\"taxes = %d, want 3000\", q.GetTaxes())\n\t}\n\tif q.GetFees() != 1500 {\n\t\tt.Errorf(\"fees = %d, want 1500\", q.GetFees())\n\t}\n\tif q.GetTotal() != 34500 {\n\t\tt.Errorf(\"total = %d, want 34500\", q.GetTotal())\n\t}\n\tif q.GetCurrency() != \"USD\" {\n\t\tt.Errorf(\"currency = %q, want USD\", q.GetCurrency())\n\t}\n}\n\n// A single night: subtotal 10000, taxes 1000, fees 1500, total 12500.\nfunc TestQuote_OneNight(t *testing.T) {\n\ts := server.NewServer()\n\tsetRatePlanOK(t, s, \"H1\", \"STD\", 10000)\n\tq, err := s.Quote(context.Background(), &pb.QuoteRequest{\n\t\tHotelId: \"H1\", RoomType: \"STD\",\n\t\tCheckIn: \"2026-07-01\", CheckOut: \"2026-07-02\", Guests: 1,\n\t})\n\tif err != nil {\n\t\tt.Fatalf(\"Quote: %v\", err)\n\t}\n\tif q.GetNights() != 1 || q.GetTotal() != 12500 {\n\t\tt.Errorf(\"nights=%d total=%d, want 1 and 12500\", q.GetNights(), q.GetTotal())\n\t}\n}\n\n// No rate plan for the (hotel, room_type) → NotFound.\nfunc TestQuote_NotFound(t *testing.T) {\n\ts := server.NewServer()\n\t_, err := s.Quote(context.Background(), &pb.QuoteRequest{\n\t\tHotelId: \"H1\", RoomType: \"STD\",\n\t\tCheckIn: \"2026-07-01\", CheckOut: \"2026-07-02\", Guests: 1,\n\t})\n\twantCode(t, err, codes.NotFound)\n}\n\n// check_out not strictly after check_in → InvalidArgument (covers equal and\n// reversed).\nfunc TestQuote_BadDateRange(t *testing.T) {\n\ts := server.NewServer()\n\tsetRatePlanOK(t, s, \"H1\", \"STD\", 10000)\n\tcases := []struct{ in, out string }{\n\t\t{\"2026-07-02\", \"2026-07-02\"}, // equal\n\t\t{\"2026-07-05\", \"2026-07-02\"}, // reversed\n\t}\n\tfor _, c := range cases {\n\t\t_, err := s.Quote(context.Background(), &pb.QuoteRequest{\n\t\t\tHotelId: \"H1\", RoomType: \"STD\", CheckIn: c.in, CheckOut: c.out, Guests: 1,\n\t\t})\n\t\twantCode(t, err, codes.InvalidArgument)\n\t}\n}\n\n// Malformed date → InvalidArgument.\nfunc TestQuote_MalformedDate(t *testing.T) {\n\ts := server.NewServer()\n\tsetRatePlanOK(t, s, \"H1\", \"STD\", 10000)\n\t_, err := s.Quote(context.Background(), &pb.QuoteRequest{\n\t\tHotelId: \"H1\", RoomType: \"STD\", CheckIn: \"not-a-date\", CheckOut: \"2026-07-02\", Guests: 1,\n\t})\n\twantCode(t, err, codes.InvalidArgument)\n}\n\n// Non-positive guests → InvalidArgument.\nfunc TestQuote_BadGuests(t *testing.T) {\n\ts := server.NewServer()\n\tsetRatePlanOK(t, s, \"H1\", \"STD\", 10000)\n\t_, err := s.Quote(context.Background(), &pb.QuoteRequest{\n\t\tHotelId: \"H1\", RoomType: \"STD\", CheckIn: \"2026-07-01\", CheckOut: \"2026-07-02\", Guests: 0,\n\t})\n\twantCode(t, err, codes.InvalidArgument)\n}\n\n// ════════════════════════════════════════════════════════════════════════════\n// SetRatePlan\n// ════════════════════════════════════════════════════════════════════════════\n\n// Re-seeding overwrites the nightly rate.\nfunc TestSetRatePlan_Updates(t *testing.T) {\n\ts := server.NewServer()\n\tsetRatePlanOK(t, s, \"H1\", \"STD\", 10000)\n\tsetRatePlanOK(t, s, \"H1\", \"STD\", 20000)\n\tq, err := s.Quote(context.Background(), &pb.QuoteRequest{\n\t\tHotelId: \"H1\", RoomType: \"STD\", CheckIn: \"2026-07-01\", CheckOut: \"2026-07-02\", Guests: 1,\n\t})\n\tif err != nil {\n\t\tt.Fatalf(\"Quote: %v\", err)\n\t}\n\tif q.GetNightlyRate() != 20000 {\n\t\tt.Errorf(\"nightly_rate = %d, want 20000 (overwrite)\", q.GetNightlyRate())\n\t}\n}\n\n// Non-positive rate → InvalidArgument.\nfunc TestSetRatePlan_InvalidRate(t *testing.T) {\n\ts := server.NewServer()\n\tfor _, r := range []int64{0, -1} {\n\t\t_, err := s.SetRatePlan(context.Background(), &pb.SetRatePlanRequest{\n\t\t\tHotelId: \"H1\", RoomType: \"STD\", NightlyRate: r, Currency: \"USD\",\n\t\t})\n\t\twantCode(t, err, codes.InvalidArgument)\n\t}\n}\n\n// Empty hotel_id / room_type / currency → InvalidArgument.\nfunc TestSetRatePlan_EmptyFields(t *testing.T) {\n\ts := server.NewServer()\n\tcases := []*pb.SetRatePlanRequest{\n\t\t{HotelId: \"\", RoomType: \"STD\", NightlyRate: 100, Currency: \"USD\"},\n\t\t{HotelId: \"H1\", RoomType: \"\", NightlyRate: 100, Currency: \"USD\"},\n\t\t{HotelId: \"H1\", RoomType: \"STD\", NightlyRate: 100, Currency: \"\"},\n\t}\n\tfor _, req := range cases {\n\t\t_, err := s.SetRatePlan(context.Background(), req)\n\t\twantCode(t, err, codes.InvalidArgument)\n\t}\n}\n","numLines":196,"startLine":1,"totalLines":196}}}
