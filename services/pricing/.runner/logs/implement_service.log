fulStop()\n\n\tctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)\n\tdefer cancel()\n\tif err := httpServer.Shutdown(ctx); err != nil {\n\t\tlog.Printf(\"http shutdown: %v\", err)\n\t}\n}\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1866,"cache_read_input_tokens":31116,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1866},"output_tokens":4,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"fa1e0279-a5d4-465a-849e-8f3058d1794c","uuid":"8a3291b3-6365-40cc-bfd4-22cf0b930e4f","request_id":"req_011CbpcK3EC48vjyGxi5h19U"}
