utdown(ctx); err != nil {\n\t\tlog.Printf(\"http shutdown: %v\", err)\n\t}\n}\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1591,"cache_read_input_tokens":30103,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1591},"output_tokens":51,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"c7755ea5-d7f8-4871-95d0-19bff4eb0add","uuid":"6c67d71e-87ba-44ff-99ea-43e3b492b55b","request_id":"req_011CbpbQjAYahtqW64JYXVpD"}
