{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014mL5LnqwKFS4uh6VNhZSAq","type":"tool_result","content":"1\t// Unit tests for geo, derived from SPEC.yaml.\n2\t//\n3\t// What this service is:\n4\t//   geo answers \"hotels near (lat, lng) within radius_km\". v1 is in-memory:\n5\t//   hotels are seeded via UpsertHotel; Nearby does a haversine scan. Returns\n6\t//   hotel_ids within the radius.\n7\t//\n8\t// Test contract assumed about the implementation:\n9\t//   - `server.NewServer()` returns a *Server implementing pb.GeoServiceServer.\n10\t//   - Standard gRPC signatures; errors via google.golang.org/grpc/status with\n11\t//     the codes in SPEC.error_semantics.\n12\t//\n13\t// Distances used below rely on the fact that one degree of latitude is\n14\t// ~111 km. A hotel one degree of latitude away (~111 km) is outside a 50 km\n15\t// radius and inside a 200 km radius — robust to the exact haversine constant.\n16\t//\n17\t// Authored out-of-band and audited before the agent implements. The agent\n18\t// must not modify this file.\n19\t\n20\tpackage server_test\n21\t\n22\timport (\n23\t\t\"context\"\n24\t\t\"testing\"\n25\t\n26\t\tpb \"agentbench/services/geo/api/v1\"\n27\t\t\"agentbench/services/geo/internal/server\"\n28\t\n29\t\t\"google.golang.org/grpc/codes\"\n30\t\t\"google.golang.org/grpc/status\"\n31\t)\n32\t\n33\tfunc upsertOK(t *testing.T, s pb.GeoServiceServer, id string, lat, lng float64) {\n34\t\tt.Helper()\n35\t\tif _, err := s.UpsertHotel(context.Background(), &pb.UpsertHotelRequest{\n36\t\t\tHotelId: id, Lat: lat, Lng: lng,\n37\t\t}); err != nil {\n38\t\t\tt.Fatalf(\"UpsertHotel(%s): %v\", id, err)\n39\t\t}\n40\t}\n41\t\n42\tfunc nearby(t *testing.T, s pb.GeoServiceServer, lat, lng, radiusKm float64) []string {\n43\t\tt.Helper()\n44\t\tr, err := s.Nearby(context.Background(), &pb.NearbyRequest{Lat: lat, Lng: lng, RadiusKm: radiusKm})\n45\t\tif err != nil {\n46\t\t\tt.Fatalf(\"Nearby(%v,%v,%v): %v\", lat, lng, radiusKm, err)\n47\t\t}\n48\t\treturn r.GetHotelIds()\n49\t}\n50\t\n51\tfunc contains(ids []string, want string) bool {\n52\t\tfor _, id := range ids {\n53\t\t\tif id == want {\n54\t\t\t\treturn true\n55\t\t\t}\n56\t\t}\n57\t\treturn false\n58\t}\n59\t\n60\tfunc wantCode(t *testing.T, err error, want codes.Code) {\n61\t\tt.Helper()\n62\t\tif got := status.Code(err); got != want {\n63\t\t\tt.Errorf(\"status code = %v, want %v (err=%v)\", got, want, err)\n64\t\t}\n65\t}\n66\t\n67\t// ════════════════════════════════════════════════════════════════════════════\n68\t// Nearby\n69\t// ════════════════════════════════════════════════════════════════════════════\n70\t\n71\t// A hotel at the query point is well within any positive radius.\n72\tfunc TestNearby_IncludesColocated(t *testing.T) {\n73\t\ts := server.NewServer()\n74\t\tupsertOK(t, s, \"H1\", 0, 0)\n75\t\tif !contains(nearby(t, s, 0, 0, 10), \"H1\") {\n76\t\t\tt.Errorf(\"H1 at the query point should be within 10km\")\n77\t\t}\n78\t}\n79\t\n80\t// A hotel ~111 km north (one degree of latitude) is outside a 50 km radius\n81\t// and inside a 200 km radius.\n82\tfunc TestNearby_RadiusBoundary(t *testing.T) {\n83\t\ts := server.NewServer()\n84\t\tupsertOK(t, s, \"FAR\", 1.0, 0) // ~111 km from (0,0)\n85\t\n86\t\tif contains(nearby(t, s, 0, 0, 50), \"FAR\") {\n87\t\t\tt.Errorf(\"FAR (~111km) should be outside a 50km radius\")\n88\t\t}\n89\t\tif !contains(nearby(t, s, 0, 0, 200), \"FAR\") {\n90\t\t\tt.Errorf(\"FAR (~111km) should be inside a 200km radius\")\n91\t\t}\n92\t}\n93\t\n94\t// No seeded hotels → empty result, not an error.\n95\tfunc TestNearby_Empty(t *testing.T) {\n96\t\ts := server.NewServer()\n97\t\tif got := nearby(t, s, 0, 0, 100); len(got) != 0 {\n98\t\t\tt.Errorf(\"expected empty result, got %v\", got)\n99\t\t}\n100\t}\n101\t\n102\t// Re-upserting a hotel moves it: after moving H1 far away, it drops out of a\n103\t// small radius around its old location.\n104\tfunc TestUpsertHotel_Updates(t *testing.T) {\n105\t\ts := server.NewServer()\n106\t\tupsertOK(t, s, \"H1\", 0, 0)\n107\t\tupsertOK(t, s, \"H1\", 10, 10) // move ~1500 km away\n108\t\tif contains(nearby(t, s, 0, 0, 50), \"H1\") {\n109\t\t\tt.Errorf(\"H1 was moved away; should no longer be near (0,0)\")\n110\t\t}\n111\t}\n112\t\n113\t// Non-positive radius is InvalidArgument.\n114\tfunc TestNearby_InvalidRadius(t *testing.T) {\n115\t\ts := server.NewServer()\n116\t\tfor _, r := range []float64{0, -1} {\n117\t\t\t_, err := s.Nearby(context.Background(), &pb.NearbyRequest{Lat: 0, Lng: 0, RadiusKm: r})\n118\t\t\twantCode(t, err, codes.InvalidArgument)\n119\t\t}\n120\t}\n121\t\n122\t// Out-of-range query coordinates are InvalidArgument.\n123\tfunc TestNearby_InvalidCoords(t *testing.T) {\n124\t\ts := server.NewServer()\n125\t\t_, err := s.Nearby(context.Background(), &pb.NearbyRequest{Lat: 91, Lng: 0, RadiusKm: 10})\n126\t\twantCode(t, err, codes.InvalidArgument)\n127\t}\n128\t\n129\t// ════════════════════════════════════════════════════════════════════════════\n130\t// UpsertHotel\n131\t// ════════════════════════════════════════════════════════════════════════════\n132\t\n133\t// Empty hotel_id is InvalidArgument.\n134\tfunc TestUpsertHotel_EmptyID(t *testing.T) {\n135\t\ts := server.NewServer()\n136\t\t_, err := s.UpsertHotel(context.Background(), &pb.UpsertHotelRequest{HotelId: \"\", Lat: 0, Lng: 0})\n137\t\twantCode(t, err, codes.InvalidArgument)\n138\t}\n139\t\n140\t// Out-of-range coordinates are InvalidArgument.\n141\tfunc TestUpsertHotel_InvalidCoords(t *testing.T) {\n142\t\ts := server.NewServer()\n143\t\tcases := []struct{ lat, lng float64 }{\n144\t\t\t{91, 0}, {-91, 0}, {0, 181}, {0, -181},\n145\t\t}\n146\t\tfor _, c := range cases {\n147\t\t\t_, err := s.UpsertHotel(context.Background(), &pb.UpsertHotelRequest{\n148\t\t\t\tHotelId: \"H1\", Lat: c.lat, Lng: c.lng,\n149\t\t\t})\n150\t\t\twantCode(t, err, codes.InvalidArgument)\n151\t\t}\n152\t}\n153\t"}]},"parent_tool_use_id":null,"session_id":"c7755ea5-d7f8-4871-95d0-19bff4eb0add","uuid":"7f9909d7-2b8f-497f-b5f8-58df5b6d32f5","timestamp":"2026-06-07T21:16:05.135Z","tool_use_result":{"type":"text","file":{"filePath":"/home/leochanj/Desktop/agentbench/services/geo/internal/server/server_test.go","content":"// Unit tests for geo, derived from SPEC.yaml.\n//\n// What this service is:\n//   geo answers \"hotels near (lat, lng) within radius_km\". v1 is in-memory:\n//   hotels are seeded via UpsertHotel; Nearby does a haversine scan. Returns\n//   hotel_ids within the radius.\n//\n// Test contract assumed about the implementation:\n//   - `server.NewServer()` returns a *Server implementing pb.GeoServiceServer.\n//   - Standard gRPC signatures; errors via google.golang.org/grpc/status with\n//     the codes in SPEC.error_semantics.\n//\n// Distances used below rely on the fact that one degree of latitude is\n// ~111 km. A hotel one degree of latitude away (~111 km) is outside a 50 km\n// radius and inside a 200 km radius — robust to the exact haversine constant.\n//\n// Authored out-of-band and audited before the agent implements. The agent\n// must not modify this file.\n\npackage server_test\n\nimport (\n\t\"context\"\n\t\"testing\"\n\n\tpb \"agentbench/services/geo/api/v1\"\n\t\"agentbench/services/geo/internal/server\"\n\n\t\"google.golang.org/grpc/codes\"\n\t\"google.golang.org/grpc/status\"\n)\n\nfunc upsertOK(t *testing.T, s pb.GeoServiceServer, id string, lat, lng float64) {\n\tt.Helper()\n\tif _, err := s.UpsertHotel(context.Background(), &pb.UpsertHotelRequest{\n\t\tHotelId: id, Lat: lat, Lng: lng,\n\t}); err != nil {\n\t\tt.Fatalf(\"UpsertHotel(%s): %v\", id, err)\n\t}\n}\n\nfunc nearby(t *testing.T, s pb.GeoServiceServer, lat, lng, radiusKm float64) []string {\n\tt.Helper()\n\tr, err := s.Nearby(context.Background(), &pb.NearbyRequest{Lat: lat, Lng: lng, RadiusKm: radiusKm})\n\tif err != nil {\n\t\tt.Fatalf(\"Nearby(%v,%v,%v): %v\", lat, lng, radiusKm, err)\n\t}\n\treturn r.GetHotelIds()\n}\n\nfunc contains(ids []string, want string) bool {\n\tfor _, id := range ids {\n\t\tif id == want {\n\t\t\treturn true\n\t\t}\n\t}\n\treturn false\n}\n\nfunc wantCode(t *testing.T, err error, want codes.Code) {\n\tt.Helper()\n\tif got := status.Code(err); got != want {\n\t\tt.Errorf(\"status code = %v, want %v (err=%v)\", got, want, err)\n\t}\n}\n\n// ════════════════════════════════════════════════════════════════════════════\n// Nearby\n// ════════════════════════════════════════════════════════════════════════════\n\n// A hotel at the query point is well within any positive radius.\nfunc TestNearby_IncludesColocated(t *testing.T) {\n\ts := server.NewServer()\n\tupsertOK(t, s, \"H1\", 0, 0)\n\tif !contains(nearby(t, s, 0, 0, 10), \"H1\") {\n\t\tt.Errorf(\"H1 at the query point should be within 10km\")\n\t}\n}\n\n// A hotel ~111 km north (one degree of latitude) is outside a 50 km radius\n// and inside a 200 km radius.\nfunc TestNearby_RadiusBoundary(t *testing.T) {\n\ts := server.NewServer()\n\tupsertOK(t, s, \"FAR\", 1.0, 0) // ~111 km from (0,0)\n\n\tif contains(nearby(t, s, 0, 0, 50), \"FAR\") {\n\t\tt.Errorf(\"FAR (~111km) should be outside a 50km radius\")\n\t}\n\tif !contains(nearby(t, s, 0, 0, 200), \"FAR\") {\n\t\tt.Errorf(\"FAR (~111km) should be inside a 200km radius\")\n\t}\n}\n\n// No seeded hotels → empty result, not an error.\nfunc TestNearby_Empty(t *testing.T) {\n\ts := server.NewServer()\n\tif got := nearby(t, s, 0, 0, 100); len(got) != 0 {\n\t\tt.Errorf(\"expected empty result, got %v\", got)\n\t}\n}\n\n// Re-upserting a hotel moves it: after moving H1 far away, it drops out of a\n// small radius around its old location.\nfunc TestUpsertHotel_Updates(t *testing.T) {\n\ts := server.NewServer()\n\tupsertOK(t, s, \"H1\", 0, 0)\n\tupsertOK(t, s, \"H1\", 10, 10) // move ~1500 km away\n\tif contains(nearby(t, s, 0, 0, 50), \"H1\") {\n\t\tt.Errorf(\"H1 was moved away; should no longer be near (0,0)\")\n\t}\n}\n\n// Non-positive radius is InvalidArgument.\nfunc TestNearby_InvalidRadius(t *testing.T) {\n\ts := server.NewServer()\n\tfor _, r := range []float64{0, -1} {\n\t\t_, err := s.Nearby(context.Background(), &pb.NearbyRequest{Lat: 0, Lng: 0, RadiusKm: r})\n\t\twantCode(t, err, codes.InvalidArgument)\n\t}\n}\n\n// Out-of-range query coordinates are InvalidArgument.\nfunc TestNearby_InvalidCoords(t *testing.T) {\n\ts := server.NewServer()\n\t_, err := s.Nearby(context.Background(), &pb.NearbyRequest{Lat: 91, Lng: 0, RadiusKm: 10})\n\twantCode(t, err, codes.InvalidArgument)\n}\n\n// ════════════════════════════════════════════════════════════════════════════\n// UpsertHotel\n// ════════════════════════════════════════════════════════════════════════════\n\n// Empty hotel_id is InvalidArgument.\nfunc TestUpsertHotel_EmptyID(t *testing.T) {\n\ts := server.NewServer()\n\t_, err := s.UpsertHotel(context.Background(), &pb.UpsertHotelRequest{HotelId: \"\", Lat: 0, Lng: 0})\n\twantCode(t, err, codes.InvalidArgument)\n}\n\n// Out-of-range coordinates are InvalidArgument.\nfunc TestUpsertHotel_InvalidCoords(t *testing.T) {\n\ts := server.NewServer()\n\tcases := []struct{ lat, lng float64 }{\n\t\t{91, 0}, {-91, 0}, {0, 181}, {0, -181},\n\t}\n\tfor _, c := range cases {\n\t\t_, err := s.UpsertHotel(context.Background(), &pb.UpsertHotelRequest{\n\t\t\tHotelId: \"H1\", Lat: c.lat, Lng: c.lng,\n\t\t})\n\t\twantCode(t, err, codes.InvalidArgument)\n\t}\n}\n","numLines":153,"startLine":1,"totalLines":153}}}
