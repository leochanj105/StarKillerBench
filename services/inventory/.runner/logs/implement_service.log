{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016pPcKZAFnsEvAxFKxFDh3p","type":"tool_result","content":"1\t// Unit tests for inventory v2: Postgres-backed durability and concurrency.\n2\t//\n3\t// Audit surface for v2's added contract. These tests need a running\n4\t// Postgres reachable via PG_DSN; without it, they skip cleanly so that\n5\t// `go test ./...` in dev (or in the agent's sandbox, which has no docker)\n6\t// still passes. The integration compose stack provides Postgres; running\n7\t// `framework/scripts/run_integration` exports PG_DSN before exercising\n8\t// these tests.\n9\t//\n10\t// Kept separate from server_test.go (v1, in-memory) so each version's\n11\t// contract is reviewed in isolation. The agent must not modify either\n12\t// file.\n13\t//\n14\t// SPEC.yaml `state` and `dependencies` describe the schema and how the\n15\t// backend is wired up.\n16\t\n17\tpackage server_test\n18\t\n19\timport (\n20\t\t\"context\"\n21\t\t\"os\"\n22\t\t\"sync\"\n23\t\t\"sync/atomic\"\n24\t\t\"testing\"\n25\t\t\"time\"\n26\t\n27\t\tpb \"agentbench/services/inventory/api/v1\"\n28\t\t\"agentbench/services/inventory/internal/server\"\n29\t\t\"agentbench/services/inventory/internal/store\"\n30\t\n31\t\t\"google.golang.org/grpc/codes\"\n32\t\t\"google.golang.org/grpc/status\"\n33\t)\n34\t\n35\t// pgServers returns two Server instances both pointing at the same\n36\t// Postgres database, plus a teardown function. The two-server setup lets\n37\t// tests prove durability: state written through s1 must be observable\n38\t// through s2, even after s1's reference is dropped. Tests that don't\n39\t// need two are free to use only s1.\n40\t//\n41\t// Skips the test if PG_DSN is unset (dev loop, agent sandbox) so the\n42\t// whole file is no-op without infra. Tests use unique keys so they\n43\t// don't depend on table truncation between runs; if you want a clean\n44\t// slate, truncate manually outside the test.\n45\tfunc pgServers(t *testing.T) (s1, s2 *server.Server, done func()) {\n46\t\tt.Helper()\n47\t\tdsn := os.Getenv(\"PG_DSN\")\n48\t\tif dsn == \"\" {\n49\t\t\tt.Skip(\"PG_DSN not set; skipping Postgres-backed v2 test\")\n50\t\t}\n51\t\n52\t\tpg1, err := store.NewPGStore(context.Background(), dsn)\n53\t\tif err != nil {\n54\t\t\tt.Fatalf(\"connect pgStore #1: %v\", err)\n55\t\t}\n56\t\tpg2, err := store.NewPGStore(context.Background(), dsn)\n57\t\tif err != nil {\n58\t\t\tpg1.Close()\n59\t\t\tt.Fatalf(\"connect pgStore #2: %v\", err)\n60\t\t}\n61\t\treturn server.NewServerWithStore(pg1), server.NewServerWithStore(pg2), func() {\n62\t\t\tpg1.Close()\n63\t\t\tpg2.Close()\n64\t\t}\n65\t}\n66\t\n67\t// uniqKey returns a (hotel, room, date) triple unique to this test +\n68\t// invocation so concurrent test runs and re-runs don't collide on rows\n69\t// left behind in the Postgres tables.\n70\tfunc uniqKey(t *testing.T) (hotel, room, date string) {\n71\t\tt.Helper()\n72\t\tsuffix := time.Now().UnixNano()\n73\t\treturn t.Name(), \"STD\", time.Unix(0, suffix).UTC().Format(\"2006-01-02\")\n74\t}\n75\t\n76\t// ════════════════════════════════════════════════════════════════════════════\n77\t// Durability across \"service restart\"\n78\t//\n79\t// State written through one Server must be visible through a second\n80\t// Server pointing at the same database. Models a service restart: the\n81\t// first server's process effectively goes away (we just stop using it),\n82\t// the second server is a fresh process. If the implementation kept any\n83\t// state in process memory rather than Postgres, this test fails.\n84\t// ════════════════════════════════════════════════════════════════════════════\n85\tfunc TestV2_DurableAcrossRestart(t *testing.T) {\n86\t\ts1, s2, done := pgServers(t)\n87\t\tdefer done()\n88\t\tctx := context.Background()\n89\t\thotel, room, date := uniqKey(t)\n90\t\n91\t\t// Through s1: set stock and create a hold.\n92\t\tif _, err := s1.SetStock(ctx, &pb.SetStockRequest{\n93\t\t\tHotelId: hotel, RoomType: room, Date: date, Quantity: 3,\n94\t\t}); err != nil {\n95\t\t\tt.Fatalf(\"SetStock: %v\", err)\n96\t\t}\n97\t\th, err := s1.Hold(ctx, &pb.HoldRequest{\n98\t\t\tHotelId: hotel, RoomType: room, Date: date, Quantity: 2,\n99\t\t})\n100\t\tif err != nil {\n101\t\t\tt.Fatalf(\"Hold: %v\", err)\n102\t\t}\n103\t\n104\t\t// Through s2 (separate Server, same DB): Commit must succeed and the\n105\t\t// remaining 1 unit of stock must still be Hold-able.\n106\t\tif _, err := s2.Commit(ctx, &pb.CommitRequest{HoldId: h.GetHoldId()}); err != nil {\n107\t\t\tt.Fatalf(\"Commit on restored hold: %v\", err)\n108\t\t}\n109\t\tif _, err := s2.Hold(ctx, &pb.HoldRequest{\n110\t\t\tHotelId: hotel, RoomType: room, Date: date, Quantity: 1,\n111\t\t}); err != nil {\n112\t\t\tt.Errorf(\"Hold of remaining unit after restart: %v\", err)\n113\t\t}\n114\t}\n115\t\n116\t// ════════════════════════════════════════════════════════════════════════════\n117\t// Concurrent Hold against the last unit must not oversell\n118\t//\n119\t// Spins up N goroutines all trying to Hold the same final unit. Exactly\n120\t// one must succeed; the others must fail with FailedPrecondition (per\n121\t// SPEC's existing \"insufficient stock\" rule). If the backend forgets to\n122\t// take a row lock, more than one wins → oversell, and the test fails.\n123\t//\n124\t// This is the property that distinguishes a real durable store from the\n125\t// in-memory mutex-based memStore: with proper SELECT ... FOR UPDATE the\n126\t// transactions serialize cleanly; without it, race conditions slip\n127\t// through.\n128\t// ════════════════════════════════════════════════════════════════════════════\n129\tfunc TestV2_ConcurrentHold_NoOversell(t *testing.T) {\n130\t\ts1, _, done := pgServers(t)\n131\t\tdefer done()\n132\t\tctx := context.Background()\n133\t\thotel, room, date := uniqKey(t)\n134\t\n135\t\tif _, err := s1.SetStock(ctx, &pb.SetStockRequest{\n136\t\t\tHotelId: hotel, RoomType: room, Date: date, Quantity: 1,\n137\t\t}); err != nil {\n138\t\t\tt.Fatalf(\"SetStock: %v\", err)\n139\t\t}\n140\t\n141\t\tconst racers = 10\n142\t\tvar wg sync.WaitGroup\n143\t\tvar successes atomic.Int32\n144\t\tvar failedPrecondition atomic.Int32\n145\t\tvar otherErr atomic.Int32\n146\t\n147\t\twg.Add(racers)\n148\t\tfor i := 0; i < racers; i++ {\n149\t\t\tgo func() {\n150\t\t\t\tdefer wg.Done()\n151\t\t\t\t_, err := s1.Hold(ctx, &pb.HoldRequest{\n152\t\t\t\t\tHotelId: hotel, RoomType: room, Date: date, Quantity: 1,\n153\t\t\t\t})\n154\t\t\t\tswitch {\n155\t\t\t\tcase err == nil:\n156\t\t\t\t\tsuccesses.Add(1)\n157\t\t\t\tcase grpcCode(err) == codes.FailedPrecondition:\n158\t\t\t\t\tfailedPrecondition.Add(1)\n159\t\t\t\tdefault:\n160\t\t\t\t\totherErr.Add(1)\n161\t\t\t\t}\n162\t\t\t}()\n163\t\t}\n164\t\twg.Wait()\n165\t\n166\t\tif got := successes.Load(); got != 1 {\n167\t\t\tt.Errorf(\"expected exactly 1 successful Hold, got %d (oversell?)\", got)\n168\t\t}\n169\t\tif got := failedPrecondition.Load(); got != racers-1 {\n170\t\t\tt.Errorf(\"expected %d FailedPrecondition losers, got %d\", racers-1, got)\n171\t\t}\n172\t\tif got := otherErr.Load(); got != 0 {\n173\t\t\tt.Errorf(\"unexpected non-FailedPrecondition errors: %d\", got)\n174\t\t}\n175\t}\n176\t\n177\t// grpcCode is a small helper used by the concurrency test to\n178\t// classify a returned error. status.Code() already returns codes.OK\n179\t// for nil, so we pass through to it.\n180\tfunc grpcCode(err error) codes.Code { return status.Code(err) }\n181\t"}]},"parent_tool_use_id":null,"session_id":"0701114b-2a26-4485-80e2-fddd058a23c0","uuid":"4454843f-4435-46a7-8c65-da60453c3e03","timestamp":"2026-06-07T04:19:45.998Z","tool_use_result":{"type":"text","file":{"filePath":"/home/leochanj/Desktop/agentbench/services/inventory/internal/server/server_v2_test.go","content":"// Unit tests for inventory v2: Postgres-backed durability and concurrency.\n//\n// Audit surface for v2's added contract. These tests need a running\n// Postgres reachable via PG_DSN; without it, they skip cleanly so that\n// `go test ./...` in dev (or in the agent's sandbox, which has no docker)\n// still passes. The integration compose stack provides Postgres; running\n// `framework/scripts/run_integration` exports PG_DSN before exercising\n// these tests.\n//\n// Kept separate from server_test.go (v1, in-memory) so each version's\n// contract is reviewed in isolation. The agent must not modify either\n// file.\n//\n// SPEC.yaml `state` and `dependencies` describe the schema and how the\n// backend is wired up.\n\npackage server_test\n\nimport (\n\t\"context\"\n\t\"os\"\n\t\"sync\"\n\t\"sync/atomic\"\n\t\"testing\"\n\t\"time\"\n\n\tpb \"agentbench/services/inventory/api/v1\"\n\t\"agentbench/services/inventory/internal/server\"\n\t\"agentbench/services/inventory/internal/store\"\n\n\t\"google.golang.org/grpc/codes\"\n\t\"google.golang.org/grpc/status\"\n)\n\n// pgServers returns two Server instances both pointing at the same\n// Postgres database, plus a teardown function. The two-server setup lets\n// tests prove durability: state written through s1 must be observable\n// through s2, even after s1's reference is dropped. Tests that don't\n// need two are free to use only s1.\n//\n// Skips the test if PG_DSN is unset (dev loop, agent sandbox) so the\n// whole file is no-op without infra. Tests use unique keys so they\n// don't depend on table truncation between runs; if you want a clean\n// slate, truncate manually outside the test.\nfunc pgServers(t *testing.T) (s1, s2 *server.Server, done func()) {\n\tt.Helper()\n\tdsn := os.Getenv(\"PG_DSN\")\n\tif dsn == \"\" {\n\t\tt.Skip(\"PG_DSN not set; skipping Postgres-backed v2 test\")\n\t}\n\n\tpg1, err := store.NewPGStore(context.Background(), dsn)\n\tif err != nil {\n\t\tt.Fatalf(\"connect pgStore #1: %v\", err)\n\t}\n\tpg2, err := store.NewPGStore(context.Background(), dsn)\n\tif err != nil {\n\t\tpg1.Close()\n\t\tt.Fatalf(\"connect pgStore #2: %v\", err)\n\t}\n\treturn server.NewServerWithStore(pg1), server.NewServerWithStore(pg2), func() {\n\t\tpg1.Close()\n\t\tpg2.Close()\n\t}\n}\n\n// uniqKey returns a (hotel, room, date) triple unique to this test +\n// invocation so concurrent test runs and re-runs don't collide on rows\n// left behind in the Postgres tables.\nfunc uniqKey(t *testing.T) (hotel, room, date string) {\n\tt.Helper()\n\tsuffix := time.Now().UnixNano()\n\treturn t.Name(), \"STD\", time.Unix(0, suffix).UTC().Format(\"2006-01-02\")\n}\n\n// ════════════════════════════════════════════════════════════════════════════\n// Durability across \"service restart\"\n//\n// State written through one Server must be visible through a second\n// Server pointing at the same database. Models a service restart: the\n// first server's process effectively goes away (we just stop using it),\n// the second server is a fresh process. If the implementation kept any\n// state in process memory rather than Postgres, this test fails.\n// ════════════════════════════════════════════════════════════════════════════\nfunc TestV2_DurableAcrossRestart(t *testing.T) {\n\ts1, s2, done := pgServers(t)\n\tdefer done()\n\tctx := context.Background()\n\thotel, room, date := uniqKey(t)\n\n\t// Through s1: set stock and create a hold.\n\tif _, err := s1.SetStock(ctx, &pb.SetStockRequest{\n\t\tHotelId: hotel, RoomType: room, Date: date, Quantity: 3,\n\t}); err != nil {\n\t\tt.Fatalf(\"SetStock: %v\", err)\n\t}\n\th, err := s1.Hold(ctx, &pb.HoldRequest{\n\t\tHotelId: hotel, RoomType: room, Date: date, Quantity: 2,\n\t})\n\tif err != nil {\n\t\tt.Fatalf(\"Hold: %v\", err)\n\t}\n\n\t// Through s2 (separate Server, same DB): Commit must succeed and the\n\t// remaining 1 unit of stock must still be Hold-able.\n\tif _, err := s2.Commit(ctx, &pb.CommitRequest{HoldId: h.GetHoldId()}); err != nil {\n\t\tt.Fatalf(\"Commit on restored hold: %v\", err)\n\t}\n\tif _, err := s2.Hold(ctx, &pb.HoldRequest{\n\t\tHotelId: hotel, RoomType: room, Date: date, Quantity: 1,\n\t}); err != nil {\n\t\tt.Errorf(\"Hold of remaining unit after restart: %v\", err)\n\t}\n}\n\n// ════════════════════════════════════════════════════════════════════════════\n// Concurrent Hold against the last unit must not oversell\n//\n// Spins up N goroutines all trying to Hold the same final unit. Exactly\n// one must succeed; the others must fail with FailedPrecondition (per\n// SPEC's existing \"insufficient stock\" rule). If the backend forgets to\n// take a row lock, more than one wins → oversell, and the test fails.\n//\n// This is the property that distinguishes a real durable store from the\n// in-memory mutex-based memStore: with proper SELECT ... FOR UPDATE the\n// transactions serialize cleanly; without it, race conditions slip\n// through.\n// ════════════════════════════════════════════════════════════════════════════\nfunc TestV2_ConcurrentHold_NoOversell(t *testing.T) {\n\ts1, _, done := pgServers(t)\n\tdefer done()\n\tctx := context.Background()\n\thotel, room, date := uniqKey(t)\n\n\tif _, err := s1.SetStock(ctx, &pb.SetStockRequest{\n\t\tHotelId: hotel, RoomType: room, Date: date, Quantity: 1,\n\t}); err != nil {\n\t\tt.Fatalf(\"SetStock: %v\", err)\n\t}\n\n\tconst racers = 10\n\tvar wg sync.WaitGroup\n\tvar successes atomic.Int32\n\tvar failedPrecondition atomic.Int32\n\tvar otherErr atomic.Int32\n\n\twg.Add(racers)\n\tfor i := 0; i < racers; i++ {\n\t\tgo func() {\n\t\t\tdefer wg.Done()\n\t\t\t_, err := s1.Hold(ctx, &pb.HoldRequest{\n\t\t\t\tHotelId: hotel, RoomType: room, Date: date, Quantity: 1,\n\t\t\t})\n\t\t\tswitch {\n\t\t\tcase err == nil:\n\t\t\t\tsuccesses.Add(1)\n\t\t\tcase grpcCode(err) == codes.FailedPrecondition:\n\t\t\t\tfailedPrecondition.Add(1)\n\t\t\tdefault:\n\t\t\t\totherErr.Add(1)\n\t\t\t}\n\t\t}()\n\t}\n\twg.Wait()\n\n\tif got := successes.Load(); got != 1 {\n\t\tt.Errorf(\"expected exactly 1 successful Hold, got %d (oversell?)\", got)\n\t}\n\tif got := failedPrecondition.Load(); got != racers-1 {\n\t\tt.Errorf(\"expected %d FailedPrecondition losers, got %d\", racers-1, got)\n\t}\n\tif got := otherErr.Load(); got != 0 {\n\t\tt.Errorf(\"unexpected non-FailedPrecondition errors: %d\", got)\n\t}\n}\n\n// grpcCode is a small helper used by the concurrency test to\n// classify a returned error. status.Code() already returns codes.OK\n// for nil, so we pass through to it.\nfunc grpcCode(err error) codes.Code { return status.Code(err) }\n","numLines":181,"startLine":1,"totalLines":181}}}
