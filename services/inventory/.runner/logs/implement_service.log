{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01KspnXEwUjCPeXBc4AzU9Mz","type":"tool_result","content":"1\t// Unit tests for inventory v3: ReturnStock — the post-commit undo that\n2\t// returns a sold unit to availability when a confirmed booking is\n3\t// cancelled.\n4\t//\n5\t// These run against the in-memory backend (server.NewServer()), so they\n6\t// need no Postgres — same as the v1 tests. The ReturnStock contract is\n7\t// backend-agnostic; the durable backend must present identical behavior.\n8\t//\n9\t// Kept separate from server_test.go (v1) and server_v2_test.go (Postgres)\n10\t// so each version's contract is reviewed in isolation. The agent must not\n11\t// modify any of these files.\n12\t//\n13\t// SPEC.yaml `interface.ReturnStock` and its `error_semantics` are the\n14\t// contract pinned here.\n15\t\n16\tpackage server_test\n17\t\n18\timport (\n19\t\t\"context\"\n20\t\t\"testing\"\n21\t\n22\t\tpb \"agentbench/services/inventory/api/v1\"\n23\t\t\"agentbench/services/inventory/internal/server\"\n24\t\n25\t\t\"google.golang.org/grpc/codes\"\n26\t)\n27\t\n28\t// commitOne sets up `total` stock, holds `qty`, and commits it, leaving\n29\t// sold=qty. Returns nothing — callers assert via subsequent Hold/ReturnStock.\n30\tfunc commitOne(t *testing.T, s pb.InventoryServiceServer, hotel, room, date string, total, qty int32) {\n31\t\tt.Helper()\n32\t\tsetStockOK(t, s, hotel, room, date, total)\n33\t\tid := holdOK(t, s, hotel, room, date, qty)\n34\t\tif _, err := s.Commit(context.Background(), &pb.CommitRequest{HoldId: id}); err != nil {\n35\t\t\tt.Fatalf(\"Commit: %v\", err)\n36\t\t}\n37\t}\n38\t\n39\t// ════════════════════════════════════════════════════════════════════════════\n40\t// ReturnStock happy path\n41\t//\n42\t// After a Commit, sold is reduced and the units become available again:\n43\t// set total=2, sell 2 (available 0), ReturnStock 1 → available 1, so a\n44\t// Hold of 1 now succeeds and a Hold of 2 does not.\n45\t// ════════════════════════════════════════════════════════════════════════════\n46\tfunc TestReturnStock_RestoresAvailability(t *testing.T) {\n47\t\ts := server.NewServer()\n48\t\tctx := context.Background()\n49\t\tcommitOne(t, s, \"H1\", \"STD\", \"2026-08-01\", 2, 2) // sold=2, available=0\n50\t\n51\t\tif _, err := s.ReturnStock(ctx, &pb.ReturnStockRequest{\n52\t\t\tHotelId: \"H1\", RoomType: \"STD\", Date: \"2026-08-01\", Quantity: 1,\n53\t\t}); err != nil {\n54\t\t\tt.Fatalf(\"ReturnStock: %v\", err)\n55\t\t}\n56\t\n57\t\t// One unit back: Hold(1) works.\n58\t\tif _, err := s.Hold(ctx, &pb.HoldRequest{\n59\t\t\tHotelId: \"H1\", RoomType: \"STD\", Date: \"2026-08-01\", Quantity: 1,\n60\t\t}); err != nil {\n61\t\t\tt.Errorf(\"Hold(1) after ReturnStock should succeed: %v\", err)\n62\t\t}\n63\t\t// But only one came back: Hold of another 1 (total available now 0) fails.\n64\t\t_, err := s.Hold(ctx, &pb.HoldRequest{\n65\t\t\tHotelId: \"H1\", RoomType: \"STD\", Date: \"2026-08-01\", Quantity: 1,\n66\t\t})\n67\t\twantCode(t, err, codes.FailedPrecondition)\n68\t}\n69\t\n70\t// ReturnStock with non-positive quantity is InvalidArgument.\n71\tfunc TestReturnStock_InvalidQuantity(t *testing.T) {\n72\t\ts := server.NewServer()\n73\t\tcommitOne(t, s, \"H1\", \"STD\", \"2026-08-01\", 2, 1)\n74\t\tfor _, q := range []int32{0, -1} {\n75\t\t\t_, err := s.ReturnStock(context.Background(), &pb.ReturnStockRequest{\n76\t\t\t\tHotelId: \"H1\", RoomType: \"STD\", Date: \"2026-08-01\", Quantity: q,\n77\t\t\t})\n78\t\t\twantCode(t, err, codes.InvalidArgument)\n79\t\t}\n80\t}\n81\t\n82\t// ReturnStock for a (hotel, room, date) with no stock record is NotFound.\n83\tfunc TestReturnStock_NotFound(t *testing.T) {\n84\t\ts := server.NewServer()\n85\t\t_, err := s.ReturnStock(context.Background(), &pb.ReturnStockRequest{\n86\t\t\tHotelId: \"nope\", RoomType: \"STD\", Date: \"2026-08-01\", Quantity: 1,\n87\t\t})\n88\t\twantCode(t, err, codes.NotFound)\n89\t}\n90\t\n91\t// ReturnStock for more than is currently sold is FailedPrecondition — you\n92\t// can't un-sell units that were never sold. Here sold=1 but we try to\n93\t// return 2.\n94\tfunc TestReturnStock_ExceedsSold(t *testing.T) {\n95\t\ts := server.NewServer()\n96\t\tcommitOne(t, s, \"H1\", \"STD\", \"2026-08-01\", 3, 1) // sold=1\n97\t\t_, err := s.ReturnStock(context.Background(), &pb.ReturnStockRequest{\n98\t\t\tHotelId: \"H1\", RoomType: \"STD\", Date: \"2026-08-01\", Quantity: 2,\n99\t\t})\n100\t\twantCode(t, err, codes.FailedPrecondition)\n101\t}\n102\t"}]},"parent_tool_use_id":null,"session_id":"0701114b-2a26-4485-80e2-fddd058a23c0","uuid":"5b313249-b082-4216-a4b0-ce82a2c5d0a9","timestamp":"2026-06-07T04:19:48.682Z","tool_use_result":{"type":"text","file":{"filePath":"/home/leochanj/Desktop/agentbench/services/inventory/internal/server/server_v3_test.go","content":"// Unit tests for inventory v3: ReturnStock — the post-commit undo that\n// returns a sold unit to availability when a confirmed booking is\n// cancelled.\n//\n// These run against the in-memory backend (server.NewServer()), so they\n// need no Postgres — same as the v1 tests. The ReturnStock contract is\n// backend-agnostic; the durable backend must present identical behavior.\n//\n// Kept separate from server_test.go (v1) and server_v2_test.go (Postgres)\n// so each version's contract is reviewed in isolation. The agent must not\n// modify any of these files.\n//\n// SPEC.yaml `interface.ReturnStock` and its `error_semantics` are the\n// contract pinned here.\n\npackage server_test\n\nimport (\n\t\"context\"\n\t\"testing\"\n\n\tpb \"agentbench/services/inventory/api/v1\"\n\t\"agentbench/services/inventory/internal/server\"\n\n\t\"google.golang.org/grpc/codes\"\n)\n\n// commitOne sets up `total` stock, holds `qty`, and commits it, leaving\n// sold=qty. Returns nothing — callers assert via subsequent Hold/ReturnStock.\nfunc commitOne(t *testing.T, s pb.InventoryServiceServer, hotel, room, date string, total, qty int32) {\n\tt.Helper()\n\tsetStockOK(t, s, hotel, room, date, total)\n\tid := holdOK(t, s, hotel, room, date, qty)\n\tif _, err := s.Commit(context.Background(), &pb.CommitRequest{HoldId: id}); err != nil {\n\t\tt.Fatalf(\"Commit: %v\", err)\n\t}\n}\n\n// ════════════════════════════════════════════════════════════════════════════\n// ReturnStock happy path\n//\n// After a Commit, sold is reduced and the units become available again:\n// set total=2, sell 2 (available 0), ReturnStock 1 → available 1, so a\n// Hold of 1 now succeeds and a Hold of 2 does not.\n// ════════════════════════════════════════════════════════════════════════════\nfunc TestReturnStock_RestoresAvailability(t *testing.T) {\n\ts := server.NewServer()\n\tctx := context.Background()\n\tcommitOne(t, s, \"H1\", \"STD\", \"2026-08-01\", 2, 2) // sold=2, available=0\n\n\tif _, err := s.ReturnStock(ctx, &pb.ReturnStockRequest{\n\t\tHotelId: \"H1\", RoomType: \"STD\", Date: \"2026-08-01\", Quantity: 1,\n\t}); err != nil {\n\t\tt.Fatalf(\"ReturnStock: %v\", err)\n\t}\n\n\t// One unit back: Hold(1) works.\n\tif _, err := s.Hold(ctx, &pb.HoldRequest{\n\t\tHotelId: \"H1\", RoomType: \"STD\", Date: \"2026-08-01\", Quantity: 1,\n\t}); err != nil {\n\t\tt.Errorf(\"Hold(1) after ReturnStock should succeed: %v\", err)\n\t}\n\t// But only one came back: Hold of another 1 (total available now 0) fails.\n\t_, err := s.Hold(ctx, &pb.HoldRequest{\n\t\tHotelId: \"H1\", RoomType: \"STD\", Date: \"2026-08-01\", Quantity: 1,\n\t})\n\twantCode(t, err, codes.FailedPrecondition)\n}\n\n// ReturnStock with non-positive quantity is InvalidArgument.\nfunc TestReturnStock_InvalidQuantity(t *testing.T) {\n\ts := server.NewServer()\n\tcommitOne(t, s, \"H1\", \"STD\", \"2026-08-01\", 2, 1)\n\tfor _, q := range []int32{0, -1} {\n\t\t_, err := s.ReturnStock(context.Background(), &pb.ReturnStockRequest{\n\t\t\tHotelId: \"H1\", RoomType: \"STD\", Date: \"2026-08-01\", Quantity: q,\n\t\t})\n\t\twantCode(t, err, codes.InvalidArgument)\n\t}\n}\n\n// ReturnStock for a (hotel, room, date) with no stock record is NotFound.\nfunc TestReturnStock_NotFound(t *testing.T) {\n\ts := server.NewServer()\n\t_, err := s.ReturnStock(context.Background(), &pb.ReturnStockRequest{\n\t\tHotelId: \"nope\", RoomType: \"STD\", Date: \"2026-08-01\", Quantity: 1,\n\t})\n\twantCode(t, err, codes.NotFound)\n}\n\n// ReturnStock for more than is currently sold is FailedPrecondition — you\n// can't un-sell units that were never sold. Here sold=1 but we try to\n// return 2.\nfunc TestReturnStock_ExceedsSold(t *testing.T) {\n\ts := server.NewServer()\n\tcommitOne(t, s, \"H1\", \"STD\", \"2026-08-01\", 3, 1) // sold=1\n\t_, err := s.ReturnStock(context.Background(), &pb.ReturnStockRequest{\n\t\tHotelId: \"H1\", RoomType: \"STD\", Date: \"2026-08-01\", Quantity: 2,\n\t})\n\twantCode(t, err, codes.FailedPrecondition)\n}\n","numLines":102,"startLine":1,"totalLines":102}}}
