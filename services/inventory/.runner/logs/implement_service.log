{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Sd7zMWn6VLivPbfdZhBPQw","type":"tool_result","content":"1\tpackage store\n2\t\n3\timport (\n4\t\t\"context\"\n5\t\t\"fmt\"\n6\t\t\"sync\"\n7\t)\n8\t\n9\ttype stockRecord struct {\n10\t\ttotal int32\n11\t\tsold  int32\n12\t\theld  int32\n13\t}\n14\t\n15\ttype holdRecord struct {\n16\t\tstockKey string\n17\t\tquantity int32\n18\t\tstatus   string\n19\t}\n20\t\n21\t// memStore is the in-memory backend. A single mutex serializes all\n22\t// operations, which is sufficient to prevent oversell for the v1 contract.\n23\ttype memStore struct {\n24\t\tmu    sync.Mutex\n25\t\tstock map[string]*stockRecord\n26\t\tholds map[string]*holdRecord\n27\t}\n28\t\n29\t// NewMemStore returns an empty in-memory Store.\n30\tfunc NewMemStore() Store {\n31\t\treturn &memStore{\n32\t\t\tstock: make(map[string]*stockRecord),\n33\t\t\tholds: make(map[string]*holdRecord),\n34\t\t}\n35\t}\n36\t\n37\tfunc memKey(hotel, room, date string) string {\n38\t\treturn fmt.Sprintf(\"%s|%s|%s\", hotel, room, date)\n39\t}\n40\t\n41\tfunc (m *memStore) SetStock(_ context.Context, hotel, room, date string, quantity int32) error {\n42\t\tkey := memKey(hotel, room, date)\n43\t\tm.mu.Lock()\n44\t\tdefer m.mu.Unlock()\n45\t\n46\t\tif rec, ok := m.stock[key]; ok {\n47\t\t\trec.total = quantity\n48\t\t} else {\n49\t\t\tm.stock[key] = &stockRecord{total: quantity}\n50\t\t}\n51\t\treturn nil\n52\t}\n53\t\n54\tfunc (m *memStore) Hold(_ context.Context, hotel, room, date string, quantity int32) (string, error) {\n55\t\tkey := memKey(hotel, room, date)\n56\t\tm.mu.Lock()\n57\t\tdefer m.mu.Unlock()\n58\t\n59\t\trec, ok := m.stock[key]\n60\t\tif !ok {\n61\t\t\treturn \"\", ErrNotFound\n62\t\t}\n63\t\tif rec.total-rec.sold-rec.held < quantity {\n64\t\t\treturn \"\", ErrInsufficient\n65\t\t}\n66\t\trec.held += quantity\n67\t\n68\t\tid := newHoldID()\n69\t\tm.holds[id] = &holdRecord{stockKey: key, quantity: quantity, status: statusHeld}\n70\t\treturn id, nil\n71\t}\n72\t\n73\tfunc (m *memStore) Commit(_ context.Context, holdID string) error {\n74\t\tm.mu.Lock()\n75\t\tdefer m.mu.Unlock()\n76\t\n77\t\th, ok := m.holds[holdID]\n78\t\tif !ok {\n79\t\t\treturn ErrNotFound\n80\t\t}\n81\t\tif h.status != statusHeld {\n82\t\t\treturn ErrConsumed\n83\t\t}\n84\t\trec := m.stock[h.stockKey]\n85\t\trec.held -= h.quantity\n86\t\trec.sold += h.quantity\n87\t\th.status = statusCommitted\n88\t\treturn nil\n89\t}\n90\t\n91\tfunc (m *memStore) Release(_ context.Context, holdID string) error {\n92\t\tm.mu.Lock()\n93\t\tdefer m.mu.Unlock()\n94\t\n95\t\th, ok := m.holds[holdID]\n96\t\tif !ok {\n97\t\t\treturn ErrNotFound\n98\t\t}\n99\t\tif h.status != statusHeld {\n100\t\t\treturn ErrConsumed\n101\t\t}\n102\t\trec := m.stock[h.stockKey]\n103\t\trec.held -= h.quantity\n104\t\th.status = statusReleased\n105\t\treturn nil\n106\t}\n107\t\n108\tfunc (m *memStore) Close() {}\n109\t"}]},"parent_tool_use_id":null,"session_id":"0701114b-2a26-4485-80e2-fddd058a23c0","uuid":"8a9a3fa5-29cb-4ca4-bb4f-67f5225a8041","timestamp":"2026-06-07T04:19:55.423Z","tool_use_result":{"type":"text","file":{"filePath":"/home/leochanj/Desktop/agentbench/services/inventory/internal/store/mem.go","content":"package store\n\nimport (\n\t\"context\"\n\t\"fmt\"\n\t\"sync\"\n)\n\ntype stockRecord struct {\n\ttotal int32\n\tsold  int32\n\theld  int32\n}\n\ntype holdRecord struct {\n\tstockKey string\n\tquantity int32\n\tstatus   string\n}\n\n// memStore is the in-memory backend. A single mutex serializes all\n// operations, which is sufficient to prevent oversell for the v1 contract.\ntype memStore struct {\n\tmu    sync.Mutex\n\tstock map[string]*stockRecord\n\tholds map[string]*holdRecord\n}\n\n// NewMemStore returns an empty in-memory Store.\nfunc NewMemStore() Store {\n\treturn &memStore{\n\t\tstock: make(map[string]*stockRecord),\n\t\tholds: make(map[string]*holdRecord),\n\t}\n}\n\nfunc memKey(hotel, room, date string) string {\n\treturn fmt.Sprintf(\"%s|%s|%s\", hotel, room, date)\n}\n\nfunc (m *memStore) SetStock(_ context.Context, hotel, room, date string, quantity int32) error {\n\tkey := memKey(hotel, room, date)\n\tm.mu.Lock()\n\tdefer m.mu.Unlock()\n\n\tif rec, ok := m.stock[key]; ok {\n\t\trec.total = quantity\n\t} else {\n\t\tm.stock[key] = &stockRecord{total: quantity}\n\t}\n\treturn nil\n}\n\nfunc (m *memStore) Hold(_ context.Context, hotel, room, date string, quantity int32) (string, error) {\n\tkey := memKey(hotel, room, date)\n\tm.mu.Lock()\n\tdefer m.mu.Unlock()\n\n\trec, ok := m.stock[key]\n\tif !ok {\n\t\treturn \"\", ErrNotFound\n\t}\n\tif rec.total-rec.sold-rec.held < quantity {\n\t\treturn \"\", ErrInsufficient\n\t}\n\trec.held += quantity\n\n\tid := newHoldID()\n\tm.holds[id] = &holdRecord{stockKey: key, quantity: quantity, status: statusHeld}\n\treturn id, nil\n}\n\nfunc (m *memStore) Commit(_ context.Context, holdID string) error {\n\tm.mu.Lock()\n\tdefer m.mu.Unlock()\n\n\th, ok := m.holds[holdID]\n\tif !ok {\n\t\treturn ErrNotFound\n\t}\n\tif h.status != statusHeld {\n\t\treturn ErrConsumed\n\t}\n\trec := m.stock[h.stockKey]\n\trec.held -= h.quantity\n\trec.sold += h.quantity\n\th.status = statusCommitted\n\treturn nil\n}\n\nfunc (m *memStore) Release(_ context.Context, holdID string) error {\n\tm.mu.Lock()\n\tdefer m.mu.Unlock()\n\n\th, ok := m.holds[holdID]\n\tif !ok {\n\t\treturn ErrNotFound\n\t}\n\tif h.status != statusHeld {\n\t\treturn ErrConsumed\n\t}\n\trec := m.stock[h.stockKey]\n\trec.held -= h.quantity\n\th.status = statusReleased\n\treturn nil\n}\n\nfunc (m *memStore) Close() {}\n","numLines":109,"startLine":1,"totalLines":109}}}
