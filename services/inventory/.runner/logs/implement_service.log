{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0195PvSSBCRTrVKMx2tPqFPv","type":"tool_result","content":"1\tpackage server\n2\t\n3\timport (\n4\t\t\"context\"\n5\t\t\"errors\"\n6\t\n7\t\tpb \"agentbench/services/inventory/api/v1\"\n8\t\t\"agentbench/services/inventory/internal/store\"\n9\t\n10\t\t\"google.golang.org/grpc/codes\"\n11\t\t\"google.golang.org/grpc/status\"\n12\t)\n13\t\n14\t// Server implements pb.InventoryServiceServer. It validates request shapes,\n15\t// delegates state changes to a Store, and maps the store's sentinel errors\n16\t// to gRPC status codes per SPEC.error_semantics.\n17\ttype Server struct {\n18\t\tpb.UnimplementedInventoryServiceServer\n19\t\n20\t\tstore store.Store\n21\t}\n22\t\n23\t// NewServer returns a Server backed by the in-memory store (v1 default;\n24\t// used by unit tests and local dev without Postgres).\n25\tfunc NewServer() *Server {\n26\t\treturn &Server{store: store.NewMemStore()}\n27\t}\n28\t\n29\t// NewServerWithStore returns a Server backed by the given store (used to\n30\t// wire the Postgres backend in v2).\n31\tfunc NewServerWithStore(s store.Store) *Server {\n32\t\treturn &Server{store: s}\n33\t}\n34\t\n35\t// mapErr translates store sentinel errors to gRPC status errors.\n36\tfunc mapErr(err error) error {\n37\t\tswitch {\n38\t\tcase err == nil:\n39\t\t\treturn nil\n40\t\tcase errors.Is(err, store.ErrNotFound):\n41\t\t\treturn status.Error(codes.NotFound, err.Error())\n42\t\tcase errors.Is(err, store.ErrInsufficient):\n43\t\t\treturn status.Error(codes.FailedPrecondition, err.Error())\n44\t\tcase errors.Is(err, store.ErrConsumed):\n45\t\t\treturn status.Error(codes.FailedPrecondition, err.Error())\n46\t\tdefault:\n47\t\t\treturn status.Error(codes.Internal, err.Error())\n48\t\t}\n49\t}\n50\t\n51\tfunc (s *Server) SetStock(ctx context.Context, req *pb.SetStockRequest) (*pb.SetStockResponse, error) {\n52\t\tif req.GetQuantity() < 0 {\n53\t\t\treturn nil, status.Error(codes.InvalidArgument, \"quantity must be non-negative\")\n54\t\t}\n55\t\tif err := s.store.SetStock(ctx, req.GetHotelId(), req.GetRoomType(), req.GetDate(), req.GetQuantity()); err != nil {\n56\t\t\treturn nil, mapErr(err)\n57\t\t}\n58\t\treturn &pb.SetStockResponse{}, nil\n59\t}\n60\t\n61\tfunc (s *Server) Hold(ctx context.Context, req *pb.HoldRequest) (*pb.HoldResponse, error) {\n62\t\tif req.GetQuantity() <= 0 {\n63\t\t\treturn nil, status.Error(codes.InvalidArgument, \"quantity must be positive\")\n64\t\t}\n65\t\tid, err := s.store.Hold(ctx, req.GetHotelId(), req.GetRoomType(), req.GetDate(), req.GetQuantity())\n66\t\tif err != nil {\n67\t\t\treturn nil, mapErr(err)\n68\t\t}\n69\t\treturn &pb.HoldResponse{HoldId: id}, nil\n70\t}\n71\t\n72\tfunc (s *Server) Commit(ctx context.Context, req *pb.CommitRequest) (*pb.CommitResponse, error) {\n73\t\tif err := s.store.Commit(ctx, req.GetHoldId()); err != nil {\n74\t\t\treturn nil, mapErr(err)\n75\t\t}\n76\t\treturn &pb.CommitResponse{}, nil\n77\t}\n78\t\n79\tfunc (s *Server) Release(ctx context.Context, req *pb.ReleaseRequest) (*pb.ReleaseResponse, error) {\n80\t\tif err := s.store.Release(ctx, req.GetHoldId()); err != nil {\n81\t\t\treturn nil, mapErr(err)\n82\t\t}\n83\t\treturn &pb.ReleaseResponse{}, nil\n84\t}\n85\t"}]},"parent_tool_use_id":null,"session_id":"0701114b-2a26-4485-80e2-fddd058a23c0","uuid":"12bfd2a2-ceb2-4b80-a1bd-4d5d1de8250a","timestamp":"2026-06-07T04:20:04.233Z","tool_use_result":{"type":"text","file":{"filePath":"/home/leochanj/Desktop/agentbench/services/inventory/internal/server/server.go","content":"package server\n\nimport (\n\t\"context\"\n\t\"errors\"\n\n\tpb \"agentbench/services/inventory/api/v1\"\n\t\"agentbench/services/inventory/internal/store\"\n\n\t\"google.golang.org/grpc/codes\"\n\t\"google.golang.org/grpc/status\"\n)\n\n// Server implements pb.InventoryServiceServer. It validates request shapes,\n// delegates state changes to a Store, and maps the store's sentinel errors\n// to gRPC status codes per SPEC.error_semantics.\ntype Server struct {\n\tpb.UnimplementedInventoryServiceServer\n\n\tstore store.Store\n}\n\n// NewServer returns a Server backed by the in-memory store (v1 default;\n// used by unit tests and local dev without Postgres).\nfunc NewServer() *Server {\n\treturn &Server{store: store.NewMemStore()}\n}\n\n// NewServerWithStore returns a Server backed by the given store (used to\n// wire the Postgres backend in v2).\nfunc NewServerWithStore(s store.Store) *Server {\n\treturn &Server{store: s}\n}\n\n// mapErr translates store sentinel errors to gRPC status errors.\nfunc mapErr(err error) error {\n\tswitch {\n\tcase err == nil:\n\t\treturn nil\n\tcase errors.Is(err, store.ErrNotFound):\n\t\treturn status.Error(codes.NotFound, err.Error())\n\tcase errors.Is(err, store.ErrInsufficient):\n\t\treturn status.Error(codes.FailedPrecondition, err.Error())\n\tcase errors.Is(err, store.ErrConsumed):\n\t\treturn status.Error(codes.FailedPrecondition, err.Error())\n\tdefault:\n\t\treturn status.Error(codes.Internal, err.Error())\n\t}\n}\n\nfunc (s *Server) SetStock(ctx context.Context, req *pb.SetStockRequest) (*pb.SetStockResponse, error) {\n\tif req.GetQuantity() < 0 {\n\t\treturn nil, status.Error(codes.InvalidArgument, \"quantity must be non-negative\")\n\t}\n\tif err := s.store.SetStock(ctx, req.GetHotelId(), req.GetRoomType(), req.GetDate(), req.GetQuantity()); err != nil {\n\t\treturn nil, mapErr(err)\n\t}\n\treturn &pb.SetStockResponse{}, nil\n}\n\nfunc (s *Server) Hold(ctx context.Context, req *pb.HoldRequest) (*pb.HoldResponse, error) {\n\tif req.GetQuantity() <= 0 {\n\t\treturn nil, status.Error(codes.InvalidArgument, \"quantity must be positive\")\n\t}\n\tid, err := s.store.Hold(ctx, req.GetHotelId(), req.GetRoomType(), req.GetDate(), req.GetQuantity())\n\tif err != nil {\n\t\treturn nil, mapErr(err)\n\t}\n\treturn &pb.HoldResponse{HoldId: id}, nil\n}\n\nfunc (s *Server) Commit(ctx context.Context, req *pb.CommitRequest) (*pb.CommitResponse, error) {\n\tif err := s.store.Commit(ctx, req.GetHoldId()); err != nil {\n\t\treturn nil, mapErr(err)\n\t}\n\treturn &pb.CommitResponse{}, nil\n}\n\nfunc (s *Server) Release(ctx context.Context, req *pb.ReleaseRequest) (*pb.ReleaseResponse, error) {\n\tif err := s.store.Release(ctx, req.GetHoldId()); err != nil {\n\t\treturn nil, mapErr(err)\n\t}\n\treturn &pb.ReleaseResponse{}, nil\n}\n","numLines":85,"startLine":1,"totalLines":85}}}
