{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016LZ3r411nXv6zoXzHb15Vo","type":"tool_result","content":"1\t// Package store holds the inventory persistence layer behind a single\n2\t// Store interface. Two implementations exist:\n3\t//\n4\t//   - memStore: in-memory, per-process. Used by v1 unit tests and by local\n5\t//     dev when PG_DSN is unset.\n6\t//   - PGStore: Postgres-backed, durable, with row-level locking so\n7\t//     concurrent Holds for the same key serialize and never oversell.\n8\t//\n9\t// The server validates request shapes and maps the sentinel errors below\n10\t// to gRPC status codes; the store itself is gRPC-agnostic.\n11\tpackage store\n12\t\n13\timport (\n14\t\t\"context\"\n15\t\t\"crypto/rand\"\n16\t\t\"encoding/hex\"\n17\t\t\"errors\"\n18\t)\n19\t\n20\t// Sentinel errors returned by Store implementations. The server maps these\n21\t// to gRPC codes (NotFound, FailedPrecondition).\n22\tvar (\n23\t\t// ErrNotFound: no stock record for the (hotel, room_type, date) key, or\n24\t\t// no hold for the given hold_id.\n25\t\tErrNotFound = errors.New(\"not found\")\n26\t\t// ErrInsufficient: available stock (total - sold - held) is less than\n27\t\t// the requested quantity.\n28\t\tErrInsufficient = errors.New(\"insufficient stock\")\n29\t\t// ErrConsumed: the hold has already been committed or released.\n30\t\tErrConsumed = errors.New(\"hold already consumed\")\n31\t)\n32\t\n33\t// Store is the persistence contract for inventory. Implementations must\n34\t// serialize concurrent Holds against the same key so that the available\n35\t// count never goes negative (no oversell).\n36\ttype Store interface {\n37\t\t// SetStock sets the total for one key, preserving sold and held.\n38\t\t// quantity is assumed non-negative (validated by the caller).\n39\t\tSetStock(ctx context.Context, hotel, room, date string, quantity int32) error\n40\t\t// Hold reserves quantity units and returns an opaque hold_id.\n41\t\t// quantity is assumed positive (validated by the caller).\n42\t\tHold(ctx context.Context, hotel, room, date string, quantity int32) (holdID string, err error)\n43\t\t// Commit converts a held reservation to sold and consumes the hold.\n44\t\tCommit(ctx context.Context, holdID string) error\n45\t\t// Release returns a held reservation to available and consumes the hold.\n46\t\tRelease(ctx context.Context, holdID string) error\n47\t\t// Close releases any resources held by the store.\n48\t\tClose()\n49\t}\n50\t\n51\t// Hold lifecycle statuses, persisted in the holds store.\n52\tconst (\n53\t\tstatusHeld      = \"held\"\n54\t\tstatusCommitted = \"committed\"\n55\t\tstatusReleased  = \"released\"\n56\t)\n57\t\n58\t// newHoldID returns an opaque, unguessable hold identifier.\n59\tfunc newHoldID() string {\n60\t\tvar b [16]byte\n61\t\tif _, err := rand.Read(b[:]); err != nil {\n62\t\t\tpanic(err)\n63\t\t}\n64\t\treturn hex.EncodeToString(b[:])\n65\t}\n66\t"}]},"parent_tool_use_id":null,"session_id":"0701114b-2a26-4485-80e2-fddd058a23c0","uuid":"6bc0c6c4-753f-47c7-8d70-8998f9c21587","timestamp":"2026-06-07T04:19:51.836Z","tool_use_result":{"type":"text","file":{"filePath":"/home/leochanj/Desktop/agentbench/services/inventory/internal/store/store.go","content":"// Package store holds the inventory persistence layer behind a single\n// Store interface. Two implementations exist:\n//\n//   - memStore: in-memory, per-process. Used by v1 unit tests and by local\n//     dev when PG_DSN is unset.\n//   - PGStore: Postgres-backed, durable, with row-level locking so\n//     concurrent Holds for the same key serialize and never oversell.\n//\n// The server validates request shapes and maps the sentinel errors below\n// to gRPC status codes; the store itself is gRPC-agnostic.\npackage store\n\nimport (\n\t\"context\"\n\t\"crypto/rand\"\n\t\"encoding/hex\"\n\t\"errors\"\n)\n\n// Sentinel errors returned by Store implementations. The server maps these\n// to gRPC codes (NotFound, FailedPrecondition).\nvar (\n\t// ErrNotFound: no stock record for the (hotel, room_type, date) key, or\n\t// no hold for the given hold_id.\n\tErrNotFound = errors.New(\"not found\")\n\t// ErrInsufficient: available stock (total - sold - held) is less than\n\t// the requested quantity.\n\tErrInsufficient = errors.New(\"insufficient stock\")\n\t// ErrConsumed: the hold has already been committed or released.\n\tErrConsumed = errors.New(\"hold already consumed\")\n)\n\n// Store is the persistence contract for inventory. Implementations must\n// serialize concurrent Holds against the same key so that the available\n// count never goes negative (no oversell).\ntype Store interface {\n\t// SetStock sets the total for one key, preserving sold and held.\n\t// quantity is assumed non-negative (validated by the caller).\n\tSetStock(ctx context.Context, hotel, room, date string, quantity int32) error\n\t// Hold reserves quantity units and returns an opaque hold_id.\n\t// quantity is assumed positive (validated by the caller).\n\tHold(ctx context.Context, hotel, room, date string, quantity int32) (holdID string, err error)\n\t// Commit converts a held reservation to sold and consumes the hold.\n\tCommit(ctx context.Context, holdID string) error\n\t// Release returns a held reservation to available and consumes the hold.\n\tRelease(ctx context.Context, holdID string) error\n\t// Close releases any resources held by the store.\n\tClose()\n}\n\n// Hold lifecycle statuses, persisted in the holds store.\nconst (\n\tstatusHeld      = \"held\"\n\tstatusCommitted = \"committed\"\n\tstatusReleased  = \"released\"\n)\n\n// newHoldID returns an opaque, unguessable hold identifier.\nfunc newHoldID() string {\n\tvar b [16]byte\n\tif _, err := rand.Read(b[:]); err != nil {\n\t\tpanic(err)\n\t}\n\treturn hex.EncodeToString(b[:])\n}\n","numLines":66,"startLine":1,"totalLines":66}}}
