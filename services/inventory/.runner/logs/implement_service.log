{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015V6mDxQ2zvT1YEPw7Qy9YL","type":"tool_result","content":"1\t// Unit tests for inventory, derived from SPEC.yaml.\n2\t//\n3\t// What this service is:\n4\t//   inventory tracks per-(hotel, room_type, date) room stock. Admin sets\n5\t//   total via SetStock; bookings Hold to reserve, then Commit (sale done)\n6\t//   or Release (cancel before commit). State is in-memory.\n7\t//\n8\t// Test contract assumed about the implementation:\n9\t//   - `server.NewServer()` returns a *Server implementing pb.InventoryServiceServer.\n10\t//   - Methods have standard gRPC signatures.\n11\t//   - Errors via google.golang.org/grpc/status with the codes in SPEC.error_semantics.\n12\t\n13\tpackage server_test\n14\t\n15\timport (\n16\t\t\"context\"\n17\t\t\"testing\"\n18\t\n19\t\tpb \"agentbench/services/inventory/internal/genpb/v1\"\n20\t\t\"agentbench/services/inventory/internal/server\"\n21\t\n22\t\t\"google.golang.org/grpc/codes\"\n23\t\t\"google.golang.org/grpc/status\"\n24\t)\n25\t\n26\t// setStockOK calls SetStock and fails the test on error. Used to populate\n27\t// inventory before testing Hold/Commit/Release flows.\n28\tfunc setStockOK(t *testing.T, s pb.InventoryServiceServer, hotel, room, date string, qty int32) {\n29\t\tt.Helper()\n30\t\t_, err := s.SetStock(context.Background(), &pb.SetStockRequest{\n31\t\t\tHotelId: hotel, RoomType: room, Date: date, Quantity: qty,\n32\t\t})\n33\t\tif err != nil {\n34\t\t\tt.Fatalf(\"SetStock(%s/%s/%s, %d): %v\", hotel, room, date, qty, err)\n35\t\t}\n36\t}\n37\t\n38\t// holdOK calls Hold and returns the hold_id; fails the test on error.\n39\tfunc holdOK(t *testing.T, s pb.InventoryServiceServer, hotel, room, date string, qty int32) string {\n40\t\tt.Helper()\n41\t\tr, err := s.Hold(context.Background(), &pb.HoldRequest{\n42\t\t\tHotelId: hotel, RoomType: room, Date: date, Quantity: qty,\n43\t\t})\n44\t\tif err != nil {\n45\t\t\tt.Fatalf(\"Hold: %v\", err)\n46\t\t}\n47\t\treturn r.GetHoldId()\n48\t}\n49\t\n50\tfunc wantCode(t *testing.T, err error, want codes.Code) {\n51\t\tt.Helper()\n52\t\tif got := status.Code(err); got != want {\n53\t\t\tt.Errorf(\"status code = %v, want %v (err=%v)\", got, want, err)\n54\t\t}\n55\t}\n56\t\n57\t// ════════════════════════════════════════════════════════════════════════════\n58\t// SetStock\n59\t// ════════════════════════════════════════════════════════════════════════════\n60\t\n61\t// SetStock with valid inputs succeeds and a subsequent Hold against that\n62\t// (hotel, room_type, date) key works.\n63\tfunc TestSetStock_Happy(t *testing.T) {\n64\t\ts := server.NewServer()\n65\t\tsetStockOK(t, s, \"H1\", \"STD\", \"2025-01-01\", 5)\n66\t\tif _, err := s.Hold(context.Background(), &pb.HoldRequest{\n67\t\t\tHotelId: \"H1\", RoomType: \"STD\", Date: \"2025-01-01\", Quantity: 1,\n68\t\t}); err != nil {\n69\t\t\tt.Errorf(\"Hold after SetStock: %v\", err)\n70\t\t}\n71\t}\n72\t\n73\t// SetStock rejects negative quantity with InvalidArgument.\n74\tfunc TestSetStock_InvalidArgument(t *testing.T) {\n75\t\ts := server.NewServer()\n76\t\t_, err := s.SetStock(context.Background(), &pb.SetStockRequest{\n77\t\t\tHotelId: \"H1\", RoomType: \"STD\", Date: \"2025-01-01\", Quantity: -1,\n78\t\t})\n79\t\twantCode(t, err, codes.InvalidArgument)\n80\t}\n81\t\n82\t// ════════════════════════════════════════════════════════════════════════════\n83\t// Hold\n84\t// ════════════════════════════════════════════════════════════════════════════\n85\t\n86\t// Hold against existing stock returns a non-empty hold_id.\n87\tfunc TestHold_ReturnsNonEmptyID(t *testing.T) {\n88\t\ts := server.NewServer()\n89\t\tsetStockOK(t, s, \"H1\", \"STD\", \"2025-01-01\", 5)\n90\t\tif id := holdOK(t, s, \"H1\", \"STD\", \"2025-01-01\", 1); id == \"\" {\n91\t\t\tt.Errorf(\"hold_id empty\")\n92\t\t}\n93\t}\n94\t\n95\t// Two Holds against the same key get different hold_ids.\n96\tfunc TestHold_DistinctIDs(t *testing.T) {\n97\t\ts := server.NewServer()\n98\t\tsetStockOK(t, s, \"H1\", \"STD\", \"2025-01-01\", 5)\n99\t\ta := holdOK(t, s, \"H1\", \"STD\", \"2025-01-01\", 1)\n100\t\tb := holdOK(t, s, \"H1\", \"STD\", \"2025-01-01\", 1)\n101\t\tif a == b {\n102\t\t\tt.Errorf(\"two Holds returned the same hold_id: %q\", a)\n103\t\t}\n104\t}\n105\t\n106\t// Hold for a (hotel, room_type, date) with no SetStock record returns NotFound.\n107\tfunc TestHold_NotFound(t *testing.T) {\n108\t\ts := server.NewServer()\n109\t\t_, err := s.Hold(context.Background(), &pb.HoldRequest{\n110\t\t\tHotelId: \"H1\", RoomType: \"STD\", Date: \"2025-01-01\", Quantity: 1,\n111\t\t})\n112\t\twantCode(t, err, codes.NotFound)\n113\t}\n114\t\n115\t// Hold exceeding available stock returns FailedPrecondition.\n116\tfunc TestHold_InsufficientStock(t *testing.T) {\n117\t\ts := server.NewServer()\n118\t\tsetStockOK(t, s, \"H1\", \"STD\", \"2025-01-01\", 2)\n119\t\tholdOK(t, s, \"H1\", \"STD\", \"2025-01-01\", 2) // exhaust the 2 units\n120\t\t_, err := s.Hold(context.Background(), &pb.HoldRequest{\n121\t\t\tHotelId: \"H1\", RoomType: \"STD\", Date: \"2025-01-01\", Quantity: 1,\n122\t\t})\n123\t\twantCode(t, err, codes.FailedPrecondition)\n124\t}\n125\t\n126\t// Hold with non-positive quantity returns InvalidArgument.\n127\tfunc TestHold_InvalidQuantity(t *testing.T) {\n128\t\ts := server.NewServer()\n129\t\tsetStockOK(t, s, \"H1\", \"STD\", \"2025-01-01\", 5)\n130\t\tcases := []struct {\n131\t\t\tname string\n132\t\t\tqty  int32\n133\t\t}{\n134\t\t\t{\"zero\", 0},\n135\t\t\t{\"negative\", -1},\n136\t\t}\n137\t\tfor _, tc := range cases {\n138\t\t\tt.Run(tc.name, func(t *testing.T) {\n139\t\t\t\t_, err := s.Hold(context.Background(), &pb.HoldRequest{\n140\t\t\t\t\tHotelId: \"H1\", RoomType: \"STD\", Date: \"2025-01-01\", Quantity: tc.qty,\n141\t\t\t\t})\n142\t\t\t\twantCode(t, err, codes.InvalidArgument)\n143\t\t\t})\n144\t\t}\n145\t}\n146\t\n147\t// ════════════════════════════════════════════════════════════════════════════\n148\t// Commit\n149\t// ════════════════════════════════════════════════════════════════════════════\n150\t\n151\t// Commit on an active hold succeeds and consumes the hold.\n152\tfunc TestCommit_Happy(t *testing.T) {\n153\t\ts := server.NewServer()\n154\t\tsetStockOK(t, s, \"H1\", \"STD\", \"2025-01-01\", 5)\n155\t\tid := holdOK(t, s, \"H1\", \"STD\", \"2025-01-01\", 2)\n156\t\tif _, err := s.Commit(context.Background(), &pb.CommitRequest{HoldId: id}); err != nil {\n157\t\t\tt.Errorf(\"Commit: %v\", err)\n158\t\t}\n159\t}\n160\t\n161\t// After Commit, the held quantity becomes sold — total available stays\n162\t// reduced by that quantity, exactly as if the hold were never released.\n163\tfunc TestCommit_ReducesAvailability(t *testing.T) {\n164\t\ts := server.NewServer()\n165\t\tsetStockOK(t, s, \"H1\", \"STD\", \"2025-01-01\", 2)\n166\t\tid := holdOK(t, s, \"H1\", \"STD\", \"2025-01-01\", 2)\n167\t\tif _, err := s.Commit(context.Background(), &pb.CommitRequest{HoldId: id}); err != nil {\n168\t\t\tt.Fatalf(\"Commit: %v\", err)\n169\t\t}\n170\t\t// available was 0 (all held); after Commit, still 0 (all sold).\n171\t\t_, err := s.Hold(context.Background(), &pb.HoldRequest{\n172\t\t\tHotelId: \"H1\", RoomType: \"STD\", Date: \"2025-01-01\", Quantity: 1,\n173\t\t})\n174\t\twantCode(t, err, codes.FailedPrecondition)\n175\t}\n176\t\n177\t// Commit with an unknown hold_id returns NotFound.\n178\tfunc TestCommit_NotFound(t *testing.T) {\n179\t\ts := server.NewServer()\n180\t\t_, err := s.Commit(context.Background(), &pb.CommitRequest{HoldId: \"unknown\"})\n181\t\twantCode(t, err, codes.NotFound)\n182\t}\n183\t\n184\t// Commit on an already-consumed hold (already committed) returns FailedPrecondition.\n185\tfunc TestCommit_AlreadyConsumed(t *testing.T) {\n186\t\ts := server.NewServer()\n187\t\tsetStockOK(t, s, \"H1\", \"STD\", \"2025-01-01\", 5)\n188\t\tid := holdOK(t, s, \"H1\", \"STD\", \"2025-01-01\", 1)\n189\t\tif _, err := s.Commit(context.Background(), &pb.CommitRequest{HoldId: id}); err != nil {\n190\t\t\tt.Fatalf(\"first Commit: %v\", err)\n191\t\t}\n192\t\t_, err := s.Commit(context.Background(), &pb.CommitRequest{HoldId: id})\n193\t\twantCode(t, err, codes.FailedPrecondition)\n194\t}\n195\t\n196\t// ════════════════════════════════════════════════════════════════════════════\n197\t// Release\n198\t// ════════════════════════════════════════════════════════════════════════════\n199\t\n200\t// Release on an active hold succeeds and returns the units to available.\n201\tfunc TestRelease_Happy(t *testing.T) {\n202\t\ts := server.NewServer()\n203\t\tsetStockOK(t, s, \"H1\", \"STD\", \"2025-01-01\", 2)\n204\t\tid := holdOK(t, s, \"H1\", \"STD\", \"2025-01-01\", 2)\n205\t\tif _, err := s.Release(context.Background(), &pb.ReleaseRequest{HoldId: id}); err != nil {\n206\t\t\tt.Fatalf(\"Release: %v\", err)\n207\t\t}\n208\t\t// After Release, the 2 units are back in available.\n209\t\tif _, err := s.Hold(context.Background(), &pb.HoldRequest{\n210\t\t\tHotelId: \"H1\", RoomType: \"STD\", Date: \"2025-01-01\", Quantity: 2,\n211\t\t}); err != nil {\n212\t\t\tt.Errorf(\"re-Hold after Release: %v\", err)\n213\t\t}\n214\t}\n215\t\n216\t// Release with unknown hold_id returns NotFound.\n217\tfunc TestRelease_NotFound(t *testing.T) {\n218\t\ts := server.NewServer()\n219\t\t_, err := s.Release(context.Background(), &pb.ReleaseRequest{HoldId: \"unknown\"})\n220\t\twantCode(t, err, codes.NotFound)\n221\t}\n222\t\n223\t// Release on already-consumed hold (committed before) returns FailedPrecondition.\n224\tfunc TestRelease_AlreadyCommitted(t *testing.T) {\n225\t\ts := server.NewServer()\n226\t\tsetStockOK(t, s, \"H1\", \"STD\", \"2025-01-01\", 5)\n227\t\tid := holdOK(t, s, \"H1\", \"STD\", \"2025-01-01\", 1)\n228\t\tif _, err := s.Commit(context.Background(), &pb.CommitRequest{HoldId: id}); err != nil {\n229\t\t\tt.Fatalf(\"Commit: %v\", err)\n230\t\t}\n231\t\t_, err := s.Release(context.Background(), &pb.ReleaseRequest{HoldId: id})\n232\t\twantCode(t, err, codes.FailedPrecondition)\n233\t}\n234\t"}]},"parent_tool_use_id":null,"session_id":"b5992286-4ce0-42fb-a372-df5c3c4130f4","uuid":"b5e4a398-131f-4964-a43a-c35573146d1a","timestamp":"2026-05-21T14:41:23.198Z","tool_use_result":{"type":"text","file":{"filePath":"/home/leochanj/Desktop/agentbench/services/inventory/internal/server/server_test.go","content":"// Unit tests for inventory, derived from SPEC.yaml.\n//\n// What this service is:\n//   inventory tracks per-(hotel, room_type, date) room stock. Admin sets\n//   total via SetStock; bookings Hold to reserve, then Commit (sale done)\n//   or Release (cancel before commit). State is in-memory.\n//\n// Test contract assumed about the implementation:\n//   - `server.NewServer()` returns a *Server implementing pb.InventoryServiceServer.\n//   - Methods have standard gRPC signatures.\n//   - Errors via google.golang.org/grpc/status with the codes in SPEC.error_semantics.\n\npackage server_test\n\nimport (\n\t\"context\"\n\t\"testing\"\n\n\tpb \"agentbench/services/inventory/internal/genpb/v1\"\n\t\"agentbench/services/inventory/internal/server\"\n\n\t\"google.golang.org/grpc/codes\"\n\t\"google.golang.org/grpc/status\"\n)\n\n// setStockOK calls SetStock and fails the test on error. Used to populate\n// inventory before testing Hold/Commit/Release flows.\nfunc setStockOK(t *testing.T, s pb.InventoryServiceServer, hotel, room, date string, qty int32) {\n\tt.Helper()\n\t_, err := s.SetStock(context.Background(), &pb.SetStockRequest{\n\t\tHotelId: hotel, RoomType: room, Date: date, Quantity: qty,\n\t})\n\tif err != nil {\n\t\tt.Fatalf(\"SetStock(%s/%s/%s, %d): %v\", hotel, room, date, qty, err)\n\t}\n}\n\n// holdOK calls Hold and returns the hold_id; fails the test on error.\nfunc holdOK(t *testing.T, s pb.InventoryServiceServer, hotel, room, date string, qty int32) string {\n\tt.Helper()\n\tr, err := s.Hold(context.Background(), &pb.HoldRequest{\n\t\tHotelId: hotel, RoomType: room, Date: date, Quantity: qty,\n\t})\n\tif err != nil {\n\t\tt.Fatalf(\"Hold: %v\", err)\n\t}\n\treturn r.GetHoldId()\n}\n\nfunc wantCode(t *testing.T, err error, want codes.Code) {\n\tt.Helper()\n\tif got := status.Code(err); got != want {\n\t\tt.Errorf(\"status code = %v, want %v (err=%v)\", got, want, err)\n\t}\n}\n\n// ════════════════════════════════════════════════════════════════════════════\n// SetStock\n// ════════════════════════════════════════════════════════════════════════════\n\n// SetStock with valid inputs succeeds and a subsequent Hold against that\n// (hotel, room_type, date) key works.\nfunc TestSetStock_Happy(t *testing.T) {\n\ts := server.NewServer()\n\tsetStockOK(t, s, \"H1\", \"STD\", \"2025-01-01\", 5)\n\tif _, err := s.Hold(context.Background(), &pb.HoldRequest{\n\t\tHotelId: \"H1\", RoomType: \"STD\", Date: \"2025-01-01\", Quantity: 1,\n\t}); err != nil {\n\t\tt.Errorf(\"Hold after SetStock: %v\", err)\n\t}\n}\n\n// SetStock rejects negative quantity with InvalidArgument.\nfunc TestSetStock_InvalidArgument(t *testing.T) {\n\ts := server.NewServer()\n\t_, err := s.SetStock(context.Background(), &pb.SetStockRequest{\n\t\tHotelId: \"H1\", RoomType: \"STD\", Date: \"2025-01-01\", Quantity: -1,\n\t})\n\twantCode(t, err, codes.InvalidArgument)\n}\n\n// ════════════════════════════════════════════════════════════════════════════\n// Hold\n// ════════════════════════════════════════════════════════════════════════════\n\n// Hold against existing stock returns a non-empty hold_id.\nfunc TestHold_ReturnsNonEmptyID(t *testing.T) {\n\ts := server.NewServer()\n\tsetStockOK(t, s, \"H1\", \"STD\", \"2025-01-01\", 5)\n\tif id := holdOK(t, s, \"H1\", \"STD\", \"2025-01-01\", 1); id == \"\" {\n\t\tt.Errorf(\"hold_id empty\")\n\t}\n}\n\n// Two Holds against the same key get different hold_ids.\nfunc TestHold_DistinctIDs(t *testing.T) {\n\ts := server.NewServer()\n\tsetStockOK(t, s, \"H1\", \"STD\", \"2025-01-01\", 5)\n\ta := holdOK(t, s, \"H1\", \"STD\", \"2025-01-01\", 1)\n\tb := holdOK(t, s, \"H1\", \"STD\", \"2025-01-01\", 1)\n\tif a == b {\n\t\tt.Errorf(\"two Holds returned the same hold_id: %q\", a)\n\t}\n}\n\n// Hold for a (hotel, room_type, date) with no SetStock record returns NotFound.\nfunc TestHold_NotFound(t *testing.T) {\n\ts := server.NewServer()\n\t_, err := s.Hold(context.Background(), &pb.HoldRequest{\n\t\tHotelId: \"H1\", RoomType: \"STD\", Date: \"2025-01-01\", Quantity: 1,\n\t})\n\twantCode(t, err, codes.NotFound)\n}\n\n// Hold exceeding available stock returns FailedPrecondition.\nfunc TestHold_InsufficientStock(t *testing.T) {\n\ts := server.NewServer()\n\tsetStockOK(t, s, \"H1\", \"STD\", \"2025-01-01\", 2)\n\tholdOK(t, s, \"H1\", \"STD\", \"2025-01-01\", 2) // exhaust the 2 units\n\t_, err := s.Hold(context.Background(), &pb.HoldRequest{\n\t\tHotelId: \"H1\", RoomType: \"STD\", Date: \"2025-01-01\", Quantity: 1,\n\t})\n\twantCode(t, err, codes.FailedPrecondition)\n}\n\n// Hold with non-positive quantity returns InvalidArgument.\nfunc TestHold_InvalidQuantity(t *testing.T) {\n\ts := server.NewServer()\n\tsetStockOK(t, s, \"H1\", \"STD\", \"2025-01-01\", 5)\n\tcases := []struct {\n\t\tname string\n\t\tqty  int32\n\t}{\n\t\t{\"zero\", 0},\n\t\t{\"negative\", -1},\n\t}\n\tfor _, tc := range cases {\n\t\tt.Run(tc.name, func(t *testing.T) {\n\t\t\t_, err := s.Hold(context.Background(), &pb.HoldRequest{\n\t\t\t\tHotelId: \"H1\", RoomType: \"STD\", Date: \"2025-01-01\", Quantity: tc.qty,\n\t\t\t})\n\t\t\twantCode(t, err, codes.InvalidArgument)\n\t\t})\n\t}\n}\n\n// ════════════════════════════════════════════════════════════════════════════\n// Commit\n// ════════════════════════════════════════════════════════════════════════════\n\n// Commit on an active hold succeeds and consumes the hold.\nfunc TestCommit_Happy(t *testing.T) {\n\ts := server.NewServer()\n\tsetStockOK(t, s, \"H1\", \"STD\", \"2025-01-01\", 5)\n\tid := holdOK(t, s, \"H1\", \"STD\", \"2025-01-01\", 2)\n\tif _, err := s.Commit(context.Background(), &pb.CommitRequest{HoldId: id}); err != nil {\n\t\tt.Errorf(\"Commit: %v\", err)\n\t}\n}\n\n// After Commit, the held quantity becomes sold — total available stays\n// reduced by that quantity, exactly as if the hold were never released.\nfunc TestCommit_ReducesAvailability(t *testing.T) {\n\ts := server.NewServer()\n\tsetStockOK(t, s, \"H1\", \"STD\", \"2025-01-01\", 2)\n\tid := holdOK(t, s, \"H1\", \"STD\", \"2025-01-01\", 2)\n\tif _, err := s.Commit(context.Background(), &pb.CommitRequest{HoldId: id}); err != nil {\n\t\tt.Fatalf(\"Commit: %v\", err)\n\t}\n\t// available was 0 (all held); after Commit, still 0 (all sold).\n\t_, err := s.Hold(context.Background(), &pb.HoldRequest{\n\t\tHotelId: \"H1\", RoomType: \"STD\", Date: \"2025-01-01\", Quantity: 1,\n\t})\n\twantCode(t, err, codes.FailedPrecondition)\n}\n\n// Commit with an unknown hold_id returns NotFound.\nfunc TestCommit_NotFound(t *testing.T) {\n\ts := server.NewServer()\n\t_, err := s.Commit(context.Background(), &pb.CommitRequest{HoldId: \"unknown\"})\n\twantCode(t, err, codes.NotFound)\n}\n\n// Commit on an already-consumed hold (already committed) returns FailedPrecondition.\nfunc TestCommit_AlreadyConsumed(t *testing.T) {\n\ts := server.NewServer()\n\tsetStockOK(t, s, \"H1\", \"STD\", \"2025-01-01\", 5)\n\tid := holdOK(t, s, \"H1\", \"STD\", \"2025-01-01\", 1)\n\tif _, err := s.Commit(context.Background(), &pb.CommitRequest{HoldId: id}); err != nil {\n\t\tt.Fatalf(\"first Commit: %v\", err)\n\t}\n\t_, err := s.Commit(context.Background(), &pb.CommitRequest{HoldId: id})\n\twantCode(t, err, codes.FailedPrecondition)\n}\n\n// ════════════════════════════════════════════════════════════════════════════\n// Release\n// ════════════════════════════════════════════════════════════════════════════\n\n// Release on an active hold succeeds and returns the units to available.\nfunc TestRelease_Happy(t *testing.T) {\n\ts := server.NewServer()\n\tsetStockOK(t, s, \"H1\", \"STD\", \"2025-01-01\", 2)\n\tid := holdOK(t, s, \"H1\", \"STD\", \"2025-01-01\", 2)\n\tif _, err := s.Release(context.Background(), &pb.ReleaseRequest{HoldId: id}); err != nil {\n\t\tt.Fatalf(\"Release: %v\", err)\n\t}\n\t// After Release, the 2 units are back in available.\n\tif _, err := s.Hold(context.Background(), &pb.HoldRequest{\n\t\tHotelId: \"H1\", RoomType: \"STD\", Date: \"2025-01-01\", Quantity: 2,\n\t}); err != nil {\n\t\tt.Errorf(\"re-Hold after Release: %v\", err)\n\t}\n}\n\n// Release with unknown hold_id returns NotFound.\nfunc TestRelease_NotFound(t *testing.T) {\n\ts := server.NewServer()\n\t_, err := s.Release(context.Background(), &pb.ReleaseRequest{HoldId: \"unknown\"})\n\twantCode(t, err, codes.NotFound)\n}\n\n// Release on already-consumed hold (committed before) returns FailedPrecondition.\nfunc TestRelease_AlreadyCommitted(t *testing.T) {\n\ts := server.NewServer()\n\tsetStockOK(t, s, \"H1\", \"STD\", \"2025-01-01\", 5)\n\tid := holdOK(t, s, \"H1\", \"STD\", \"2025-01-01\", 1)\n\tif _, err := s.Commit(context.Background(), &pb.CommitRequest{HoldId: id}); err != nil {\n\t\tt.Fatalf(\"Commit: %v\", err)\n\t}\n\t_, err := s.Release(context.Background(), &pb.ReleaseRequest{HoldId: id})\n\twantCode(t, err, codes.FailedPrecondition)\n}\n","numLines":234,"startLine":1,"totalLines":234}}}
