\tdefer cancel()\n\tif err := httpServer.Shutdown(ctx); err != nil {\n\t\tlog.Printf(\"http shutdown: %v\", err)\n\t}\n}\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1822,"cache_read_input_tokens":30125,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1822},"output_tokens":54,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"638ba876-3bd3-4bc5-a57e-b44d21a85ad0","uuid":"9acc5719-91d3-4db6-8666-185d64a0f587","request_id":"req_011CbqGDF6L2dVDAuBhMaBXV"}
