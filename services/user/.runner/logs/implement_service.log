{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Qmv9BC47zzDjNykMuKWEAP","type":"tool_result","content":"1\t// Unit tests for user, derived from SPEC.yaml.\n2\t//\n3\t// What this service is:\n4\t//   user owns preferences + a loyalty points balance. v1 is in-memory. The\n5\t//   load-bearing behavior is AccrueOnBooking: a read-modify-write on the\n6\t//   balance that must serialize concurrent accruals for the same user.\n7\t//\n8\t// Test contract assumed about the implementation:\n9\t//   - `server.NewServer()` returns a *Server implementing pb.UserServiceServer.\n10\t//   - Standard gRPC signatures; errors via google.golang.org/grpc/status with\n11\t//     the codes in SPEC.error_semantics.\n12\t//\n13\t// Authored out-of-band and audited before the agent implements. The agent\n14\t// must not modify this file.\n15\t\n16\tpackage server_test\n17\t\n18\timport (\n19\t\t\"context\"\n20\t\t\"sync\"\n21\t\t\"testing\"\n22\t\n23\t\tpb \"agentbench/services/user/api/v1\"\n24\t\t\"agentbench/services/user/internal/server\"\n25\t\n26\t\t\"google.golang.org/grpc/codes\"\n27\t\t\"google.golang.org/grpc/status\"\n28\t)\n29\t\n30\tfunc createUserOK(t *testing.T, s pb.UserServiceServer, id string) {\n31\t\tt.Helper()\n32\t\tif _, err := s.CreateUser(context.Background(), &pb.CreateUserRequest{UserId: id}); err != nil {\n33\t\t\tt.Fatalf(\"CreateUser(%s): %v\", id, err)\n34\t\t}\n35\t}\n36\t\n37\tfunc wantCode(t *testing.T, err error, want codes.Code) {\n38\t\tt.Helper()\n39\t\tif got := status.Code(err); got != want {\n40\t\t\tt.Errorf(\"status code = %v, want %v (err=%v)\", got, want, err)\n41\t\t}\n42\t}\n43\t\n44\t// ════════════════════════════════════════════════════════════════════════════\n45\t// CreateUser / GetUser / UpdatePreferences\n46\t// ════════════════════════════════════════════════════════════════════════════\n47\t\n48\t// A new user starts with zero points and is readable.\n49\tfunc TestCreateUser_StartsEmpty(t *testing.T) {\n50\t\ts := server.NewServer()\n51\t\tcreateUserOK(t, s, \"u-1\")\n52\t\tgot, err := s.GetUser(context.Background(), &pb.GetUserRequest{UserId: \"u-1\"})\n53\t\tif err != nil {\n54\t\t\tt.Fatalf(\"GetUser: %v\", err)\n55\t\t}\n56\t\tif got.GetUserId() != \"u-1\" || got.GetPoints() != 0 {\n57\t\t\tt.Errorf(\"new user = %+v, want user_id u-1 and 0 points\", got)\n58\t\t}\n59\t}\n60\t\n61\t// Duplicate CreateUser is AlreadyExists.\n62\tfunc TestCreateUser_Duplicate(t *testing.T) {\n63\t\ts := server.NewServer()\n64\t\tcreateUserOK(t, s, \"u-1\")\n65\t\t_, err := s.CreateUser(context.Background(), &pb.CreateUserRequest{UserId: \"u-1\"})\n66\t\twantCode(t, err, codes.AlreadyExists)\n67\t}\n68\t\n69\t// GetUser on an unknown user is NotFound.\n70\tfunc TestGetUser_NotFound(t *testing.T) {\n71\t\ts := server.NewServer()\n72\t\t_, err := s.GetUser(context.Background(), &pb.GetUserRequest{UserId: \"ghost\"})\n73\t\twantCode(t, err, codes.NotFound)\n74\t}\n75\t\n76\t// UpdatePreferences is reflected by GetUser.\n77\tfunc TestUpdatePreferences(t *testing.T) {\n78\t\ts := server.NewServer()\n79\t\tcreateUserOK(t, s, \"u-1\")\n80\t\tif _, err := s.UpdatePreferences(context.Background(), &pb.UpdatePreferencesRequest{\n81\t\t\tUserId: \"u-1\", Currency: \"EUR\", Locale: \"fr-FR\",\n82\t\t}); err != nil {\n83\t\t\tt.Fatalf(\"UpdatePreferences: %v\", err)\n84\t\t}\n85\t\tgot, err := s.GetUser(context.Background(), &pb.GetUserRequest{UserId: \"u-1\"})\n86\t\tif err != nil {\n87\t\t\tt.Fatalf(\"GetUser: %v\", err)\n88\t\t}\n89\t\tif got.GetCurrency() != \"EUR\" || got.GetLocale() != \"fr-FR\" {\n90\t\t\tt.Errorf(\"prefs = (%q,%q), want (EUR,fr-FR)\", got.GetCurrency(), got.GetLocale())\n91\t\t}\n92\t}\n93\t\n94\t// UpdatePreferences on an unknown user is NotFound.\n95\tfunc TestUpdatePreferences_NotFound(t *testing.T) {\n96\t\ts := server.NewServer()\n97\t\t_, err := s.UpdatePreferences(context.Background(), &pb.UpdatePreferencesRequest{UserId: \"ghost\", Currency: \"USD\"})\n98\t\twantCode(t, err, codes.NotFound)\n99\t}\n100\t\n101\t// ════════════════════════════════════════════════════════════════════════════\n102\t// Loyalty points\n103\t// ════════════════════════════════════════════════════════════════════════════\n104\t\n105\t// Accrual adds amount/100 points and GetPoints reflects the running total.\n106\tfunc TestAccrue_AddsPoints(t *testing.T) {\n107\t\ts := server.NewServer()\n108\t\tctx := context.Background()\n109\t\tcreateUserOK(t, s, \"u-1\")\n110\t\n111\t\tr, err := s.AccrueOnBooking(ctx, &pb.AccrueOnBookingRequest{UserId: \"u-1\", Amount: 10000})\n112\t\tif err != nil {\n113\t\t\tt.Fatalf(\"AccrueOnBooking: %v\", err)\n114\t\t}\n115\t\tif r.GetPoints() != 100 {\n116\t\t\tt.Errorf(\"points after 10000 = %d, want 100\", r.GetPoints())\n117\t\t}\n118\t\tr, err = s.AccrueOnBooking(ctx, &pb.AccrueOnBookingRequest{UserId: \"u-1\", Amount: 5000})\n119\t\tif err != nil {\n120\t\t\tt.Fatalf(\"AccrueOnBooking #2: %v\", err)\n121\t\t}\n122\t\tif r.GetPoints() != 150 {\n123\t\t\tt.Errorf(\"points after +5000 = %d, want 150\", r.GetPoints())\n124\t\t}\n125\t\tgp, _ := s.GetPoints(ctx, &pb.GetPointsRequest{UserId: \"u-1\"})\n126\t\tif gp.GetPoints() != 150 {\n127\t\t\tt.Errorf(\"GetPoints = %d, want 150\", gp.GetPoints())\n128\t\t}\n129\t}\n130\t\n131\t// Concurrent accruals for the same user must not lose updates: 50 goroutines\n132\t// each accruing 1000 (→ 10 points) must leave exactly 500 points. A\n133\t// non-atomic RMW would drop some increments and undershoot.\n134\tfunc TestAccrue_ConcurrentNoLostUpdates(t *testing.T) {\n135\t\ts := server.NewServer()\n136\t\tctx := context.Background()\n137\t\tcreateUserOK(t, s, \"u-1\")\n138\t\n139\t\tconst goroutines = 50\n140\t\tvar wg sync.WaitGroup\n141\t\twg.Add(goroutines)\n142\t\tfor i := 0; i < goroutines; i++ {\n143\t\t\tgo func() {\n144\t\t\t\tdefer wg.Done()\n145\t\t\t\t_, _ = s.AccrueOnBooking(ctx, &pb.AccrueOnBookingRequest{UserId: \"u-1\", Amount: 1000})\n146\t\t\t}()\n147\t\t}\n148\t\twg.Wait()\n149\t\n150\t\tgp, err := s.GetPoints(ctx, &pb.GetPointsRequest{UserId: \"u-1\"})\n151\t\tif err != nil {\n152\t\t\tt.Fatalf(\"GetPoints: %v\", err)\n153\t\t}\n154\t\tif gp.GetPoints() != goroutines*10 {\n155\t\t\tt.Errorf(\"points = %d, want %d (lost updates under concurrency)\", gp.GetPoints(), goroutines*10)\n156\t\t}\n157\t}\n158\t\n159\t// Accrual on an unknown user is NotFound; a non-positive amount is\n160\t// InvalidArgument.\n161\tfunc TestAccrue_Errors(t *testing.T) {\n162\t\ts := server.NewServer()\n163\t\tctx := context.Background()\n164\t\tcreateUserOK(t, s, \"u-1\")\n165\t\n166\t\t_, err := s.AccrueOnBooking(ctx, &pb.AccrueOnBookingRequest{UserId: \"ghost\", Amount: 100})\n167\t\twantCode(t, err, codes.NotFound)\n168\t\n169\t\t_, err = s.AccrueOnBooking(ctx, &pb.AccrueOnBookingRequest{UserId: \"u-1\", Amount: 0})\n170\t\twantCode(t, err, codes.InvalidArgument)\n171\t}\n172\t"}]},"parent_tool_use_id":null,"session_id":"638ba876-3bd3-4bc5-a57e-b44d21a85ad0","uuid":"d10d0e17-c5e4-4750-8343-fe7030d7f029","timestamp":"2026-06-08T05:45:03.005Z","tool_use_result":{"type":"text","file":{"filePath":"/home/leochanj/Desktop/agentbench/services/user/internal/server/server_test.go","content":"// Unit tests for user, derived from SPEC.yaml.\n//\n// What this service is:\n//   user owns preferences + a loyalty points balance. v1 is in-memory. The\n//   load-bearing behavior is AccrueOnBooking: a read-modify-write on the\n//   balance that must serialize concurrent accruals for the same user.\n//\n// Test contract assumed about the implementation:\n//   - `server.NewServer()` returns a *Server implementing pb.UserServiceServer.\n//   - Standard gRPC signatures; errors via google.golang.org/grpc/status with\n//     the codes in SPEC.error_semantics.\n//\n// Authored out-of-band and audited before the agent implements. The agent\n// must not modify this file.\n\npackage server_test\n\nimport (\n\t\"context\"\n\t\"sync\"\n\t\"testing\"\n\n\tpb \"agentbench/services/user/api/v1\"\n\t\"agentbench/services/user/internal/server\"\n\n\t\"google.golang.org/grpc/codes\"\n\t\"google.golang.org/grpc/status\"\n)\n\nfunc createUserOK(t *testing.T, s pb.UserServiceServer, id string) {\n\tt.Helper()\n\tif _, err := s.CreateUser(context.Background(), &pb.CreateUserRequest{UserId: id}); err != nil {\n\t\tt.Fatalf(\"CreateUser(%s): %v\", id, err)\n\t}\n}\n\nfunc wantCode(t *testing.T, err error, want codes.Code) {\n\tt.Helper()\n\tif got := status.Code(err); got != want {\n\t\tt.Errorf(\"status code = %v, want %v (err=%v)\", got, want, err)\n\t}\n}\n\n// ════════════════════════════════════════════════════════════════════════════\n// CreateUser / GetUser / UpdatePreferences\n// ════════════════════════════════════════════════════════════════════════════\n\n// A new user starts with zero points and is readable.\nfunc TestCreateUser_StartsEmpty(t *testing.T) {\n\ts := server.NewServer()\n\tcreateUserOK(t, s, \"u-1\")\n\tgot, err := s.GetUser(context.Background(), &pb.GetUserRequest{UserId: \"u-1\"})\n\tif err != nil {\n\t\tt.Fatalf(\"GetUser: %v\", err)\n\t}\n\tif got.GetUserId() != \"u-1\" || got.GetPoints() != 0 {\n\t\tt.Errorf(\"new user = %+v, want user_id u-1 and 0 points\", got)\n\t}\n}\n\n// Duplicate CreateUser is AlreadyExists.\nfunc TestCreateUser_Duplicate(t *testing.T) {\n\ts := server.NewServer()\n\tcreateUserOK(t, s, \"u-1\")\n\t_, err := s.CreateUser(context.Background(), &pb.CreateUserRequest{UserId: \"u-1\"})\n\twantCode(t, err, codes.AlreadyExists)\n}\n\n// GetUser on an unknown user is NotFound.\nfunc TestGetUser_NotFound(t *testing.T) {\n\ts := server.NewServer()\n\t_, err := s.GetUser(context.Background(), &pb.GetUserRequest{UserId: \"ghost\"})\n\twantCode(t, err, codes.NotFound)\n}\n\n// UpdatePreferences is reflected by GetUser.\nfunc TestUpdatePreferences(t *testing.T) {\n\ts := server.NewServer()\n\tcreateUserOK(t, s, \"u-1\")\n\tif _, err := s.UpdatePreferences(context.Background(), &pb.UpdatePreferencesRequest{\n\t\tUserId: \"u-1\", Currency: \"EUR\", Locale: \"fr-FR\",\n\t}); err != nil {\n\t\tt.Fatalf(\"UpdatePreferences: %v\", err)\n\t}\n\tgot, err := s.GetUser(context.Background(), &pb.GetUserRequest{UserId: \"u-1\"})\n\tif err != nil {\n\t\tt.Fatalf(\"GetUser: %v\", err)\n\t}\n\tif got.GetCurrency() != \"EUR\" || got.GetLocale() != \"fr-FR\" {\n\t\tt.Errorf(\"prefs = (%q,%q), want (EUR,fr-FR)\", got.GetCurrency(), got.GetLocale())\n\t}\n}\n\n// UpdatePreferences on an unknown user is NotFound.\nfunc TestUpdatePreferences_NotFound(t *testing.T) {\n\ts := server.NewServer()\n\t_, err := s.UpdatePreferences(context.Background(), &pb.UpdatePreferencesRequest{UserId: \"ghost\", Currency: \"USD\"})\n\twantCode(t, err, codes.NotFound)\n}\n\n// ════════════════════════════════════════════════════════════════════════════\n// Loyalty points\n// ════════════════════════════════════════════════════════════════════════════\n\n// Accrual adds amount/100 points and GetPoints reflects the running total.\nfunc TestAccrue_AddsPoints(t *testing.T) {\n\ts := server.NewServer()\n\tctx := context.Background()\n\tcreateUserOK(t, s, \"u-1\")\n\n\tr, err := s.AccrueOnBooking(ctx, &pb.AccrueOnBookingRequest{UserId: \"u-1\", Amount: 10000})\n\tif err != nil {\n\t\tt.Fatalf(\"AccrueOnBooking: %v\", err)\n\t}\n\tif r.GetPoints() != 100 {\n\t\tt.Errorf(\"points after 10000 = %d, want 100\", r.GetPoints())\n\t}\n\tr, err = s.AccrueOnBooking(ctx, &pb.AccrueOnBookingRequest{UserId: \"u-1\", Amount: 5000})\n\tif err != nil {\n\t\tt.Fatalf(\"AccrueOnBooking #2: %v\", err)\n\t}\n\tif r.GetPoints() != 150 {\n\t\tt.Errorf(\"points after +5000 = %d, want 150\", r.GetPoints())\n\t}\n\tgp, _ := s.GetPoints(ctx, &pb.GetPointsRequest{UserId: \"u-1\"})\n\tif gp.GetPoints() != 150 {\n\t\tt.Errorf(\"GetPoints = %d, want 150\", gp.GetPoints())\n\t}\n}\n\n// Concurrent accruals for the same user must not lose updates: 50 goroutines\n// each accruing 1000 (→ 10 points) must leave exactly 500 points. A\n// non-atomic RMW would drop some increments and undershoot.\nfunc TestAccrue_ConcurrentNoLostUpdates(t *testing.T) {\n\ts := server.NewServer()\n\tctx := context.Background()\n\tcreateUserOK(t, s, \"u-1\")\n\n\tconst goroutines = 50\n\tvar wg sync.WaitGroup\n\twg.Add(goroutines)\n\tfor i := 0; i < goroutines; i++ {\n\t\tgo func() {\n\t\t\tdefer wg.Done()\n\t\t\t_, _ = s.AccrueOnBooking(ctx, &pb.AccrueOnBookingRequest{UserId: \"u-1\", Amount: 1000})\n\t\t}()\n\t}\n\twg.Wait()\n\n\tgp, err := s.GetPoints(ctx, &pb.GetPointsRequest{UserId: \"u-1\"})\n\tif err != nil {\n\t\tt.Fatalf(\"GetPoints: %v\", err)\n\t}\n\tif gp.GetPoints() != goroutines*10 {\n\t\tt.Errorf(\"points = %d, want %d (lost updates under concurrency)\", gp.GetPoints(), goroutines*10)\n\t}\n}\n\n// Accrual on an unknown user is NotFound; a non-positive amount is\n// InvalidArgument.\nfunc TestAccrue_Errors(t *testing.T) {\n\ts := server.NewServer()\n\tctx := context.Background()\n\tcreateUserOK(t, s, \"u-1\")\n\n\t_, err := s.AccrueOnBooking(ctx, &pb.AccrueOnBookingRequest{UserId: \"ghost\", Amount: 100})\n\twantCode(t, err, codes.NotFound)\n\n\t_, err = s.AccrueOnBooking(ctx, &pb.AccrueOnBookingRequest{UserId: \"u-1\", Amount: 0})\n\twantCode(t, err, codes.InvalidArgument)\n}\n","numLines":172,"startLine":1,"totalLines":172}}}
